.2,11.1zM-90.7,45.7l18.2,-10.4 8.8,5.1 -18.2,10.5zM-58.2,64.5l18.2,-10.5 8.8,5.1 -18.2,10.5zM-38.7,77.3l19.2,-11.2 19.2,11.2 -19.2,11.1zM-12.7,92.3l19.2,-11.2 19.2,11.2 -19.2,11.1zM13.3,107.3l19.2,-11.2 19.2,11.2 -19.2,11.1zM39.3,122.3l19.2,-11.1 19.2,11.1 -19.2,11.1zM65.3,137.3l19.2,-11.1 19.2,11.1 -19.2,11.1zM91.3,152.3l19.2,-11.1 19.2,11.1 -19.2,11zM117.3,167.3l19.2,-11.1 19.2,11.1 -19.2,11zM143.3,182.3l19.2,-11.1 19.2,11.1 -19.2,11zM169.3,197.3l19.2,-11.1 19.2,11.1 -19.2,11zM195.3,212.3l19.2,-11.1 19.2,11.1 -19.2,11zM244,240.4l19.3,-11.1 19.2,11.1 -19.2,11.1zM234.3,233.2l18.2,-10.4 8.8,5.1 -18.2,10.4zM266.8,252l18.2,-10.5 8.8,5.1 -18.2,10.5zM-120,60.4l19.3,-11.1 19.2,11.1 -19.2,11.1zM-87.5,79.1l19.3,-11.1 19.2,11.1 -19.2,11.1zM-55,97.9l19.3,-11.1 19.2,11.1 -19.2,11.1zM42.5,154.1l19.3,-11.1 19.2,11.1 -19.2,11.1zM-19.2,117l18.2,-10.5 8.8,5.1 -18.2,10.5zM117.3,195.8l18.2,-10.5 8.8,5.1 -18.2,10.5zM140,210.4l19.3,-11.1 19.2,11.1 -19.3,11.1zM172.5,229.1l19.3,-11.1 19.2,11.1 -19.3,11.1zM205,247.9l19.3,-11.1 19.2,11.1 -19.2,11.1zM237.5,266.6l19.3,-11.1 19.2,11.1 -19.2,11.1z"></path>
				</svg>
			</div>
			<div class="layer ly-sw">
				{
					switches.map((s) => (
						<div class="part sw" style={`${place(s.box)}; --d: ${s.delay}`}>
							<svg viewBox={view(s.box)}>
								<path class="a st" d={s.faces[0]} />
								<path class="b st" d={s.faces[1]} />
								<path class="c st" d={s.faces[2]} />
								<path class="g st" d={s.faces[3]} />
								<path class="e st" d={s.faces[4]} />
							</svg>
						</div>
					))
				}
			</div>
			<div class="layer ly-caps">
				{
					caps.map((cap) => (
						<div
							class="part cap"
							style={[
								place(cap.box),
								`--mx: ${cap.main.x}px; --my: ${cap.main.y}px; --bx: ${cap.side.x}px; --by: ${cap.side.y}px`,
								`--ox: ${cap.pivot.x}px; --oy: ${cap.pivot.y}px; --r: ${cap.turn}deg`,
								`--d: ${cap.delay}; --c: ${cap.clip}`,
							].join('; ')}
						>
							<div class="cap-b">
								<div class="cap-y">
									<div class="cap-c">
									<div class="cap-r">
										<div class="k" data-wide={cap.box.w > WIDE_KEY ? '' : undefined}>
											<svg viewBox={view(cap.box)}>
												{cap.faces.map((d) => (
													<path d={d} />
												))}
											</svg>
											{cap.accent && (
												<svg class="hl" viewBox={view(cap.box)} style={`--h: ${cap.accent.at}`}>
													{cap.faces.map((d) => (
														<path d={d} />
													))}
													<text class="lg" transform={cap.accent.label} y="4.2">
														{cap.accent.letter}
													</text>
												</svg>
											)}
										</div>
									</div>
									</div>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
	<div class="controls">
		<button type="button" class="mono control replay" data-replay hidden>{t.replay}</button>
		{/* The state after the name is the screen's alone: a reader hears « Son » and whether it is pressed. */}
		<button type="button" class="mono control sound" aria-pressed="false" data-sound hidden>
			{t.sound}<span class="off" aria-hidden="true">{t.soundOff}</span><span class="on" aria-hidden="true">{t.soundOn}</span>
		</button>
	</div>
</div>

<script>
	import '../hero/etabli';
	import '../hero/frappe';
</script>

<style>
	/* « Rejouer » under the board's middle: flush right, it would run into the Nuancier's tab, fixed in that corner. */
	.etabli {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/*
	 * The column's box, at the drawing's ratio: the stage inside is the drawing at its own size, scaled
	 * to it. `tan(atan2())` turns the two lengths into their ratio, a number `scale` takes.
	 */
	.bench {
		position: relative;
		align-self: stretch;
		aspect-ratio: 820 / 614;
		container-type: inline-size;
		/*
		 * The parts fly over the text, and on a phone the box runs over the buttons below it (its empty paper
		 * is tucked under its neighbours): nothing of it catches the pointer but a cap's own faces.
		 */
		pointer-events: none;
	}

	.stage {
		position: absolute;
		top: 0;
		left: 0;
		width: 820px;
		height: 614px;
		transform-origin: 0 0;
		scale: tan(atan2(100cqi, 820px));
	}

	.layer {
		position: absolute;
		inset: 0;
	}

	.part {
		position: absolute;
	}

	.layer > svg,
	.part svg {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.part :is(.cap-b, .cap-y, .cap-c, .cap-r, .k) {
		position: absolute;
		inset: 0;
	}

	/*
	 * Line work in the ink on tones of the paper: engraved on a light paper (the lit face is the paper's
	 * white, the flanks darken towards the ink), lit by the ink on a dark one.
	 */
	.kb {
		--kb-a: var(--color-light);
		--kb-b: color-mix(in srgb, var(--color-ink) 7%, var(--color-paper));
		--kb-c: color-mix(in srgb, var(--color-ink) 17%, var(--color-paper));
		--kb-d: color-mix(in srgb, var(--color-ink) 30%, var(--color-paper));
		--kb-hl-line: var(--color-ink);
	}

	:global(:root:is([data-theme='dark'], [data-theme='nord'], [data-theme='catppuccin-mocha'], [data-theme='tokyo-night']))
		.kb {
		--kb-a: color-mix(in srgb, var(--color-ink) 17%, var(--color-paper));
		--kb-b: color-mix(in srgb, var(--color-ink) 11%, var(--color-paper));
		--kb-c: color-mix(in srgb, var(--color-ink) 4%, var(--color-paper));
		--kb-d: var(--color-paper);
		--kb-hl-line: var(--color-paper);
	}

	.kb :is(path, ellipse) {
		stroke: var(--color-ink);
		stroke-width: 0.7;
		stroke-linejoin: round;
	}

	.kb .a {
		fill: var(--kb-a);
	}

	.kb .b {
		fill: var(--kb-b);
	}

	.kb .c {
		fill: var(--kb-c);
	}

	.kb .d {
		fill: var(--kb-d);
	}

	.kb .e {
		fill: var(--color-ink);
	}

	.kb .g {
		fill: color-mix(in srgb, var(--color-ink) 65%, var(--color-paper));
	}

	.kb .st {
		stroke-width: 0.5;
	}

	.kb .tr {
		fill: none;
		stroke-width: 0.5;
		stroke-opacity: 0.5;
	}

	.kb .di {
		fill: none;
		stroke: var(--color-ink-muted);
		stroke-width: 1.8;
	}

	.kb .pd {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
	}

	.kb .ho {
		fill: none;
		stroke: var(--kb-d);
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.kb .dk {
		fill: none;
		stroke: var(--kb-d);
		stroke-width: 3.2;
		stroke-linecap: round;
	}

	.kb .slot {
		fill: none;
		stroke: var(--kb-d);
		stroke-width: 1.2;
		stroke-linecap: round;
		transform-box: view-box;
		transform-origin: 0 0;
		transform: rotate(90deg);
	}

	.k path {
		fill: var(--kb-a);
	}

	.k path:nth-child(2) {
		fill: var(--kb-b);
	}

	.k path:nth-child(3) {
		fill: var(--kb-c);
	}

	/* h, j, k, l: the accent's volumes, lit and shaded towards the night's ink whatever the paper. */
	.hl {
		color: var(--color-accent);
	}

	.k .hl path {
		fill: currentColor;
		stroke: var(--kb-hl-line);
	}

	.k .hl path:nth-child(2) {
		fill: color-mix(in srgb, currentColor 76%, #141412);
	}

	.k .hl path:nth-child(3) {
		fill: color-mix(in srgb, currentColor 54%, #141412);
	}

	.lg {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 500;
		fill: var(--color-on-accent);
		text-anchor: middle;
	}

	.sw {
		transform-origin: 50% 100%;
	}

	/*
	 * A cap gives under the pointer, and bottoms out while it is pressed (the Frappe): its faces alone catch
	 * the pointer, not the corners of its box. A finger starting on a cap still scrolls the page.
	 */
	.k path {
		pointer-events: visiblePainted;
	}

	.k {
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
		-webkit-user-select: none;
		user-select: none;
		-webkit-touch-callout: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.k:hover {
			transform: translateY(2.5px);
		}
	}

	/* Down fast, as a finger drops; back up on the rest's slower spring. */
	.k[data-down] {
		transform: translateY(5px);
		transition-duration: 0.05s;
	}

	.controls {
		display: flex;
		gap: 8px;
		margin: 12px 0 0;
	}

	.sound[aria-pressed='true'] .off,
	.sound[aria-pressed='false'] .on {
		display: none;
	}

	.control {
		min-height: 44px;
		padding: 0 18px;
		border: 1px solid var(--color-rule);
		background: var(--color-paper);
		color: var(--color-ink-muted);
		font-size: 12px;
		line-height: 1.6;
		cursor: pointer;
		transition:
			color 0.2s,
			border-color 0.2s;
	}

	/* Hidden until their script runs, but in their room from the first paint: shown, they move nothing (CLS). */
	.control[hidden] {
		display: inline-block;
		visibility: hidden;
	}

	@media (hover: hover) and (pointer: fine) {
		.control:hover {
			color: var(--color-ink);
			border-color: var(--color-ink-muted);
		}
	}

	.sound[aria-pressed='true'] {
		color: var(--color-ink);
		border-color: var(--color-ink-muted);
	}

	/* Nothing to replay without motion; the Son stays, for the Frappe. */
	@media (prefers-reduced-motion: reduce) {
		.replay,
		.replay[hidden] {
			display: none;
		}

		.k,
		.control {
			transition: none;
		}
	}

	/*
	 * The assembly, the mockup's keyframes. Every travel follows one of the two iso axes: u = (.866, .5),
	 * v = (−.866, .5). The rest state is the page's: each animation runs from its start towards it.
	 */
	@keyframes case-in {
		from {
			transform: translate(-693px, 400px);
			opacity: 0;
		}

		12% {
			opacity: 1;
		}
	}

	@keyframes pcb-in {
		from {
			transform: translate(693px, -400px);
			opacity: 0;
		}

		14% {
			opacity: 1;
		}
	}

	@keyframes pcb-seat {
		from {
			transform: translateY(-14px);
		}
	}

	@keyframes screw-in {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
	}

	@keyframes screw-turn {
		from {
			transform: none;
		}
	}

	@keyframes plate-in {
		from {
			transform: translateY(-200px);
			opacity: 0;
		}

		18% {
			opacity: 1;
		}
	}

	@keyframes sw-up {
		from {
			transform: scaleY(0);
		}
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	@keyframes cap-main {
		from {
			transform: translate(var(--mx), var(--my));
		}
	}

	@keyframes cap-side {
		from {
			transform: translate(var(--bx), var(--by));
		}
	}

	/*
	 * The turn in the board's plane: into the plane at the cap's centre, the turn, and back out. Both ends
	 * spell out the same list, so that only the angle is interpolated; together they make no transform.
	 */
	@keyframes cap-spin {
		from {
			transform: translate(var(--ox), var(--oy)) matrix(0.8660254, 0.5, -0.8660254, 0.5, 0, 0) rotate(var(--r))
				matrix(0.5773503, -0.5773503, 1, 1, 0, 0) translate(calc(-1 * var(--ox)), calc(-1 * var(--oy)));
		}

		to {
			transform: translate(var(--ox), var(--oy)) matrix(0.8660254, 0.5, -0.8660254, 0.5, 0, 0) rotate(0deg)
				matrix(0.5773503, -0.5773503, 1, 1, 0, 0) translate(calc(-1 * var(--ox)), calc(-1 * var(--oy)));
		}
	}

	@keyframes cap-lift {
		from {
			transform: none;
		}

		to {
			transform: translateY(-34px);
		}
	}

	/*
	 * The clip, on a box of its own inside the lift's: two transform animations on one element are not
	 * composited. Measured from the lifted cap, so the mockup's -34 → 1.8 → 0 reads 0 → 35.8 → 34 here,
	 * and the two together come to rest at 0.
	 */
	@keyframes cap-clip {
		from {
			transform: none;
			animation-timing-function: cubic-bezier(0.55, 0, 0.85, 0.35);
		}

		72% {
			transform: translateY(35.8px);
			animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1);
		}

		to {
			transform: translateY(34px);
		}
	}

	/* Played on the first visit (`html.intro`) and by « Rejouer » (`data-assemble` on the bench). */
	@media (prefers-reduced-motion: no-preference) {
		:global(:is(html.intro, [data-assemble])) .ly-case {
			animation: case-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.05s backwards;
		}

		:global(:is(html.intro, [data-assemble])) .pcb-in {
			animation: pcb-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
		}

		:global(:is(html.intro, [data-assemble])) .ly-pcb {
			animation: pcb-seat 0.32s cubic-bezier(0.45, 0, 0.25, 1) 0.9s backwards;
		}

		:global(:is(html.intro, [data-assemble])) .screw {
			animation: screw-in 0.24s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--d) * 1s) backwards;
		}

		:global(:is(html.intro, [data-assemble])) .screw .slot {
			animation: screw-turn 0.24s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--d2) * 1s) backwards;
		}

		:global(:is(html.intro, [data-assemble])) .ly-plate {
			animation: plate-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.5s backwards;
		}

		:global(:is(html.intro, [data-assemble])) .sw {
			animation: sw-up 0.3s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--d) * 1s) backwards;
		}

		:global(:is(html.intro, [data-assemble])) .ly-caps {
			animation: fade 0.5s ease-out backwards;
		}

		:global(:is(html.intro, [data-assemble])) .cap {
			animation: cap-main 0.8s cubic-bezier(0.6, 0, 0.3, 1) calc(var(--d) * 1s) backwards;
		}

		:global(:is(html.intro, [data-assemble])) .cap-b {
			animation: cap-side 0.7s cubic-bezier(0.5, 0, 0.25, 1) calc((var(--d) + 0.1) * 1s) backwards;
		}

		:global(:is(html.intro, [data-assemble])) .cap-r {
			transform-origin: 0 0;
			animation: cap-spin 0.75s cubic-bezier(0.6, 0, 0.3, 1) calc(var(--d) * 1s) backwards;
		}

		:global(:is(html.intro, [data-assemble])) .cap-y {
			animation: cap-lift 0.45s cubic-bezier(0.3, 0, 0.2, 1) calc(var(--d) * 1s) both;
		}

		:global(:is(html.intro, [data-assemble])) .cap-c {
			animation: cap-clip 0.34s linear calc(var(--c) * 1s) both;
		}

		:global(:is(html.intro, [data-assemble])) .hl {
			animation: fade 0.25s ease-out calc(var(--h) * 1s) backwards;
		}
	}
</style>
