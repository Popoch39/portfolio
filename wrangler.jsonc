// Cloudflare Workers, static assets first (no adapter needed): `bun run deploy`.
// The Worker script only answers `/api/*`, the Formulaire du Café's route (ADR 0010).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-11-03",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Serves dist/404.html with a 404 status instead of an empty 404.
		"not_found_handling": "404-page",
		// Every other URL never wakes the script: the pages stay as fast as static files.
		"run_worker_first": ["/api/*"]
	},
	// Pinned to Louis's address, verified in Email Routing, and to one sender on the domain.
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "pocheron.louis@gmail.com",
			"allowed_sender_addresses": ["contact@louis-pocheron.com"]
		}
	],
	// Five proposals a minute per IP, for each Cloudflare location: room for a typo, none for a robot.
	"ratelimits": [
		{
			"name": "CONTACT_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	// Only the apex domain answers: the workers.dev and preview URLs would be indexable duplicates.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "louis-pocheron.com", "custom_domain": true }],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issue_detection": {
			"enabled": true
		}
	}
}
