---
// L'Atome (planche 34 · Atome, visite guidée, spec #80) : la stack dessinée, une Bague par famille autour
// d'un noyau bleu, une Pastille par technologie qui a un logo. Décoratif : la légende de la section Stack
// dit la même chose en texte.
//
// Rien n'est animé ici : la CSS de base est la pose finale de la Visite (la fin des keyframes de la
// planche), celle du mouvement réduit et le point d'arrivée de la Visite. Chaque niveau d'enveloppe ne
// porte qu'une transformation, pour que la Visite (#83) et la Révolution (#84) animent chacune la sienne :
//   .ring      la Bague : sa profondeur et son orientation (`transform`), son rayon (`--r`) ;
//   .layer     ses cinq calques empilés en profondeur, qui lui donnent son épaisseur ;
//   .orbit     le tour des Pastilles sur la Bague (`rotate`) ;
//   .pastille  la place de la Pastille sur la Bague (`transform`, d'après `--t` et `--r`) ;
//   .unspin    le tour défait, pour que la Pastille ne tourne pas sur elle-même (`rotate`) ;
//   .face      l'orientation de la Bague défaite : le logo reste de face (`transform`) ;
//   .chip      la Pastille dessinée (`opacity`, `scale`, `translate` libres).
// La géométrie de chaque Bague vient de `stack` (`src/data/profile.ts`), en propriétés personnalisées.
import { stack, type StackItem, type Tilt } from '../data/profile';
import { compactLogo, logoOf } from '../anatomies/tech';

const pastillesOf = (items: StackItem[]) => items.flatMap(({ pastille }) => (pastille ? [pastille] : []));
const deg = (n: number) => `${n}deg`;
const tilt = (name: string, [a, b, c]: Tilt) => `--${name}a:${deg(a)};--${name}b:${deg(b)};--${name}c:${deg(c)}`;

// Une règle par Bague (la pose finale), puis une par Pastille (sa place).
const geometry = stack
	.flatMap(({ items, ring }, k) => [
		`.atom .ring-${k}{--r:${ring.radius.end}px;--dz:${ring.depth}px;${tilt('f', ring.tilt.end)};--sp:${deg(ring.turn)}}`,
		...pastillesOf(items).map(({ angle }, i) => `.atom .ring-${k} .pastille:nth-child(${i + 1}){--t:${deg(angle)}}`),
	])
	.join('');
---

<style is:inline set:html={geometry}></style>
<div class="atom" aria-hidden="true">
	<svg class="sprite" focusable="false">
		{
			stack.flatMap(({ items }) => pastillesOf(items)).map(({ logo, color }) => {
				const { viewBox, path } = compactLogo(logoOf(logo));
				return (
					<symbol id={`logo-${logo}`} viewBox={viewBox}>
						<path fill={color} d={path} />
					</symbol>
				);
			})
		}
	</svg>
	<span class="nucleus"></span>
	{
		stack.map(({ items, ring }, k) => (
			<div class:list={['ring', `ring-${k}`, { accent: ring.accent }]}>
				<svg class="layer">
					<circle class="side" />
					<circle class="edge out" />
					<circle class="edge in" />
				</svg>
				<svg class="layer">
					<circle class="side" />
				</svg>
				<svg class="layer">
					<circle class="side" />
				</svg>
				<svg class="layer">
					<circle class="side" />
				</svg>
				<svg class="layer">
					<circle class="top" />
					<circle class="ticks" pathLength="360" />
					<circle class="edge out" />
					<circle class="edge in" />
				</svg>
				<span class="orbit">
					{pastillesOf(items).map(({ logo }) => (
						<span class="pastille">
							<span class="unspin">
								<span class="face">
									<span class="chip">
										<svg class="logo">
											<use href={`#logo-${logo}`} />
										</svg>
									</span>
								</span>
							</span>
						</span>
					))}
				</span>
			</div>
		))
	}
</div>

{/* Global sous `.atom` plutôt que limitée au composant : le marquage de portée d'Astro irait sur chacun
    des quelque 300 éléments de l'Atome, environ 0,6 Ko compressé dans un accueil au bord de son budget. */}
<style is:global>
	/* Les couleurs de la planche qui ne sont pas des jetons du site : la tranche grise des Bagues et le
	   bleu sombre des ombres du noyau et de la Bague bleue. */
	.atom {
		--side: #c9c9c2;
		--deep: #121b9e;
		position: absolute;
		width: 0;
		height: 0;
		transform-style: preserve-3d;
		/* Décoratif, et ses boîtes tournées débordent le dessin : elles ne prennent aucun clic. */
		pointer-events: none;
	}

	.atom .sprite {
		position: absolute;
		width: 0;
		height: 0;
	}

	.atom .nucleus {
		position: absolute;
		left: -15px;
		top: -15px;
		width: 30px;
		height: 30px;
		border: 0.6px solid var(--deep);
		border-radius: 50%;
		background: radial-gradient(circle at 34% 30%, #c9cfff 0, #5866ff 30%, var(--accent) 58%, var(--deep) 100%);
		/* Devant toutes les Bagues. */
		translate: 0 0 400px;
	}

	.atom .nucleus::after {
		content: '';
		position: absolute;
		inset: -10px;
		border: 0.6px solid var(--accent-light);
		border-radius: 50%;
	}

	/* La boîte de la Bague déborde son cercle de 20 px : la largeur de la bande et des arêtes. */
	.atom .ring {
		position: absolute;
		left: calc(-1 * var(--r) - 20px);
		top: calc(-1 * var(--r) - 20px);
		width: calc(2 * var(--r) + 40px);
		height: calc(2 * var(--r) + 40px);
		transform-style: preserve-3d;
		transform: translateZ(var(--dz)) rotateZ(var(--fa)) rotateX(var(--fb)) rotateZ(var(--fc));
	}

	/* La profondeur nulle du calque du dessus n'est pas superflue : sans elle, Firefox le sort du contexte
	   3D et le dessine à plat, dans le coin de la page. */
	.atom .layer {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		translate: 0 0 0;
	}

	.atom .layer:nth-child(1) {
		translate: 0 0 -8px;
	}

	.atom .layer:nth-child(2) {
		translate: 0 0 -6px;
	}

	.atom .layer:nth-child(3) {
		translate: 0 0 -4px;
	}

	.atom .layer:nth-child(4) {
		translate: 0 0 -2px;
	}

	.atom circle {
		cx: 50%;
		cy: 50%;
		r: calc(50% - 20px);
		fill: none;
	}

	.atom .side,
	.atom .top {
		stroke-width: 12;
	}

	.atom .side {
		stroke: var(--side);
	}

	.atom .top {
		stroke: var(--paper);
	}

	.atom .edge {
		stroke: var(--ink);
		stroke-width: 0.6;
	}

	.atom .out {
		r: calc(50% - 14px);
	}

	.atom .in {
		r: calc(50% - 26px);
	}

	/* 72 graduations : `pathLength="360"`, un trait tous les 5. */
	.atom .ticks {
		stroke: var(--ink);
		stroke-width: 2.5;
		stroke-dasharray: 0.12 4.88;
		opacity: 0.4;
	}

	.atom .accent .top {
		stroke: var(--accent);
	}

	.atom .accent .side {
		stroke: var(--deep);
	}

	.atom .orbit,
	.atom .pastille,
	.atom .unspin,
	.atom .face {
		position: absolute;
		left: 0;
		top: 0;
		width: 0;
		height: 0;
		transform-style: preserve-3d;
	}

	.atom .orbit {
		left: 50%;
		top: 50%;
		rotate: var(--sp);
	}

	.atom .pastille {
		transform: rotate(var(--t)) translateX(var(--r)) rotate(calc(-1 * var(--t)));
	}

	.atom .unspin {
		translate: 0 0 10px;
		rotate: calc(-1 * var(--sp));
	}

	.atom .face {
		transform: rotateZ(calc(-1 * var(--fc))) rotateX(calc(-1 * var(--fb))) rotateZ(calc(-1 * var(--fa)));
	}

	.atom .chip {
		position: absolute;
		left: -9px;
		top: -9px;
		width: 18px;
		height: 18px;
		border: 0.6px solid var(--ink);
		border-radius: 50%;
		background: radial-gradient(circle at 35% 28%, #fff 0, var(--paper) 45%, #e4e4de 100%);
		box-shadow:
			0 2.5px 0 -0.5px var(--side),
			0 2.5px 0 0 var(--ink);
	}

	.atom .accent .chip {
		border-color: var(--deep);
		background: var(--accent);
		color: #fff;
	}

	/* Les logos sans couleur de marque prennent l'encre de la Pastille. */
	.atom .logo {
		position: absolute;
		left: 3.5px;
		top: 3.5px;
		width: 10px;
		height: 10px;
		fill: currentColor;
	}
</style>
