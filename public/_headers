# Cloudflare static assets (Workers or Pages). Only URLs that carry a content hash are cached
# for good: a change produces a new URL, so the browser never has to ask again. HTML,
# robots.txt, the sitemap and the favicon keep Cloudflare's default (revalidated by ETag) so a
# deploy shows up on the next visit.

# Bundled scripts, fonts and images: Astro puts the hash in the file name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo sprite: its file name is a hash of its content (src/pages/logos/[version].svg.ts).
/logos/*
  Cache-Control: public, max-age=31536000, immutable
