---
// Carte de figure : Fig. n et titre en haut, la scène au milieu, la consigne et le relevé en
// bas ; la légende dessous. Sur la fiche, la scène épouse le format de la figure, 900 px de large
// au plus, et la carte tient dans la hauteur de la fenêtre.
// Dans l'aperçu de l'accueil, la scène a une taille fixe et la figure s'y inscrit : changer de
// projet ne décale rien.
import '../vendor/anatomy/iso.css';
import '../anatomies/palette.css';

interface Common {
	fig: number | string;
	title: string;
	hints: { pointer: string; touch: string };
	readout: string;
	caption?: string;
	/** Le dossier du module de mouvement, que le chargeur monte sur la scène. */
	motion: string;
	/** Scène de taille fixe, où la figure s'inscrit (aperçu de l'accueil). */
	fixed?: boolean;
}

type Props = Common &
	(
		| {
				/** La figure au repos, en SVG intégré à la page. */
				svg: string;
				image?: never;
		  }
		| {
				/**
				 * L'image d'attente : le SVG au repos autonome, que le script de la page remplace par la
				 * figure insérée. Elle n'est demandée que si `media` vaut : sans JavaScript, le
				 * navigateur ignore `loading="lazy"` et la chargerait même masquée.
				 */
				image: { src: string; media: string; width: number; height: number; alt: string };
				svg?: never;
		  }
	);

const { fig, title, hints, readout, caption, svg, image, motion, fixed = false } = Astro.props;
---

<figure class:list={['figure', { fixed }]}>
	<div class="card">
		<div class="mono row">
			<span class="fig">Fig. {fig}</span>{' '}
			<span>{title}</span>
		</div>
		{
			image ? (
				<div class="scene iso anatomy" data-theme="light" data-motion={motion}>
					<picture>
						<source media={image.media} srcset={image.src} type="image/svg+xml" width={image.width} height={image.height} />
						<img width={image.width} height={image.height} alt={image.alt} loading="lazy" decoding="async" />
					</picture>
				</div>
			) : (
				<div class="scene iso anatomy" data-theme="light" data-motion={motion} set:html={svg} />
			)
		}
		<div class="mono row foot">
			<span class="hint pointer">{hints.pointer}</span>
			<span class="hint touch">{hints.touch}</span>{' '}
			<span class="readout"><span class="dot" aria-hidden="true"></span><span data-readout>{readout}</span></span>
		</div>
	</div>
	{caption && <figcaption class="caption"><span class="mono caption-fig">Fig. {fig} —</span> {caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 32px 0 0;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: clamp(16px, 2vw, 28px);
		background: var(--paper);
		border: 1px solid var(--rule);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		font-size: 12px;
		color: var(--muted);
	}

	.fig {
		color: var(--ink);
	}

	.scene {
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
		/* Le doigt agit sur la figure et fait toujours défiler la page. */
		touch-action: pan-y;
	}

	/* Une figure en hauteur ne dépasse pas la fenêtre : la carte entière (marges, titre, consigne,
	   ≈ 110 px à 1440) y tient, sans descendre sous un seuil lisible sur un téléphone à l'horizontale.
	   `svh` plutôt que `dvh` : la figure ne change pas de taille quand la barre d'adresse se replie.
	   Plafonnée en hauteur, elle reste centrée dans sa largeur (`preserveAspectRatio` par défaut). */
	.scene > :global(svg) {
		max-height: max(320px, 100svh - 160px);
	}

	/* Une seule consigne visible : celle du pointeur s'il sait survoler, sinon celle du toucher. */
	.pointer {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.pointer {
			display: inline;
		}

		.touch {
			display: none;
		}
	}

	.readout {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.dot {
		flex: none;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.caption {
		max-width: 760px;
		margin-top: 14px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--muted);
		text-wrap: pretty;
	}

	.caption-fig {
		font-size: 12px;
		color: var(--ink);
	}

	/* Scène fixe : la figure s'y inscrit, image d'attente comme SVG inséré (qui ne porte pas
	   l'attribut de portée du composant). La consigne, au-dessus du relevé, a deux lignes réservées ;
	   les autres textes tiennent sur une ligne : la carte garde sa hauteur d'un projet à l'autre. */
	.fixed {
		margin: 0;
	}

	/* Sans `min-height: 0`, le contenu (une figure en hauteur) passerait outre le rapport 4:3. */
	.fixed .scene {
		max-width: none;
		min-height: 0;
		aspect-ratio: 4 / 3;
	}

	.fixed .scene > picture,
	.fixed .scene img,
	.fixed .scene > :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		max-height: none;
		object-fit: contain;
	}

	.fixed .row {
		flex-wrap: nowrap;
		white-space: nowrap;
	}

	.fixed .foot {
		flex-direction: column;
		gap: 6px;
	}

	.fixed .hint {
		min-height: 2lh;
		white-space: normal;
	}

	.fixed .row > *,
	.fixed [data-readout] {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
