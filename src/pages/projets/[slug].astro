---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FigureCard from '../../components/FigureCard.astro';
import Nomenclature from '../../components/Nomenclature.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import StatusBar from '../../components/StatusBar.astro';
import { fichePath, githubRepoUrl, projects, shareImageOf, type Project } from '../../data/profile';
import { person } from '../../lib/structured-data';
import { anatomyOf } from '../../anatomies/registry';
import { restSvg } from '../../anatomies/figure';

export const getStaticPaths = (() => projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
	project: Project;
}

const { project } = Astro.props;
const anatomy = anatomyOf(project);
const { content } = anatomy;
const rest = anatomy.renderRest();

const sourceCode = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	name: project.repo,
	description: content.seo.description,
	url: new URL(fichePath(project), Astro.site).href,
	codeRepository: githubRepoUrl(project.repo),
	programmingLanguage: project.language,
	author: person(Astro.site),
};
---

<Layout
	title={content.seo.title}
	description={content.seo.description}
	shareImage={shareImageOf(project, content.machine)}
	ogType="website"
	structuredData={sourceCode}
>
	<div class="container">
		<SiteHeader current="projets" />
	</div>
	<main class="container">
		<ProjectHero project={project} lede={content.lede} />
		<section class="anatomy">
			<SectionHeader number="A" title="Anatomie" note={`${content.pieces.length} pièces · une seule les compte`} />
			<FigureCard
				fig={1}
				title={content.title}
				consignes={content.consignes}
				releve={content.releve}
				caption={content.caption}
				svg={restSvg(anatomy)}
				motion={anatomy.motion}
				phoneCrop={content.phoneCrop}
				portrait={rest.height >= rest.width}
			/>
			<Nomenclature pieces={content.pieces} codeUrl={anatomy.codeUrl} />
		</section>
		<ProjectNav project={project} />
	</main>
	<StatusBar path={`~/louis/projets/${project.repo}.md`} secondary={`Fig. 1 · ${content.pieces.length} pièces`} position={null} />
</Layout>

<script>
	// Le chargeur de la fiche : la figure arrive dessinée, seul son mouvement passe par ici.
	import { mountFigure } from '../../anatomies/loader.ts';
	import { linkPieces } from '../../anatomies/highlight.ts';

	const scene = document.querySelector<HTMLElement>('[data-motion]');
	const svg = scene?.querySelector('svg');
	const releve = scene?.closest('figure')?.querySelector<HTMLElement>('[data-releve]');
	const anatomy = scene?.closest('section');
	if (scene?.dataset.motion && svg && releve && anatomy) {
		linkPieces(anatomy);
		void mountFigure({ scene, svg, releve }, scene.dataset.motion);
	}
</script>

<style>
	.anatomy {
		padding-top: clamp(24px, 4vw, 56px);
	}
</style>
