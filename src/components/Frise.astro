---
/**
 * Frise: the career as a git graph on a plane tilted backwards, over a full-width accent band.
 * This markup is its final state (ADR 0003): the graph runs straight from left to right, fully built,
 * in a strip that scrolls horizontally under a fixed camera.
 */
import SectionHeading from './SectionHeading.astro';
import { careerGraph, person, salariedPositions, yearsOfExperience } from '../data/profile';

interface Props {
	number: number;
	titleId: string;
}

const { number, titleId } = Astro.props;

const { commits, branches, aside } = careerGraph();
const cities = [...new Set(salariedPositions.map((position) => position.city)), person.city];
const summary = `~${yearsOfExperience()} ans d’expérience · ${cities.join(' & ')}`;

// Plane geometry, in px before the tilt: `main` runs along y = 0, the branches behind it.
const SPAN = 3600;
const START = 120;
const END = 300;
const LANE = -180;
/** Horizontal reach of the curve between `main` and a branch, at most. */
const CURVE = 180;
const width = START + SPAN + END;
const x = (position: number) => Math.round(START + position * SPAN);
const y = (lane: string) => (lane === 'main' ? 0 : LANE);

const graph = [
	`M ${x(0)} 0 H ${x(1)}`,
	...branches.map((branch) => {
		const [fork, open, merge] = [x(branch.fork), x(branch.open), x(branch.merge)];
		const back = Math.max(x(branch.last), merge - CURVE);
		const out = (open - fork) / 2;
		const home = (merge - back) / 2;
		return `M ${fork} 0 C ${fork + out} 0 ${open - out} ${LANE} ${open} ${LANE} H ${back} C ${back + home} ${LANE} ${merge - home} 0 ${merge} 0`;
	}),
].join(' ');
---

<section id="parcours" class="frise" aria-labelledby={titleId}>
	<div class="wrap frise-head">
		<SectionHeading number={number} title="Parcours" titleId={titleId} aside={aside} onAccent />
		<p class="mono frise-summary">{summary}</p>
	</div>

	{/* Focusable, so that the keyboard scrolls it; the perspective sits on it, so the camera stays still. */}
	<div class="frise-band" role="region" aria-label="Frise du parcours" tabindex="0">
		<div class="frise-plane" style={`--frise-width: ${width}px`}>
			<div class="frise-grid" aria-hidden="true"></div>
			<svg
				class="frise-graph"
				aria-hidden="true"
				width={width}
				height={-LANE + 40}
				viewBox={`0 ${LANE - 20} ${width} ${-LANE + 40}`}
			>
				<path d={graph} />
				{
					commits.map((commit) => (
						<circle cx={x(commit.position)} cy={y(commit.lane)} r="7.5" data-kind={commit.kind} />
					))
				}
			</svg>
			<ol class="frise-commits">
				{
					commits
						.filter((commit) => !commit.unlabeled)
						.map((commit) => (
							<li
								class="commit"
								data-lane={commit.lane === 'main' ? 'main' : 'branch'}
								style={`--x: ${x(commit.position)}px`}
							>
								<div class="commit-card">
									<p class="mono commit-meta">
										{commit.datetime ? <time datetime={commit.datetime}>{commit.date}</time> : commit.date}
										{` · ${commit.lane}`}
									</p>
									<p class="commit-title">
										{commit.titleExpansion ? <abbr title={commit.titleExpansion}>{commit.title}</abbr> : commit.title}
									</p>
									<p class="commit-place">{commit.place}</p>
								</div>
								<span class="commit-pole" aria-hidden="true" />
							</li>
						))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.frise {
		--frise-tilt: 58deg;
		--frise-mesh: 110px;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		height: 100svh;
		margin-top: clamp(64px, 8vw, 120px);
		padding-top: clamp(28px, 4vw, 40px);
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.frise-summary {
		margin: 12px 0 0;
		font-size: 13px;
		color: var(--color-on-accent-muted);
	}

	.frise-band {
		position: relative;
		flex: 1;
		min-height: 0;
		overflow-x: auto;
		overflow-y: hidden;
		perspective: 1100px;
		perspective-origin: 40% 20%;
		scrollbar-color: var(--color-on-accent-muted) transparent;
	}

	.frise-band:focus-visible {
		outline: 2px solid var(--color-on-accent);
		outline-offset: -6px;
	}

	/* Tilted back around `main`; the labels stand back up on it. */
	.frise-plane {
		position: absolute;
		top: 78%;
		left: 0;
		width: var(--frise-width);
		height: 0;
		transform-origin: 0 0;
		transform: rotateX(var(--frise-tilt));
		transform-style: preserve-3d;
	}

	.frise-grid {
		position: absolute;
		/* Barely in front of `main`: magnified by the perspective, a nearer edge would widen the strip's scroll. */
		top: -540px;
		left: 0;
		width: 100%;
		height: 620px;
		background-image:
			linear-gradient(rgb(255 255 255 / 0.13) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.13) 1px, transparent 1px);
		background-size: var(--frise-mesh) var(--frise-mesh);
		/* The far edge fades into the band rather than stopping on a line. */
		mask-image: linear-gradient(to top, #000 50%, transparent);
	}

	.frise-graph {
		position: absolute;
		top: -200px;
		left: 0;
		overflow: visible;
		/* Firefox skips painting an untransformed SVG inside a 3D rendering context. */
		transform: translateZ(0);
	}

	.frise-graph path {
		fill: none;
		stroke: var(--color-on-accent);
		stroke-width: 4;
		stroke-linecap: round;
	}

	.frise-graph circle {
		fill: var(--color-on-accent);
		stroke: var(--color-on-accent);
		stroke-width: 3;
	}

	/* A merge stays hollow, as in `git log --graph`. */
	.frise-graph circle[data-kind='merge'] {
		fill: var(--color-accent);
	}

	.frise-commits {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		transform-style: preserve-3d;
	}

	.commit {
		position: absolute;
		left: var(--x);
		bottom: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		transform-origin: 0 100%;
		transform: rotateX(calc(-1 * var(--frise-tilt)));
	}

	.commit[data-lane='branch'] {
		bottom: 180px;
	}

	.commit-card {
		display: flex;
		flex-direction: column;
		gap: 4px;
		box-sizing: border-box;
		width: 240px;
		padding-left: 10px;
		border-left: 1px solid var(--color-on-accent);
	}

	.commit-card p {
		margin: 0;
	}

	.commit-meta {
		font-size: 11px;
		color: var(--color-on-accent-muted);
	}

	.commit-title {
		font-size: 19px;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	.commit-title abbr {
		text-decoration: none;
	}

	.commit-place {
		font-size: 13px;
		line-height: 1.35;
		color: var(--color-on-accent-muted);
	}

	/* Fully raised at the final state. */
	.commit-pole {
		width: 1px;
		height: 138px;
		background: var(--color-on-accent);
	}

	.commit[data-lane='branch'] .commit-pole {
		height: 88px;
	}
</style>
