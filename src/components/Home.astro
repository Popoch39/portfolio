---
// L'accueil, rendu par la route de chaque langue (`src/pages/index.astro`, `src/pages/en/index.astro`) :
// la langue vient de l'URL, par `Astro.currentLocale`.
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Projects from './Projects.astro';
import Career from './Career.astro';
import Activity from './Activity.astro';
import Stack from './Stack.astro';
import Contact from './Contact.astro';
import StatusBar from './StatusBar.astro';
import { githubSnapshot } from '../data/github-snapshot';
import { activityStats, formatNumber } from '../lib/activity';
import { home, localeOf, ui } from '../lib/i18n';

const locale = localeOf(Astro.currentLocale);
const stats = activityStats(githubSnapshot);
---

<Layout page={home}>
	<div class="container">
		<SiteHeader page={home} />
	</div>
	<main>
		<div class="container">
			<Hero />
		</div>
		<Marquee />
		<div class="container">
			<Projects />
			<Career />
			<Activity stats={stats} />
			<Stack />
			<Contact />
		</div>
	</main>
	<StatusBar secondary={ui.statusContributions[locale](formatNumber(stats.total, locale))} />
</Layout>

<style is:global>
	/* Lettre à lettre, le retour (ADR 0004). La fiche se retire en trois temps, l'anatomie d'abord ; les
	   lettres repartent en arc vers leur ligne ; l'accueil revient de part et d'autre du nom. */
	@media (prefers-reduced-motion: no-preference) {
		::view-transition-old(root) {
			--vt-shift: 0 -10px;
			animation: vt-leave 320ms cubic-bezier(0.5, 0, 0.75, 0) both;
		}

		::view-transition-old(hero-body) {
			--vt-shift: 0 28px;
			animation: vt-leave 240ms cubic-bezier(0.5, 0, 0.75, 0) both;
		}

		::view-transition-old(anatomy) {
			--vt-shift: 0 48px;
			animation: vt-leave 160ms cubic-bezier(0.5, 0, 0.75, 0) both;
		}

		::view-transition-new(root),
		::view-transition-new(projects-head),
		::view-transition-new(preview) {
			--vt-shift: 0 48px;
			animation: vt-arrive 880ms cubic-bezier(0.16, 1, 0.3, 1) 240ms both;
		}

		::view-transition-new(projects-head) {
			--vt-shift: 0 -32px;
		}

		::view-transition-new(preview) {
			--vt-shift: 32px 0;
		}

		::view-transition-new(word-frame) {
			animation: vt-arrive 400ms ease 720ms both;
		}

		::view-transition-group(status) {
			animation-duration: 320ms;
			animation-delay: 160ms;
		}

		::view-transition-group(*.letter) {
			animation-duration: 880ms;
		}

		::view-transition-old(*.letter) {
			animation-name: vt-arc, vt-capital-out;
			animation-duration: 880ms, 640ms;
		}

		::view-transition-new(*.letter) {
			animation-name: vt-arc, vt-lowercase-in;
			animation-duration: 880ms, 560ms;
		}

		@keyframes vt-capital-out {
			from,
			25% {
				opacity: 1;
			}
			to {
				opacity: 0;
			}
		}

		@keyframes vt-lowercase-in {
			from,
			14% {
				opacity: 0;
			}
			to {
				opacity: 1;
			}
		}
	}
</style>
