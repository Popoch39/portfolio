---
/**
 * The paper grain over the whole window, on every page: the texture of a print. Pure CSS, still,
 * and painted from a noise tile rasterised once. Above everything but never in the way of the pointer.
 */
import { PAPER_GRAIN } from '../grain/paper';
---

<div id="grain" class="grain-layer" aria-hidden="true">
	<div class="grain" style={`background-image: url("${PAPER_GRAIN}")`}></div>
</div>

<style>
	.grain-layer {
		position: fixed;
		inset: 0;
		/* Above the statusline. */
		z-index: 4;
		overflow: hidden;
		opacity: 0.16;
		pointer-events: none;
	}

	.grain {
		position: absolute;
		inset: 0;
	}

	@media print {
		.grain-layer {
			display: none;
		}
	}
</style>
