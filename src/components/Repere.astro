---
// Repère : au-dessus de la figure, l'étiquette de la pièce visée, la pièce maîtresse au repos :
// numéro, nom, rôle, signature du code et lien vers lui, reliée à la pièce par un trait et une
// pointe. Un panneau par pièce, tous empilés : le bandeau prend la hauteur du plus haut, et changer
// de pièce ne décale rien. La mise en avant (`data-on`) choisit le panneau visible ; le script de la
// fiche (`placeRepere`) place l'étiquette, le trait et la pointe. Doublon visuel de la
// nomenclature : les technologies d'assistance l'ignorent, et son lien sort de l'ordre de tabulation.
import type { Piece, Signature } from '../anatomies/contract';
import { signatureLines } from '../anatomies/signature';
import { localeOf, ui } from '../lib/i18n';

interface Props {
	pieces: Piece<'page'>[];
	codeUrl: (piece: Piece<'page'>) => string;
	signatureOf: (piece: Piece<'page'>) => Signature;
}

const { pieces, codeUrl, signatureOf } = Astro.props;
const locale = localeOf(Astro.currentLocale);
---

<div class="repere" data-repere aria-hidden="true">
	{
		pieces.map((piece, i) => {
			const [first, last] = piece.code.lines;
			const lines = signatureLines(signatureOf(piece), piece.code.path);
			const count = last - first + 1;
			return (
				<article class="panel" data-piece={piece.id} data-master={piece.master ? '' : undefined}>
					<span class="mono num">{String(i + 1).padStart(2, '0')}</span>
					<div class="body">
						<p class="head">
							<span class="name">{piece.name}</span>
							{piece.master && <span class="mono tag">{ui.keyPart[locale]}</span>}
						</p>
						<p class="role">{piece.role}</p>
						<div class="mono signature">
							{lines.map(({ line, tokens }) => (
								<span class="line">
									<span class="ln">{line}</span>
									<code>
										{tokens.map((token) => (
											<span class={`k-${token.kind}`}>{token.text}</span>
										))}
									</code>
								</span>
							))}
						</div>
						<a class="mono ref" href={codeUrl(piece)} tabindex="-1">
							{ui.calloutLines[locale](piece.code.path.split('/').pop() ?? '', first, last)}
							{count > lines.length && ui.calloutTotal[locale](count)} ↗
						</a>
					</div>
				</article>
			);
		})
	}
	<span class="leader"></span>
	<span class="tip"></span>
</div>

<style>
	/* Au-dessus de la figure, l'étiquette glisse en x et son trait descend (`--repere-axis: x`, que
	   lit le script). Le bandeau suit la largeur de la carte sans l'élargir (une figure en hauteur
	   garde sa carte). */
	.repere {
		--repere-axis: x;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		width: 0;
		min-width: 100%;
		padding-bottom: 22px;
	}

	.panel {
		grid-area: 1 / 1;
		align-self: end;
		display: flex;
		gap: 14px;
		width: min(470px, 100%);
		visibility: hidden;
		will-change: translate;
	}

	/* À côté d'une figure haute, sur grand écran (même seuil que dans `FigureCard.astro`) :
	   l'étiquette glisse en y jusqu'à la hauteur de la pièce, et son trait part vers la droite. */
	@media (min-width: 960px) {
		:global(.beside) .repere {
			--repere-axis: y;
			width: auto;
			min-width: 0;
			padding-bottom: 0;
		}

		:global(.beside) .panel {
			align-self: start;
			width: 100%;
		}
	}

	/* Le panneau de la pièce visée, sinon celui de la pièce maîtresse (`data-aiming`, posé sur la
	   section par la mise en avant tant qu'une pièce est visée). */
	.panel[data-on],
	.panel[data-master] {
		visibility: visible;
	}

	:global([data-aiming]) .panel[data-master]:not([data-on]) {
		visibility: hidden;
	}

	.num {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border: 1px solid var(--ink);
		border-radius: 50%;
		background: var(--paper);
		font-size: 11px;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
		flex: 1;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 12px;
		margin: 0;
	}

	.name {
		font-size: 22px;
		line-height: 30px;
		font-weight: 700;
		font-stretch: 80%;
	}

	.tag {
		font-size: 11px;
		color: var(--accent);
	}

	.role {
		margin: 0;
		font-size: 14px;
		line-height: 1.42;
		color: var(--muted);
		text-wrap: pretty;
	}

	.signature {
		display: flex;
		flex-direction: column;
		margin-top: 4px;
		padding-top: 8px;
		border-top: 1px solid var(--rule);
		font-size: 12px;
		line-height: 19px;
		/* Le code tel qu'il est écrit : `>=` reste `>=`, pas `≥`. */
		font-variant-ligatures: none;
	}

	/* Une ligne de code ne passe jamais à la ligne : trop longue, elle s'efface en points de suspension. */
	.line {
		display: flex;
		gap: 14px;
		min-width: 0;
	}

	.ln {
		flex: none;
		min-width: 3ch;
		text-align: right;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	code {
		min-width: 0;
		overflow: hidden;
		font: inherit;
		white-space: pre;
		text-overflow: ellipsis;
		tab-size: 2;
	}

	.k-kw,
	.k-num {
		color: var(--accent);
	}

	.k-num {
		font-style: italic;
	}

	.k-fn {
		text-decoration: underline 1.5px var(--accent-light);
		text-underline-offset: 3px;
	}

	.k-str {
		color: var(--accent-deep);
		background: var(--accent-wash);
		border-radius: 2px;
	}

	.k-type,
	.k-com {
		font-style: italic;
	}

	.k-pun,
	.k-com {
		color: var(--muted);
	}

	.ref {
		align-self: flex-start;
		font-size: 11.5px;
		text-underline-offset: 3px;
		overflow-wrap: anywhere;
	}

	/* Le trait part de l'étiquette (sous elle, ou à sa droite) jusqu'à la pointe, posée sur la pièce.
	   Tous deux attendent le script, qui les place (et décale les panneaux), et laissent passer le
	   pointeur vers la figure. */
	.leader,
	.tip {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		display: none;
		pointer-events: none;
		will-change: translate, scale;
	}

	.repere[data-placed] :is(.leader, .tip) {
		display: block;
	}

	.leader {
		width: 1px;
		height: 1px;
		background: var(--ink);
		transform-origin: 0 0;
	}

	.tip {
		width: 7px;
		height: 7px;
		background: var(--accent);
		box-shadow: 0 0 0 2px var(--paper);
	}
</style>
