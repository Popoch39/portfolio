---
/**
 * Vim-like statusline, fixed to the bottom of the window. Purely decorative: hidden from
 * assistive technologies. Outside the smoothed content, otherwise its transform would carry it along.
 */
---

<div id="statusline" class="statusline mono" aria-hidden="true" data-intro="statusline">
	<div class="side">
		{/* The home page's lede types in Vim: its mode is echoed here (`src/lede/typist.ts`). */}
		<span class="mode" data-vim-mode>NORMAL</span>
		<span class="segment branch">
			<svg
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				><circle cx="6" cy="5" r="2.2"></circle><circle cx="6" cy="19" r="2.2"></circle><circle
					cx="18"
					cy="8"
					r="2.2"></circle><path d="M6 7.2v9.6M18 10.2c0 4-6 3.5-11 6.8"></path></svg
			>
			<span>main</span>
		</span>
		<span class="file">~/louis/portfolio.md<span data-vim-modified hidden> [+]</span></span>
	</div>
	<div class="side">
		<span class="encoding">utf-8 · markdown</span>
		<span class="segment">Bas</span>
		<span class="mode">:wq</span>
	</div>
</div>

<style>
	.statusline {
		position: fixed;
		inset: auto 0 0;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		height: var(--statusline-height);
		background: var(--color-ink);
		color: var(--color-paper);
		font-size: 12px;
		line-height: var(--statusline-height);
	}

	.side {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}

	.side:last-child {
		flex-shrink: 0;
	}

	.side > * {
		padding: 0 14px;
	}

	.mode {
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-weight: 700;
	}

	.mode[data-mode='INSERT'] {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.segment {
		background: var(--color-bar);
	}

	.branch {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.file {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.encoding {
		color: var(--color-on-ink-muted);
	}

	@media (max-width: 860px) {
		.encoding {
			display: none;
		}
	}
</style>
