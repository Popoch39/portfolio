---
import Atome from '../components/Atome.astro';
import Cafe from '../components/Cafe.astro';
import Frise from '../components/Frise.astro';
import Intro from '../components/Intro.astro';
import IntroTrigger from '../components/IntroTrigger.astro';
import Lede from '../components/Lede.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SectionNumber from '../components/SectionNumber.astro';
import Layout from '../layouts/Layout.astro';
import { currentPosition, education, marqueeWords, person, profile, stack } from '../data/profile';
import { coordinates, graticule, kilometre, latTicks, lonTicks } from '../hero/map';

const title = 'Louis Pocheron — Développeur web & SIG à Besançon';
const description =
	'Sites vitrines, boutiques en ligne et prise de rendez-vous pour les commerces locaux ; cartographie SIG pour l’énergie et les collectivités. À Besançon.';

const mailto = `mailto:${person.email}`;

const mapStyle = [
	`--pitch-x: ${graticule.pitchX}px`,
	`--pitch-y: ${graticule.pitchY}px`,
	`--phase-x: ${graticule.phaseX}px`,
	`--phase-y: ${graticule.phaseY}px`,
	`--kilometre: ${kilometre}px`,
].join('; ');
const [mailUser, mailDomain] = person.email.split('@');

const canonical = new URL('/', Astro.site).href;
// `<` escaped: the JSON sits inside a <script> and must not be able to close it.
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: canonical,
	name: title,
	description,
	inLanguage: 'fr-FR',
	// Google reads the site name shown above the result from a WebSite node on the home page.
	isPartOf: { '@type': 'WebSite', '@id': `${canonical}#website`, name: person.name, url: canonical },
	mainEntity: {
		'@type': 'Person',
		'@id': `${canonical}#person`,
		name: person.name,
		givenName: person.givenName,
		familyName: person.familyName,
		url: canonical,
		email: mailto,
		jobTitle: person.jobTitle,
		description: profile.specialty,
		address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: person.country },
		worksFor: currentPosition && {
			'@type': 'Organization',
			name: currentPosition.company,
			address: { '@type': 'PostalAddress', addressLocality: currentPosition.city, addressCountry: 'FR' },
		},
		alumniOf: [...new Set(education.map((e) => e.school))].map((name) => ({
			'@type': 'EducationalOrganization',
			name,
		})),
		knowsAbout: stack.flatMap((group) => group.items),
		sameAs: [person.github.url],
	},
}).replace(/</g, '\\u003c');
---

<Layout title={title} description={description} pause>
	<script slot="head" type="application/ld+json" set:html={jsonLd} />
	<IntroTrigger slot="head" />
	<Intro slot="overlay" />

	<main>
		<div class="wrap">
			<section class="hero" aria-labelledby="hero-title">
				{/* The name stands on a parallel that runs to Besançon, on a map whose scale holds (`src/hero/map.ts`). */}
				<div class="hero-map" style={mapStyle}>
					<div class="hero-north">
						<div class="mono hero-ticks" aria-hidden="true">
							{
								lonTicks.map((tick) => (
									<span class="tick tick-lon" data-shown={tick.shown} style={`--x: ${tick.x}px`}>
										{tick.text}
									</span>
								))
							}
						</div>
						<h1 id="hero-title" class="hero-title">
							<span class="hero-line"><span data-intro="line">{person.givenName}</span></span>{' '}
							<span class="hero-line"><span data-intro="line">{person.familyName}</span></span>
						</h1>
					</div>
					<div class="hero-south">
						<div class="hero-axis" aria-hidden="true">
							<span class="hero-rule"></span>
							<span class="mono hero-ticks">
								{
									latTicks.map((tick) => (
										<span class="tick tick-lat" data-shown={tick.shown} style={`--y: ${tick.y}px`}>
											{tick.text}
										</span>
									))
								}
							</span>
							<span class="hero-marker" data-intro="late"><span class="hero-ring"></span><span class="hero-point"></span></span>
						</div>
						<p class="mono hero-place" data-intro="late">
							<span class="hero-city">{person.city}</span><span class="hero-coordinates"
								><span>{coordinates.latitude}</span><span class="hero-separator"> · </span><span
									>{coordinates.longitude}</span
								></span
							>
						</p>
						<Lede />
						<div class="hero-actions" data-intro="actions">
							<a class="button" href={mailto}
								>Écrire<span class="visually-hidden"> un e-mail</span>
								<span class="mono" aria-hidden="true">:wq</span></a
							>
							<a class="hero-github" href={person.github.url} rel="me">GitHub <span aria-hidden="true">↗</span></a>
						</div>
					</div>
					<div class="mono hero-scale" aria-hidden="true">
						<span class="hero-scale-labels"><span>0</span><span>1 km</span></span>
						<span class="hero-scale-bar"></span>
					</div>
				</div>
			</section>
		</div>

		{/* Everything after the first screen, in one block: the page's grid gives the hero its own row. */}
		<div>
			<div class="marquee" aria-hidden="true" data-marquee>
				{/* Two copies: the track slides by half its width, then loops seamlessly. */}
				<div class="marquee-track">
					{
						[...marqueeWords, ...marqueeWords].map((word) => (
							<span class="marquee-item">
								{word}
								<span class="marquee-slash">/</span>
							</span>
						))
					}
				</div>
			</div>

			<Frise number={1} titleId="career-title" />

			<div class="wrap">
				<section id="stack" class="section" aria-labelledby="stack-title">
					<SectionHeading number={2} title="Stack" titleId="stack-title" aside=":set stack?" />
					<Atome />
					{/* The last element the Atome's pinned frame keeps in view: its screen fit measures down to it. */}
					<p class="mono stack-note" data-atome-frame-end>
						éditeur : neovim · multiplexeur : tmux · runtime : bun — <a href={person.nvimConfig}
							>la config est sur GitHub</a
						>
					</p>
				</section>
			</div>

			{/* Out of the column: the moka's zoomed stack runs past it, clipped by the figure. */}
			<Cafe number={3} titleId="cafe-title" />

			<div class="wrap">
				<section id="contact" class="contact-section" aria-labelledby="contact-title">
					<div class="contact grid-12">
						<SectionNumber number={4} />
						<div class="contact-body">
							<h2 id="contact-title" class="visually-hidden">Contact</h2>
							<p class="contact-wq" aria-hidden="true">:wq</p>
							<p class="contact-lede">Un projet carto, une API, une interface React&nbsp;? Écrivez-moi.</p>
							<a class="contact-mail" href={mailto}>{mailUser}@<wbr />{mailDomain}</a>
							<div class="contact-links">
								<a href={person.github.url} rel="me"
									>GitHub — {person.github.user} <span aria-hidden="true">↗</span></a
								>
								<a href={person.nvimConfig}>Config Neovim <span aria-hidden="true">↗</span></a>
								<span class="dim">{person.city}, France</span>
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { registerScene } from '../animation/base';
	import { markOffScreen } from '../animation/offscreen';

	// The marquee slides in CSS; registered for the context alone, so that its observer goes with a change of preference.
	registerScene(() => {
		const marquee = document.querySelector<HTMLElement>('[data-marquee]');
		return marquee ? markOffScreen(marquee) : undefined;
	});
</script>

<style>
	.dim {
		color: var(--color-ink-muted);
	}

	/* Hero */

	/*
	 * The first screen: the header and the hero fill the window above the statusline, the title taking
	 * whatever height is left. A spacer spanning the header's row and the hero's sets that height;
	 * the extra goes to the hero's flexible row only. `svh`: the window with the browser's bars shown,
	 * so that nothing is hidden at first and nothing resizes when the bars slide away while scrolling.
	 */
	:global(.page) {
		display: grid;
		/* `minmax(0, …)`: the marquee's track, wider than the window, must not widen the column. */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
	}

	:global(.page)::before {
		content: '';
		grid-area: 1 / 1 / 3;
		min-height: calc(100svh - var(--statusline-height));
	}

	/* A grid item with auto margins shrinks to its content: the centred column keeps its full width. */
	:global(.page > .wrap) {
		grid-area: 1 / 1;
		width: 100%;
	}

	main {
		display: grid;
		grid-area: 2 / 1 / 4;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: subgrid;
	}

	main > .wrap {
		display: flex;
		width: 100%;
	}

	.hero {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 24px 0;
	}

	/*
	 * The map fills what the first screen leaves. The parallel the name stands on splits it at 54 %
	 * of its height; a row whose content needs more takes it, and on a window too short for both the
	 * map runs past the first screen. The marker stands at 64 % of the width (76 % on narrow screens).
	 * Size containment: sized on its content, the rows' fractions would inflate the map past the
	 * window; the floor keeps room for the content.
	 */
	.hero-map {
		--meridian-share: 0.64;
		--meridian: calc(var(--meridian-share) * 100%);
		--inset: clamp(24px, 3.4vw, 48px);
		position: relative;
		display: grid;
		grid-template-rows: minmax(auto, 54fr) minmax(auto, 46fr);
		flex: 1;
		min-height: 480px;
		container: map / size;
		border: 1px solid var(--color-ink);
		overflow: hidden;
	}

	/*
	 * Each row draws its stretch of the graticule, set from the parallel between them: one tile per
	 * minute, its line on the tile's first pixel. A background percentage reads against the box less
	 * the tile, hence the tile's share added back to land the meridians on the marker's.
	 */
	.hero-north,
	.hero-south {
		position: relative;
		background-image:
			linear-gradient(to right, var(--color-rule) 1px, transparent 1px),
			linear-gradient(to bottom, var(--color-rule) 1px, transparent 1px);
		background-size:
			var(--pitch-x) 100%,
			100% var(--pitch-y);
		background-position-x: calc(var(--meridian) + var(--phase-x) + var(--meridian-share) * var(--pitch-x)), 0;
	}

	.hero-north {
		display: flex;
		align-items: flex-end;
		padding: 40px var(--inset) 0;
		background-position-y:
			0,
			calc(100% + var(--phase-y));
	}

	/* The bottom padding keeps the lede's keys (34px high) clear of the actions when the row is tight. */
	.hero-south {
		--keys-bottom: 18px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 36px var(--inset) calc(var(--keys-bottom) + 34px + 24px);
		background-position-y:
			0,
			var(--phase-y);
	}

	.hero-title {
		display: flex;
		column-gap: 0.22em;
		margin: 0;
		font-size: clamp(52px, 8.4vw, 121px);
		font-weight: 800;
		font-stretch: 75%;
		letter-spacing: -0.03em;
		white-space: nowrap;
	}

	/*
	 * Each line clips its own rise, out of the parallel: its box stops on the baseline, so the name
	 * stands on the rule. From Archivo's metrics (ascent 0.878em, descent 0.21em, caps 0.686em), a
	 * 0.904 line height puts the top of the line box 0.1em above the caps, room for the ascenders,
	 * and the baseline 0.786em below it. `text-box` would say it, but Firefox does not trim yet.
	 */
	.hero-line {
		display: block;
		height: 0.786em;
		overflow: hidden;
		line-height: 0.904;
	}

	.hero-line > span {
		display: block;
	}

	/* A zero-height line along the parallel: the rule, the latitudes and the marker hang from it. */
	.hero-axis {
		position: absolute;
		inset: 0 0 auto;
		height: 0;
	}

	.hero-rule {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--meridian);
		height: 1px;
		background: var(--color-ink);
	}

	.hero-ring,
	.hero-point {
		position: absolute;
		left: var(--meridian);
		top: 0;
		box-sizing: border-box;
	}

	.hero-ring {
		width: 36px;
		height: 36px;
		margin: -17.5px 0 0 -17.5px;
		border: 1.5px solid var(--color-accent);
		border-radius: 50%;
	}

	.hero-point {
		width: 12px;
		height: 12px;
		margin: -5.5px 0 0 -5.5px;
		background: var(--color-accent);
	}

	.hero-ticks {
		font-size: 10.5px;
		line-height: 1;
		color: var(--color-ink-muted);
	}

	/* Each composition shows the ticks that fit it (`src/hero/map.ts`). */
	.tick {
		display: none;
		position: absolute;
	}

	.tick-lon {
		top: 10px;
		left: calc(var(--meridian) + var(--x) + 6px);
	}

	.tick-lat {
		right: 10px;
		top: calc(var(--y) - 13px);
	}

	@media (min-width: 861px) {
		.tick[data-shown~='desk'] {
			display: block;
		}
	}

	@container map (width >= 960px) {
		.tick[data-shown~='desk-wide'] {
			display: block;
		}
	}

	@container map (width >= 1290px) {
		.tick[data-shown~='desk-wider'] {
			display: block;
		}
	}

	.hero-place {
		position: absolute;
		left: calc(var(--meridian) + 28px);
		top: 16px;
		display: flex;
		flex-direction: column;
		margin: 0;
		font-size: 12px;
		line-height: 1.5;
		white-space: nowrap;
		color: var(--color-ink-muted);
		/* A halo of paper over the graticule; the Intro's label wears the same one. */
		background: var(--color-paper);
		box-shadow: 0 0 0 4px var(--color-paper);
	}

	.hero-city {
		color: var(--color-ink);
	}

	/* The lede is a component: its root carries the component's scope, not the page's. */
	.hero-south > :global(.hero-lede) {
		width: min(540px, 52%);
	}

	/* In the map's bottom-left corner, a screencast's place, facing the scale bar. */
	.hero-south :global(.keys) {
		left: var(--inset);
		bottom: var(--keys-bottom);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
		margin-top: 28px;
	}

	.hero-github {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 600;
		text-underline-offset: 4px;
	}

	/* Left of the latitudes' column, which could otherwise run into it. */
	.hero-scale {
		position: absolute;
		right: 64px;
		bottom: 18px;
		display: flex;
		flex-direction: column;
		gap: 5px;
		width: var(--kilometre);
		font-size: 10.5px;
		line-height: 1;
		color: var(--color-ink-muted);
	}

	.hero-scale-labels {
		display: flex;
		justify-content: space-between;
	}

	/* Half ink, half paper, like a printed scale bar. */
	.hero-scale-bar {
		height: 5px;
		box-sizing: border-box;
		border: 1px solid var(--color-ink);
		background: linear-gradient(to right, var(--color-ink) 50%, transparent 50%);
	}

	/*
	 * Narrow screens: the name on two lines over a parallel set higher, Besançon further right with
	 * its label above the rule, the lede across the map.
	 */
	@media (max-width: 860px) {
		.hero {
			padding: 16px 0;
		}

		.hero-map {
			--meridian-share: 0.76;
			--inset: 14px;
			grid-template-rows: minmax(auto, 44fr) minmax(auto, 56fr);
			min-height: 440px;
		}

		.hero-north {
			padding-top: 32px;
		}

		.hero-south {
			--keys-bottom: 14px;
			padding-top: 28px;
		}

		/* Baseline to baseline, 0.95em. */
		.hero-title {
			flex-direction: column;
			row-gap: 0.164em;
			font-size: clamp(52px, 15.4vw, 96px);
		}

		.tick[data-shown~='narrow'] {
			display: block;
		}

		.tick-lon {
			top: 9px;
		}

		.tick-lat {
			right: 8px;
		}

		.hero-ticks {
			font-size: 10px;
		}

		.hero-place {
			left: auto;
			right: 8px;
			top: auto;
			bottom: calc(100% + 24px);
			align-items: flex-end;
			font-size: 11px;
		}

		.hero-coordinates {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
		}

		.hero-separator {
			display: none;
		}

		/* Clear of the latitudes' column. */
		.hero-south > :global(.hero-lede) {
			width: min(540px, 100% - 36px);
		}

		.hero-scale {
			right: 56px;
			bottom: 14px;
			font-size: 10px;
		}
	}

	/* A phone has no room for both side by side: the keys stand above the scale bar's row. */
	@media (max-width: 600px) {
		.hero-south {
			--keys-bottom: 48px;
		}
	}

	/* Marquee */

	.marquee {
		overflow: hidden;
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 42s linear infinite;
	}

	/* Nothing slides that nobody sees: out of view, and under the Voile. Nor once the visitor has paused it. */
	.marquee[data-offscreen] .marquee-track,
	:global(html.intro) .marquee-track,
	:global(:root:has(#pause:checked)) .marquee-track {
		animation-play-state: paused;
	}

	.marquee-item {
		display: flex;
		align-items: center;
		gap: 26px;
		padding: 18px 0 18px 26px;
		font-size: clamp(22px, 2.6vw, 38px);
		font-weight: 800;
		font-stretch: 72%;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.marquee-slash {
		color: var(--color-on-ink-faint);
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* Sections */

	.section {
		padding-top: clamp(64px, 8vw, 120px);
	}

	/* Stack */

	.stack-note {
		margin: 22px 0 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	/* Contact */

	.contact-section {
		padding: clamp(72px, 9vw, 136px) 0 clamp(56px, 6vw, 96px);
	}

	.contact {
		row-gap: 18px;
	}

	.contact-body {
		grid-column: 2 / span 11;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
	}

	.contact-wq {
		margin: 0;
		font-size: clamp(88px, 14vw, 216px);
		line-height: 0.78;
		font-weight: 900;
		font-stretch: 62%;
		/* Its descender runs into the lede: in ink, the two would merge; ink keeps 5:1 over this shade. */
		color: var(--color-accent-display);
	}

	.contact-lede {
		margin: 0;
		font-size: clamp(20px, 2vw, 28px);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.contact-mail {
		max-width: 100%;
		/* Down to 22px rather than 30px: the address stays on one line on a 320px phone. */
		font-size: clamp(22px, 6.2vw, 92px);
		line-height: 1.05;
		font-weight: 900;
		font-stretch: 70%;
		letter-spacing: -0.02em;
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0 0.06em;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.35s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-mail:hover {
			background-size: 100% 0.06em;
			color: var(--color-ink);
		}
	}

	/* Pressed: the underline is drawn, the address keeps its ink (the muted press of links would grey it). */
	.contact-mail:active {
		background-size: 100% 0.06em;
		color: var(--color-ink);
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		margin-top: 10px;
		font-size: 16px;
		font-weight: 500;
	}

	.contact-links a {
		text-underline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}

		.contact-mail {
			transition: none;
		}
	}
</style>
