---
// La fiche d'un projet, rendue par la route de chaque langue (`src/pages/projets/[slug].astro`,
// `src/pages/en/projects/[slug].astro`) : la langue vient de l'URL, par `Astro.currentLocale`.
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import ProjectHero from './ProjectHero.astro';
import SectionHeader from './SectionHeader.astro';
import FigureCard from './FigureCard.astro';
import Nomenclature from './Nomenclature.astro';
import Notes from './Notes.astro';
import Regle from './Regle.astro';
import GrainPatterns from './GrainPatterns.astro';
import ProjectNav from './ProjectNav.astro';
import StatusBar from './StatusBar.astro';
import { githubRepoUrl, shareImageOf, type Project } from '../data/profile';
import { person } from '../lib/structured-data';
import { fiche, formats, localeOf, pathOf, ui } from '../lib/i18n';
import { anatomyOf } from '../anatomies/registry';
import { restSvg } from '../anatomies/figure';
import { annotate } from '../anatomies/annotations';

interface Props {
	project: Project;
}

const { project } = Astro.props;
const locale = localeOf(Astro.currentLocale);
const page = fiche(project.slug);
const anatomy = anatomyOf(project, locale);
const { content } = anatomy;
const notes = annotate(content, anatomy.renderRest().body, anatomy.anchors);

const sourceCode = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	name: project.repo,
	description: content.seo.description,
	inLanguage: formats[locale].lang,
	url: new URL(pathOf(page, locale), Astro.site).href,
	codeRepository: githubRepoUrl(project.repo),
	programmingLanguage: project.language,
	author: person(Astro.site, locale),
};
---

<Layout
	page={page}
	title={content.seo.title}
	description={content.seo.description}
	shareImage={shareImageOf(project, content.machine, locale)}
	ogType="website"
	structuredData={sourceCode}
>
	<div class="container">
		<SiteHeader page={page} current="projects" />
	</div>
	<main class="container">
		<ProjectHero project={project} lede={content.lede} />
		<section class="anatomy">
			<SectionHeader number="A" title={ui.anatomy[locale]} note={ui.anatomyNote[locale](content.pieces.length)} />
			<FigureCard fig={1} title={content.title} caption={content.caption}>
				<Notes
					slot="stage"
					layout={notes}
					svg={restSvg(anatomy)}
					motion={anatomy.motion}
					phoneCrop={content.phoneCrop}
					codeUrl={anatomy.codeUrl}
					signatureOf={anatomy.signatureOf}
					consignes={content.timeline?.consignes ?? content.consignes}
					releve={content.releve}
				>
					{content.timeline && <Regle timeline={content.timeline} />}
				</Notes>
			</FigureCard>
			<Nomenclature pieces={content.pieces} codeUrl={anatomy.codeUrl} />
			<GrainPatterns />
		</section>
		<ProjectNav project={project} />
	</main>
	<StatusBar path={ui.statusFiche[locale](project.repo)} secondary={ui.statusParts[locale](1, content.pieces.length)} position={null} />
</Layout>

<script>
	// Le chargeur de la fiche : la figure arrive dessinée, seul son mouvement passe par ici. L'écouteur de
	// la Lunette passe aussi par ce module, le seul de la fiche (ADR 0007).
	import { mountFigure } from '../anatomies/loader.ts';
	import { aimPiece, linkPieces } from '../anatomies/highlight.ts';
	import '../lunette/keys.ts';

	// Le Glissé de la molette (ADR 0013), demandé une fois la première image peinte pour ne pas la
	// retarder, et avant d'attendre la transition : la molette sert dès que la fiche est là.
	requestAnimationFrame(() => setTimeout(() => void import('../lib/glide.ts')));

	const scene = document.querySelector<HTMLElement>('[data-motion]');
	const svg = scene?.querySelector('svg');
	const card = scene?.closest('figure');
	const releve = card?.querySelector<HTMLElement>('[data-releve]');
	const anatomy = scene?.closest('section');
	if (scene?.dataset.motion && svg && releve && anatomy) {
		// Arrivée par la transition lettre à lettre (ADR 0004) : la figure ne se monte qu'une fois les
		// lettres posées, son montage ferait sauter des images. Prérendue au survol (ADR 0006), la fiche
		// n'est affichée, et sa transition créée, qu'à son activation : `pagereveal` porte alors la transition.
		const transition = document.prerendering
			? await new Promise<ViewTransition | null>((resolve) => addEventListener('pagereveal', (e) => resolve(e.viewTransition), { once: true }))
			: document.activeViewTransition;
		await transition?.finished;
		linkPieces(anatomy);
		// `:pieces` vise par un événement `aim` sur le crochet de la pièce : la Lunette n'importe pas la
		// mise en avant, ce module la passe à `aimPiece`.
		anatomy.addEventListener('aim', ({ target }) => target instanceof Element && aimPiece(target));
		const ruler = card?.querySelector<HTMLElement>('[data-regle]');
		const tour = card?.querySelector<HTMLButtonElement>('[data-tour]');
		void mountFigure({ scene, svg, releve, timeline: ruler && tour ? { ruler, tour } : undefined }, scene.dataset.motion);
	}
</script>

<style>
	.anatomy {
		padding-top: clamp(24px, 4vw, 56px);
	}

	/* Lettre à lettre (ADR 0004) : l'anatomie monte en dernier, nommée le temps de la transition. */
	:global(:root:active-view-transition) .anatomy {
		view-transition-name: anatomy;
	}
</style>

<style is:global>
	/* Lettre à lettre, l'aller (ADR 0004). L'accueil s'écarte du nom : l'en-tête monte, les autres lignes
	   descendent, l'aperçu glisse à droite. Les lettres partent l'une après l'autre, en minuscules, et se
	   posent en capitales ; la fiche monte en trois temps, puis le curseur arrive. */
	@media (prefers-reduced-motion: no-preference) {
		::view-transition-old(root),
		::view-transition-old(projects-head),
		::view-transition-old(preview) {
			animation: vt-leave 480ms cubic-bezier(0.5, 0, 0.2, 1) both;
		}

		/* Le reste de l'accueil : les autres lignes, qui descendent. */
		::view-transition-old(root) {
			--vt-shift: 0 48px;
		}

		::view-transition-old(word-frame) {
			animation: vt-leave 240ms ease both;
		}

		::view-transition-new(root) {
			--vt-shift: 0 -10px;
			animation: vt-arrive 640ms cubic-bezier(0.16, 1, 0.3, 1) 320ms both;
		}

		::view-transition-new(hero-body) {
			animation: vt-arrive 720ms cubic-bezier(0.16, 1, 0.3, 1) 640ms both;
		}

		::view-transition-new(anatomy) {
			animation: vt-arrive 800ms cubic-bezier(0.16, 1, 0.3, 1) 800ms both;
		}

		::view-transition-group(status) {
			animation-duration: 320ms;
			animation-delay: 80ms;
		}

		::view-transition-group(*.letter) {
			animation-duration: 960ms;
		}

		::view-transition-old(*.letter) {
			animation-name: vt-arc-to-fiche, vt-lowercase-out;
			animation-duration: 960ms, 480ms;
		}

		::view-transition-new(*.letter) {
			animation-name: vt-arc-to-fiche, vt-capital-in;
			animation-duration: 960ms, 560ms;
		}

		@keyframes vt-lowercase-out {
			from,
			17% {
				opacity: 1;
			}
			to {
				opacity: 0;
			}
		}

		@keyframes vt-capital-in {
			from,
			29% {
				opacity: 0;
			}
			to {
				opacity: 1;
			}
		}
	}
</style>
