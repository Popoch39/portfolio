---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import touchIcon from '../assets/apple-touch-icon.png';
import iconUrl from '../assets/icon.svg?url';
import ogImage from '../assets/og.png';
import Grain from '../components/Grain.astro';
import Nuancier from '../components/Nuancier.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkyTrigger from '../components/SkyTrigger.astro';
import Statusline from '../components/Statusline.astro';
import Trail from '../components/Trail.astro';
import { contentOf, person } from '../data/profile';
import { defaultLang, dictionary, languages, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
	lang: Lang;
	title: string;
	description: string;
	/** Pages outside the index (404): no canonical URL, no social card, `noindex`. */
	noindex?: boolean;
	/** The page has loops to stop: the statusline carries the Pause. */
	pause?: boolean;
	/**
	 * The page's address under its language's root, the same in every language; `''` for the home page,
	 * where the 404 also sends the Bascule.
	 */
	path?: string;
}

const { lang, title, description, noindex = false, pause = false, path = '' } = Astro.props;
const { meta, statusline, nuancier } = dictionary(lang);
// The paper in force is named in CSS, from the root's `data-bg` (`Statusline.astro`): its words come in the
// page's language, set on the root where those rules read them.
const paperWords = [
	`--paper-word: '${statusline.paper}'`,
	`--paper-auto: '${nuancier.papers.auto.name.toLowerCase()}'`,
	`--paper-day: '${nuancier.papers.light.name.toLowerCase()}'`,
	`--paper-night: '${nuancier.papers.dark.name.toLowerCase()}'`,
].join('; ');

const canonical = getAbsoluteLocaleUrl(lang, path);
// The page in every language, the default one standing for a visitor whose language is none of them.
const alternates = [
	...languages.map((code) => ({ hreflang: code, href: getAbsoluteLocaleUrl(code, path) })),
	{ hreflang: 'x-default', href: getAbsoluteLocaleUrl(defaultLang, path) },
];
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
// Public by design: the beacon carries it in the page. Set up in manual mode in the dashboard, because
// Cloudflare does not inject into a Worker's static assets and the CSP would block it if it did.
const WEB_ANALYTICS_TOKEN = '594da0720f4748b0a920bfe25262f9e9';
const ogImageAlt = meta.ogImageAlt(person.name, contentOf(lang).jobTitle);
// Open Graph writes the locale with an underscore: `fr_FR`.
const ogLocale = meta.locale.replace('-', '_');
---

<!doctype html>
<html lang={lang} style={paperWords}>
	<head>
		<meta charset="utf-8" />
		{/* `cover`: the paper and the statusline run under the notch and the home indicator; `env(safe-area-inset-*)` pads the content back out. */}
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		{!noindex && alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
		<meta name="author" content={person.name} />
		<meta name="theme-color" content="#efeee9" />
		<meta name="color-scheme" content="light dark" />
		<meta name="generator" content={Astro.generator} />
		{/* After the theme colour, which it sets for the night. */}
		<SkyTrigger lang={lang} />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href={iconUrl} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={touchIcon.src} />
		<link rel="sitemap" href="/sitemap.xml" />

		{/* The variable Archivo draws the title, the LCP element: it alone is preloaded. */}
		<Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-mono" />

		{
			!noindex && (
				<>
					<meta property="og:type" content="profile" />
					<meta property="og:site_name" content={person.name} />
					<meta property="og:locale" content={ogLocale} />
					<meta property="og:url" content={canonical} />
					<meta property="og:title" content={title} />
					<meta property="og:description" content={description} />
					<meta property="og:image" content={ogImageUrl} />
					<meta property="og:image:type" content="image/png" />
					<meta property="og:image:width" content={String(ogImage.width)} />
					<meta property="og:image:height" content={String(ogImage.height)} />
					<meta property="og:image:alt" content={ogImageAlt} />
					<meta property="profile:first_name" content={person.givenName} />
					<meta property="profile:last_name" content={person.familyName} />
					<meta property="profile:username" content={person.github.user} />
					<meta name="twitter:card" content="summary_large_image" />
					<meta name="twitter:title" content={title} />
					<meta name="twitter:description" content={description} />
					<meta name="twitter:image" content={ogImageUrl} />
					<meta name="twitter:image:alt" content={ogImageAlt} />
				</>
			)
		}
		<slot name="head" />
	</head>
	<body>
		{/* Smoothed-scrolling envelope: fixed elements (the statusline) sit outside these two divs. */}
		<div id="smooth-wrapper">
			<div id="smooth-content">
				<div id="top" class="page">
					<SiteHeader lang={lang} path={path} />
					<slot />
				</div>
			</div>
		</div>
		<Statusline lang={lang} pause={pause} />
		<Nuancier lang={lang} />
		{/* Fixed layers over the whole window (the home page's Intro, the grain, then the cursor's ring), above the statusline. */}
		<slot name="overlay" />
		<Grain />
		<Trail />
		<script>
			import '../animation/base';
			import '../animation/trail';
		</script>
		{/* Cloudflare Web Analytics: visits and real Core Web Vitals, no cookie. A module, so deferred and
		    never competing with the first paint; left out of dev so local work stays uncounted. */}
		{
			import.meta.env.PROD && (
				<script
					is:inline
					type="module"
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}
				/>
			)
		}
	</body>
</html>

<style>
	/* Room for the fixed statusline: the end of the page scrolls clear of it. */
	.page {
		padding-bottom: var(--statusline-height);
	}
</style>
