---
/**
 * The hero's lede: a one-line Vim buffer that rewrites itself from one version to the next
 * (`src/lede/typist.ts`). The first version is the final state, rendered here; screen readers get
 * a stable sentence instead of the show.
 */
import { lede } from '../data/profile';
import { restingOn, runs, tallestLines } from '../lede/buffer';

const first = lede.versions[0];
---

<div class="hero-lede" data-intro="lede" data-lede={JSON.stringify(lede)}>
	<p class="visually-hidden">{lede.summary}</p>
	<p class="sentence" aria-hidden="true" data-nosnippet>
		<span class="ghosts">{tallestLines(lede).map((line) => <span>{line}</span>)}</span>
		<span data-buffer
			>{
				runs(lede, restingOn(lede, 0)).map(({ text, kind }) =>
					kind === 'text' ? text : <span data-kind={kind}>{text}</span>,
				)
			}</span
		>
	</p>
	<p class="mono version" aria-hidden="true" data-version>
		<span class="version-number">version <span data-version-number>1/{lede.versions.length}</span></span>
		<span data-audience>pour&nbsp;: {first.audience}</span>
	</p>
	<div class="mono keys" aria-hidden="true" data-keys data-on="false"></div>
</div>

<script>
	import '../lede/typist';
</script>

<style>
	.hero-lede {
		display: flex;
		flex-direction: column;
	}

	.sentence {
		position: relative;
		margin: 0;
		font-size: clamp(20px, 1.85vw, 27px);
		line-height: 1.22;
		letter-spacing: -0.012em;
	}

	/* Every version stacked in one cell: the lede keeps the height of its tallest wrap while it is retyped. */
	.ghosts {
		display: grid;
		visibility: hidden;
	}

	.ghosts > * {
		grid-area: 1 / 1;
	}

	/*
	 * Laid over the ghosts, its size taken from them and never from its text: each keystroke lays out the
	 * buffer alone, not the hero. Chromium only confines a box that is neither a grid nor a flex item, hence the
	 * absolute position in a plain block. No paint containment: the slots' underline runs below the last line.
	 */
	[data-buffer] {
		position: absolute;
		inset: 0;
		contain: size layout;
	}

	/*
	 * Built by the typist too: its spans carry no scoping attribute.
	 * The accent never carries text on the paper: it underlines the slot instead.
	 */
	.sentence :global([data-kind='slot']) {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 0.15em;
		text-underline-offset: 0.19em;
	}

	.sentence :global([data-kind='selected']) {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.sentence :global([data-kind='block']) {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.sentence :global([data-kind='bar']) {
		display: inline-block;
		width: 3px;
		height: 1.02em;
		margin: 0 -1.5px;
		vertical-align: -0.16em;
		background: var(--color-accent);
	}

	/*
	 * Always two lines: side by side, the audiences' lengths and the mono font's swap would wrap the
	 * line differently and move what follows.
	 */
	.version {
		display: flex;
		flex-direction: column;
		margin: 14px 0 0;
		padding-top: 8px;
		border-top: 1px solid var(--color-rule);
		font-size: 12px;
		line-height: 1.5;
		color: var(--color-ink-muted);
	}

	.version-number {
		color: var(--color-ink);
	}

	[data-audience][data-run='a'] {
		animation: audience-a 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	[data-audience][data-run='b'] {
		animation: audience-b 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	@keyframes audience-a {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	@keyframes audience-b {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	/*
	 * Screencast keys: a group pops in key by key, then fades as a whole. Out of the flow, in a corner the
	 * page picks: nothing moves.
	 */
	.keys {
		position: absolute;
		display: flex;
		align-items: flex-end;
		gap: 6px;
		transition: opacity 0.5s ease;
	}

	.keys[data-on='false'] {
		opacity: 0;
	}

	.keys :global(kbd) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		min-width: 32px;
		height: 34px;
		padding: 0 9px;
		border: 1px solid var(--color-ink);
		border-bottom-width: 3px;
		border-radius: 6px;
		background: var(--color-light);
		color: var(--color-ink);
		font: inherit;
		font-size: 15px;
		line-height: 1;
		animation: key-in 0.22s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.keys :global(kbd[data-wide]) {
		font-size: 12px;
		letter-spacing: 0.02em;
	}

	.keys :global(kbd:last-child) {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	@keyframes key-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.9);
		}
	}

	/* The typist never starts under reduced motion, but stopping it on a preference flip fades. */
	@media (prefers-reduced-motion: reduce) {
		[data-audience],
		.keys,
		.keys :global(kbd) {
			animation: none !important;
			transition: none;
		}
	}

	/* A phone shows the last keys only: ten would run into the scale bar. */
	@media (max-width: 600px) {
		.keys :global(kbd:nth-last-child(n + 6)) {
			display: none;
		}
	}
</style>
