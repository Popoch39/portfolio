---
import { stack } from '../data/profile';
import { logoHref } from './logo-sprite';

/*
 * The Atome's final state: the tower of bagues, drawn in DOM 3D (ADR 0004). Every length and angle is
 * computed here, at build time, from the profile's stack; the browser receives fixed transforms.
 * The drawing is orthographic (no perspective): depth only sorts the layers, it never resizes them.
 */

/** Radii and heights of the mockup's seven-bague tower, spread over however many categories there are. */
const BASE_RADIUS = 170;
const TOP_RADIUS = 38;
const BASE_HEIGHT = 170;
const TOP_HEIGHT = -178;
/** Tilt of every bague in the tower: the band reads as an ellipse half as tall as it is wide. */
const TILT = 60;
/**
 * Thickness of a bague, drawn by a single side layer under the band. Nothing fills the wall between the
 * two: any thicker, the bague reads as two thin open rings, edge-on in the atom as at the tower's tilt.
 */
const THICKNESS = 2;
/** How far the accent layers sit above their base ones, so the two never fight over depth. */
const ACCENT_RAISE = 0.5;
/**
 * Half the band's width (its stroke is twice this in the CSS). A pastille's 10px logo is printed on the
 * band, in its plane, so it stays inside it at every tilt, even at a box corner with the band shrunk to
 * 0.94 in the atom.
 */
const BAND_HALF = 7;
/** Room around the band and its 0.6px edges inside a bague's SVG box. */
const BAND_ROOM = BAND_HALF + 1;
/** How far a logo sits above its band, past the accent layer, so the two never fight over depth. */
const LOGO_RAISE = 1;
/**
 * How wide a ring a finger may land in and still mean the band, in the band's plane: the tilt halves it
 * on screen at the near and far sides. Two bands stand 22 apart, so two reaches barely meet.
 */
const FINGER_REACH = 36;
/** Label text starts this far right of the tower axis, past the widest bague and its leader line. */
const LABEL_OFFSET = BASE_RADIUS + 60;

/**
 * Per-rank values from the mockup, cycled when there are more bagues than rows: the final spin of the
 * bague in its own plane, the angle of its first pastille, and the scene's tilts. A tilt is the mockup's
 * Z · X · Z chain: `gyro` is the gyroscope pose, `nested` the laid-down atom pose, which then drifts
 * in its own plane up to `drift`.
 */
const RANKS = [
	{ spin: 405, firstPastille: 20, gyro: [20, 70, 140], nested: [0, 225], drift: 265 },
	{ spin: 225, firstPastille: 40, gyro: [80, -55, 210], nested: [60, 405], drift: 365 },
	{ spin: 45, firstPastille: 10, gyro: [140, 80, -60], nested: [120, -135], drift: -95 },
	{ spin: 585, firstPastille: 60, gyro: [-30, 40, 250], nested: [0, 405], drift: 445 },
	{ spin: 45, firstPastille: 30, gyro: [100, -75, 60], nested: [60, 225], drift: 185 },
	{ spin: 765, firstPastille: 0, gyro: [160, 60, 300], nested: [120, 585], drift: 625 },
	{ spin: -315, firstPastille: 45, gyro: [45, -35, 120], nested: [0, -135], drift: -175 },
];
/** Tilt of every bague once laid down in the atom: steeper than the tower's, so the nest reads as a sphere. */
const NESTED_TILT = 68;
/** In the atom, the bagues spread out to these radii: 4px between two bands, so none touches another. */
const NESTED_BASE_RADIUS = BASE_RADIUS - 10;
const NESTED_TOP_RADIUS = TOP_RADIUS + 14;
/** Where the target sits, then the gyroscope, below the tower axis. */
const TARGET_HEIGHT = 150;
const GYRO_HEIGHT = 40;
/** Each bague starts and ends its choreography a little after the one below it, over this share of the scene. */
const STAGGER = 0.03;

const round = (value: number) => +value.toFixed(2);
const px = (value: number) => `${round(value)}px`;
const steps = Math.max(stack.length - 1, 1);
const bagues = stack.map((group, rank) => {
	const share = rank / steps;
	const radius = BASE_RADIUS - (BASE_RADIUS - TOP_RADIUS) * share;
	const height = stack.length > 1 ? BASE_HEIGHT - (BASE_HEIGHT - TOP_HEIGHT) * share : 0;
	const { spin, firstPastille, gyro, nested, drift } = RANKS[rank % RANKS.length];
	const nestedRadius = NESTED_BASE_RADIUS - (NESTED_BASE_RADIUS - NESTED_TOP_RADIUS) * share;
	const logos = group.items.flatMap((tool) => {
		const href = logoHref(tool);
		return href === undefined ? [] : [{ tool, href }];
	});
	const pastilles = logos.map((logo, index) => ({ ...logo, angle: firstPastille + (360 / logos.length) * index }));
	/**
	 * The scene's poses, from the target to the tower: height, Z · X · Z tilt (the heading of the bague's
	 * axis, its tilt, then its spin in its own plane), radius as a scale of the tower's.
	 */
	const pose = (y: number, [heading, tilt, spin]: number[], scale: number) => ({
		y,
		heading,
		tilt,
		spin,
		scale: round(scale),
	});
	const choreography = {
		start: round(0.06 + STAGGER * share),
		end: round(0.8 + STAGGER * share),
		// The pastilles travel this far round their bague during the scene, the direction alternating from one bague to the next.
		travel: (rank % 2 ? 1 : -1) * (300 + 40 * rank),
		poses: [
			pose(TARGET_HEIGHT, [0, TILT, 45], 1),
			pose(GYRO_HEIGHT, gyro, (radius + nestedRadius) / 2 / radius),
			pose(0, [nested[0], NESTED_TILT, nested[1]], nestedRadius / radius),
			pose(0, [nested[0], NESTED_TILT, drift], nestedRadius / radius),
			pose(0, [0, TILT, spin], 1),
			pose(round(height), [0, TILT, spin], 1),
		],
		pastilles: pastilles.map(({ angle }) => {
			const radians = (angle * Math.PI) / 180;
			return [round(radius * Math.cos(radians)), round(radius * Math.sin(radians))];
		}),
	};
	return { ...group, radius, height, spin, box: 2 * (radius + BAND_ROOM), pastilles, choreography };
});

const halfWidth = BASE_RADIUS + BAND_HALF + 1;
const above = Math.max(...bagues.map((b) => -b.height + b.radius / 2)) + BAND_HALF + 8;
const below = Math.max(...bagues.map((b) => b.height + b.radius / 2)) + BAND_HALF + THICKNESS + 4;
/**
 * How far the drawing reaches around the axis before the tower rises (target, gyroscope, atom, drift):
 * the scene enlarges that much in the middle of the frame. A bague tilted by X then turned by Z projects
 * its circle to an ellipse whose half-extents follow from those two angles; its spin doesn't change them.
 */
const INTRO_POSES = 4;
const degrees = (angle: number) => (angle * Math.PI) / 180;
const introPoses = bagues.flatMap((bague) =>
	bague.choreography.poses.slice(0, INTRO_POSES).map(({ y, heading, tilt, scale }) => {
		const [h, t] = [degrees(heading), degrees(tilt)];
		const radius = (bague.radius + BAND_HALF) * scale;
		return {
			y,
			across: radius * Math.hypot(Math.cos(h), Math.cos(t) * Math.sin(h)),
			down: radius * Math.hypot(Math.sin(h), Math.cos(t) * Math.cos(h)),
		};
	}),
);
const introAbove = Math.max(...introPoses.map(({ y, down }) => down - y));
const introBelow = Math.max(...introPoses.map(({ y, down }) => y + down)) + THICKNESS;
const introAcross = Math.max(...introPoses.map(({ across }) => across));
const frame = [
	`--tower-width: ${2 * halfWidth}px`,
	`--tower-height: ${above + below}px`,
	`--intro-above: ${round(introAbove)}px`,
	`--intro-below: ${round(introBelow)}px`,
	`--intro-across: ${round(introAcross)}px`,
	`--axis-x: ${halfWidth}px`,
	`--axis-y: ${above}px`,
	`--label-x: ${halfWidth + LABEL_OFFSET}px`,
].join('; ');
---

<div class="atome" style={frame} data-atome>
	<div class="atome-tower" aria-hidden="true">
		<div class="atome-drawing">
			{/* Only the scene shows it, while the bagues form the atom around it. */}
			<span class="atome-nucleus"></span>
			{
				bagues.map((bague, rank) => {
					const centre = bague.box / 2;
					const reach = bague.radius + FINGER_REACH / 2;
					/** The band (`side: false`) or the thickness under it, in ink or as the accent laid over it. */
					const layer = ({ side, accent }: { side: boolean; accent: boolean }) => (
						<svg
							class={`bague-layer bague-${side ? 'side' : 'top'}${accent ? '-accent' : ''}`}
							width={bague.box}
							height={bague.box}
							viewBox={`0 0 ${bague.box} ${bague.box}`}
							style={`left: ${px(-centre)}; top: ${px(-centre)}; transform: translateZ(${(side ? -THICKNESS : 0) + (accent ? ACCENT_RAISE : 0)}px)`}
						>
							{side ? (
								<>
									<circle class="bague-side-band" cx={centre} cy={centre} r={bague.radius} />
									{/* What an aimed bague shows over its base bands (`src/atome/aim.ts`): the accent, in a circle of its own. */}
									{!accent && <circle class="bague-aim" cx={centre} cy={centre} r={bague.radius} />}
								</>
							) : (
								<>
									<circle class="bague-band" cx={centre} cy={centre} r={bague.radius} />
									{!accent && <circle class="bague-aim" cx={centre} cy={centre} r={bague.radius} />}
									<circle class="bague-ticks" cx={centre} cy={centre} r={bague.radius} pathLength="360" />
								</>
							)}
							<circle class="bague-edge" cx={centre} cy={centre} r={bague.radius + BAND_HALF} />
							<circle class="bague-edge" cx={centre} cy={centre} r={bague.radius - BAND_HALF} />
						</svg>
					);
					// The seat lifts an aimed bague: an element of its own, so the lift never meets the transform the scene writes on the bague.
					return (
						<div class="bague-seat" data-bague={rank}>
							<div
								class="bague"
								style={`transform: translate3d(0, ${px(bague.height)}, 0) rotateX(${TILT}deg)`}
								data-choreography={JSON.stringify(bague.choreography)}
							>
								{layer({ side: true, accent: false })}
								{layer({ side: false, accent: false })}
								{/* The accent is a layer laid over the base one, so the scene can light it with opacity alone. */}
								{layer({ side: true, accent: true })}
								{layer({ side: false, accent: true })}
								{/* A finger's reach around the band, never drawn. In a box of its own: nothing is aimed at outside its SVG's box. */}
								<svg
									class="bague-reach"
									width={2 * reach}
									height={2 * reach}
									viewBox={`0 0 ${2 * reach} ${2 * reach}`}
									style={`left: ${px(-reach)}; top: ${px(-reach)}`}
								>
									<circle cx={reach} cy={reach} r={bague.radius} stroke-width={FINGER_REACH} />
								</svg>
								<div class="bague-plane" style={`transform: rotate(${bague.spin}deg)`}>
									{/* Carries the pastilles round the bague during the scene, on top of the bague's own spin. */}
									<div class="bague-track">
										{bague.pastilles.map((pastille) => (
											<div
												class="pastille-slot"
												style={`transform: rotate(${pastille.angle}deg) translateX(${px(bague.radius)})`}
												data-tool={pastille.tool}
											>
												{/* A finger's reach around the logo, never drawn, laid over the band's: landing there means the tool. */}
												<span class="pastille-reach" style={`transform: translateZ(${LOGO_RAISE}px)`} />
												{/* Printed on the band, its top pointing out of the ring. */}
												<div class="pastille" style={`transform: rotate(90deg) translateZ(${LOGO_RAISE}px)`}>
													<svg class="pastille-logo" viewBox="0 0 24 24">
														<use href={pastille.href} />
													</svg>
												</div>
											</div>
										))}
									</div>
								</div>
							</div>
						</div>
					);
				})
			}
		</div>
	</div>
	<dl class="atome-labels">
		{
			// Each label is a stop of its own for the keyboard: focused, it aims at its bague.
			bagues.map((bague, rank) => (
				<div
					class:list={['atome-label', { 'atome-label--accent': bague.accent }]}
					style={`--label-y: ${px(bague.height)}; --leader: ${px(BASE_RADIUS + 40 - bague.radius)}`}
					data-bague={rank}
					tabindex="0"
				>
					<dt class="mono atome-category">{bague.category}</dt>
					<dd class="atome-tools-cell">
						<ul class="atome-tools">
							{bague.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</dd>
				</div>
			))
		}
	</dl>
</div>

<script>
	import {
		cubicBezier,
		gsap,
		readTransforms,
		registerScene,
		SCENE_SCRUB,
		ScrollSmoother,
		ScrollTrigger,
	} from '../animation/base';

	type Pose = { y: number; heading: number; tilt: number; spin: number; scale: number };
	type Choreography = {
		start: number;
		end: number;
		travel: number;
		poses: Pose[];
		pastilles: [number, number][];
	};

	/** Where each pose sits in a bague's own stretch of the scene: target, gyroscope, atom, drift, flat, tower. */
	const POSE_AT = [0, 0.28, 0.58, 0.7, 0.85, 1];
	/** The ease from each pose to the next, for the tilt and the height, then for the radius. */
	const TURN_EASES = [
		cubicBezier(0.55, 0, 0.4, 1),
		cubicBezier(0.35, 0, 0.15, 1),
		'none',
		cubicBezier(0.6, 0, 0.3, 1),
		cubicBezier(0.5, 0, 0.2, 1),
	];
	const RADIUS_OUT = cubicBezier(0.5, 0, 0.25, 1);
	const RADIUS_EASES = [RADIUS_OUT, RADIUS_OUT, 'none', cubicBezier(0.6, 0, 0.3, 1), 'none'];
	const LABEL_EASE = cubicBezier(0.2, 0.7, 0.2, 1);
	const NUCLEUS_EASE = cubicBezier(0.3, 1.6, 0.5, 1);
	/** When the pastilles start going round their bague. */
	const TRAVEL_START = 0.04;
	/** When the enlarged drawing starts sliding back to its place, as the first bagues rise, and when it is there with the labels. */
	const INTRO_LEAVE = 0.66;
	const INTRO_END = 0.84;
	/**
	 * Once the tower is finished, the scroll lights its bagues one by one from the base, each for FOCUS_STEP,
	 * the others dimmed to DIMMED; then they all come back, and the tower holds still once more.
	 */
	const FOCUS_START = 1;
	const FOCUS_STEP = 0.07;
	const FOCUS_FADE = 0.025;
	const FOCUS_HOLD = 0.05;
	const DIMMED = 0.2;
	/**
	 * Where the labels sit under the tower rather than beside it (the CSS's portrait layout): during the
	 * scene they share one row, only the lit bague's showing, so the list leaves the frame's height to the tower.
	 */
	const LABELS_BELOW = matchMedia('(orientation: portrait), (max-width: 639px), (max-height: 500px)');
	/**
	 * A phone on its side: under the title, the frame would leave the tower a quarter of the window.
	 * The frame starts at the Atome instead, and the title scrolls out above it.
	 */
	const LOW_WINDOW = matchMedia('(orientation: landscape) and (max-height: 500px)');
	/** How far the page scrolls, in screens, for the length of the building phase (0 to 1 on the timeline). */
	const BUILD_SCREENS = 4;
	/** Every element whose transform the scene moves. */
	const MOVED =
		'.atome-tower, [data-choreography], .bague-plane, .bague-layer, .bague-track, .pastille-slot, .atome-label, .atome-nucleus';
	/** Every element whose opacity the scene moves. */
	const FADED =
		'.atome-label, .atome-nucleus, .bague-side, .bague-top, .bague-side-accent, .bague-top-accent, .pastille-logo';

	/** Breathing room kept above the pinned frame. */
	const ROOM = 24;

	/**
	 * Fits the pinned frame to the screen: the tower takes the largest scale at which it fits the height
	 * left under the title (or without it, in a low window) and above the statusline, without going past the width-fitting scale set in CSS. The label
	 * text keeps its size. Returns how far into the section the pin starts. Reads layout, so it only runs
	 * at setup and on refresh, never on a frame.
	 */
	function fitToScreen(section: HTMLElement, atome: HTMLElement) {
		atome.style.removeProperty('--tower-scale');
		const style = getComputedStyle(atome);
		const towerHeight = Number.parseFloat(style.getPropertyValue('--tower-height'));
		// Under the tower, the labels leave it the whole column: the CSS scale, set for the list beside it
		// or below it in full, gives way to the column's width, up to the drawing's own size.
		const cssScale = Number.parseFloat(style.getPropertyValue('--tower-scale'));
		const columnScale = atome.clientWidth / Number.parseFloat(style.getPropertyValue('--tower-width'));
		const widthScale = LABELS_BELOW.matches ? Math.max(cssScale, Math.min(1, columnScale)) : cssScale;
		const frame =
			innerHeight - (Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingBottom) || 0);
		const padding = Number.parseFloat(getComputedStyle(section).paddingTop) || 0;
		const sectionTop = section.getBoundingClientRect().top;
		const { top, bottom } = atome.getBoundingClientRect();
		// What follows the Atome in the frame, down to the element the page marks as its end (the note on
		// the editor); nothing when none is marked.
		const frameEnd = section.querySelector('[data-atome-frame-end]') ?? atome;
		const note = Math.max(0, frameEnd.getBoundingClientRect().bottom - bottom);
		// What does not scale: the title above the Atome, the list below the tower in portrait, the note.
		// The frame starts ROOM above the title, which stays in it for the whole scene; in a low window,
		// ROOM above the Atome.
		const frameTop = LOW_WINDOW.matches ? top - sectionTop : padding;
		const title = top - sectionTop - frameTop;
		const list = bottom - top - towerHeight * cssScale;

		const scale = Math.min(widthScale, (frame - 2 * ROOM - title - list - note) / towerHeight);
		atome.style.setProperty('--tower-scale', `${+scale.toFixed(3)}`);
		return frameTop - ROOM;
	}

	/**
	 * The largest the drawing is drawn in the middle of the frame before the tower rises, against its
	 * size at scale 1: an absolute bound, so a phone's small tower may still open across the screen.
	 */
	const INTRO_MAX_SCALE = 2;
	/** Share of the Atome's width the enlarged drawing may take. */
	const INTRO_WIDTH_SHARE = 0.9;

	/**
	 * Where the tower box sits while the bagues swing, before the tower rises and the labels come in: the
	 * axis, where the atom forms round its nucleus, is put at the centre of the room under the title (above
	 * the statusline), and the drawing is enlarged as far as every early pose still fits around it. The box
	 * scales from its top left corner. Reads layout, so it only runs at setup and refresh.
	 */
	function introFrame(section: HTMLElement, atome: HTMLElement, tower: HTMLElement, pinOffset: number) {
		const style = getComputedStyle(atome);
		const length = (name: string) => Number.parseFloat(style.getPropertyValue(name));
		const scale = length('--tower-scale');
		const [above, below, across] = ['--intro-above', '--intro-below', '--intro-across'].map(length);
		const [axisX, axisY] = [length('--axis-x') * scale, length('--axis-y') * scale];
		const root = document.documentElement;
		const frame = innerHeight - (Number.parseFloat(getComputedStyle(root).scrollPaddingBottom) || 0);
		const atomeBox = atome.getBoundingClientRect();
		// The page column is centred, so its middle is the screen's. Read from the column, not the page:
		// on a phone, a page made wider for a moment widens the layout viewport, and a drawing centred on
		// that width would keep it wide.
		// Where the Atome's top stands on screen while pinned: the pin holds the section's top pinOffset
		// above the top of the window. The drawing centres in the room between the title and the note
		// that closes the frame, so it never runs over either.
		const sectionTop = section.getBoundingClientRect().top;
		const atomeTop = atomeBox.top - sectionTop - pinOffset;
		const frameEnd = section.querySelector('[data-atome-frame-end]');
		const roomBottom = frameEnd ? Math.min(frame, frameEnd.getBoundingClientRect().top - sectionTop - pinOffset) : frame;
		const [centreX, centreY] = [atomeBox.left + atome.clientWidth / 2, (atomeTop + roomBottom) / 2];
		const boxLeft = atomeBox.left + tower.offsetLeft;
		const boxTop = atomeTop + tower.offsetTop;
		const grow = Math.max(
			1,
			Math.min(
				INTRO_MAX_SCALE / scale,
				(roomBottom - atomeTop) / 2 / (Math.max(above, below) * scale),
				(atome.clientWidth * INTRO_WIDTH_SHARE) / (2 * across * scale),
			),
		);
		return {
			scale: grow,
			x: centreX - boxLeft - axisX * grow,
			y: centreY - boxTop - axisY * grow,
		};
	}

	registerScene(() => {
		const atome = document.querySelector<HTMLElement>('[data-atome]');
		const section = atome?.closest('section');
		if (!atome || !section) return;

		const tower = atome.querySelector<HTMLElement>('.atome-tower')!;
		// Before the screen fit measures, so a list stacked under the tower counts for a single row.
		// `playing` until the tower stands finished: it answers nobody meanwhile (`src/atome/aim.ts`).
		atome.dataset.atomeScene = 'playing';
		// The scene reads all it needs before it writes anything, and pins its section last: every read
		// that follows a write makes the browser compute the styles again, those of the whole section once
		// the pin has moved it into its spacer. First, the transform of every element it moves.
		readTransforms(atome.querySelectorAll(MOVED));
		// Then the opacity of every element it fades, written back as is: a tween reads it from the
		// element's own style from then on, never from the computed one.
		gsap.set(atome.querySelectorAll(FADED), {
			opacity: (_: number, element: Element) => Number(gsap.getProperty(element, 'opacity')),
		});
		// Before every refresh measures the pin, so the section has its fitted height by then.
		let pinOffset = fitToScreen(section, atome);
		let intro = introFrame(section, atome, tower, pinOffset);
		/**
		 * A refresh never invalidates the whole scene: undoing its 200 tweens and starting them again,
		 * element by element, freezes a phone for a quarter of a second. Only what the screen decides is
		 * taken again: the opening frame, and the labels' levels once the list has moved under the tower
		 * or back beside it. The other tweens keep the values they were built with.
		 */
		let labelsBelow = LABELS_BELOW.matches;
		const byLayout: gsap.core.Animation[] = [];
		let reframe = false;
		const refit = () => {
			pinOffset = fitToScreen(section, atome);
			const { x, y, scale } = intro;
			intro = introFrame(section, atome, tower, pinOffset);
			reframe ||= intro.x !== x || intro.y !== y || intro.scale !== scale;
			// Before the refresh brings the scene back to where it stood: on its way, it starts them again.
			if (LABELS_BELOW.matches !== labelsBelow) {
				labelsBelow = LABELS_BELOW.matches;
				for (const tween of byLayout) tween.invalidate();
			}
		};
		ScrollTrigger.addEventListener('refreshInit', refit);

		// Their own layers, for as long as the scene runs: under the smoother the pin moves the section
		// with a 2D transform, and the 3D drawing changes inside it at every frame. Left in the page's
		// layer, both repaint and re-raster the section at every frame. Out of the scene, once it has
		// caught up with the scroll, they give their layers back.
		let promoted = false;
		const promote = (promote: boolean) => {
			if (promote === promoted) return;
			promoted = promote;
			for (const element of [section, tower]) element.style.willChange = promote ? 'transform' : '';
		};

		const bagues = atome.querySelectorAll<HTMLElement>('[data-choreography]');
		const focusEnd = FOCUS_START + bagues.length * FOCUS_STEP + FOCUS_FADE;
		const sceneLength = focusEnd + FOCUS_HOLD;

		// One timeline over the whole pin: the tower is built from 0 to 1 in "seconds", then its bagues are lit
		// in turn. Its ScrollTrigger comes once it is complete.
		const scene = gsap.timeline({ defaults: { ease: 'none' }, paused: true });
		/** The tween the scene has just been given. */
		const lastTween = () => {
			const tween = scene.recent();
			if (!(tween instanceof gsap.core.Tween)) throw new Error('Atome: the scene was given no tween');
			return tween;
		};

		const choreographies = [...bagues].map((bague): Choreography => JSON.parse(bague.dataset.choreography!));
		const labels = atome.querySelectorAll('.atome-label');
		// Function-based, so a refresh after the phone turns takes the other layout's levels (`refit`).
		const labelLevel = () => (LABELS_BELOW.matches ? 0 : 1);
		const labelDimmed = () => (LABELS_BELOW.matches ? 0 : DIMMED);
		for (const [rank, { end }] of choreographies.entries()) {
			// Its label comes in as the bague takes its place in the tower; stacked under it, it waits for its bague to be lit.
			scene.fromTo(
				labels[rank],
				{ opacity: 0, x: -14 },
				{ opacity: () => labelLevel(), x: 0, ease: LABEL_EASE, duration: 0.06 },
				end - 0.03,
			);
			byLayout.push(lastTween());
		}
		const nucleus = atome.querySelector('.atome-nucleus');
		scene.fromTo(nucleus, { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, ease: NUCLEUS_EASE, duration: 0.065 }, 0.44);
		scene.fromTo(
			nucleus,
			{ opacity: 1, scale: 1 },
			{ opacity: 0, scale: 0, duration: 0.065, immediateRender: false },
			0.635,
		);

		for (const [rank, bague] of bagues.entries()) {
			const { start, end, travel, poses, pastilles } = choreographies[rank];
			const plane = bague.querySelector('.bague-plane');
			const layers = bague.querySelectorAll('.bague-layer');
			const slots = bague.querySelectorAll('.pastille-slot');

			// The bague's tilt (Z, X) then its spin (Z). The pastilles are printed on the band, so they follow
			// it; a slot only moves with the radius, keeping the rotation the HTML gives it.
			const shape = {
				bague: ({ y, heading, tilt }: Pose) => ({ y, rotation: heading, rotationX: tilt }),
				plane: ({ spin }: Pose) => ({ rotation: spin }),
				layer: ({ scale }: Pose) => ({ scale }),
				slot: ({ scale }: Pose) => ({
					x: (index: number) => pastilles[index][0] * scale,
					y: (index: number) => pastilles[index][1] * scale,
				}),
			};
			/** What each pose moves: the elements, the values they take from the pose, and the eases between poses. */
			const channels = [
				[bague, shape.bague, TURN_EASES],
				[plane, shape.plane, TURN_EASES],
				[layers, shape.layer, RADIUS_EASES],
				[slots, shape.slot, RADIUS_EASES],
			] as const;

			const at = (share: number) => start + (end - start) * share;
			for (const [targets, values, eases] of channels) {
				for (let index = 0; index < poses.length - 1; index++) {
					const from = values(poses[index]);
					const to = values(poses[index + 1]);
					scene.fromTo(
						targets,
						from,
						{
							...to,
							ease: eases[index],
							duration: at(POSE_AT[index + 1]) - at(POSE_AT[index]),
							// Only the first pose is laid down up front; the later ones wait for their turn.
							immediateRender: index === 0,
						},
						at(POSE_AT[index]),
					);
				}
			}

			// The pastilles go round only as the page scrolls, ending where the HTML draws them as their bague
			// settles in the tower: the hold at the end of the scene stays still. The ease lets them come to
			// rest with the bague rather than stop dead.
			const settle = { ease: 'sine.inOut', duration: end - TRAVEL_START };
			scene.fromTo(bague.querySelector('.bague-track'), { rotation: -travel }, { rotation: 0, ...settle }, TRAVEL_START);
		}

		// Enlarged in the middle while the bagues swing; as the tower rises and the labels come in, the
		// drawing slides back to its place in the tower's box, the labels to its right.
		scene.fromTo(
			tower,
			{ x: () => intro.x, y: () => intro.y, scale: () => intro.scale },
			{ x: 0, y: 0, scale: 1, ease: 'power2.inOut', duration: INTRO_END - INTRO_LEAVE },
			INTRO_LEAVE,
		);
		const opening = lastTween();
		// Once the refresh has brought the scene back to where it stood, the opening frame is taken again
		// and laid down at the scene's time: before the tween starts, the refresh plays nothing on it.
		const applyFrame = () => {
			if (!reframe) return;
			reframe = false;
			const time = gsap.utils.clamp(0, opening.duration(), scene.time() - opening.startTime());
			opening.invalidate().render(time, true, true);
		};
		ScrollTrigger.addEventListener('refresh', applyFrame);

		// The bagues lit one by one: the lit one takes the accent, the others dim. The dimming goes on the
		// layers and logos, never on the bague: an opacity below 1 on an element that preserves 3D flattens
		// it, and its pastilles would cut the band. The accent is a layer laid over the bague: only its
		// opacity moves, never a colour.
		const parts = [...bagues].map((bague) => [...bague.querySelectorAll('.bague-side, .bague-top, .pastille-logo')]);
		const accents = [...bagues].map((bague) => [...bague.querySelectorAll('.bague-side-accent, .bague-top-accent')]);
		const others = <T,>(list: T[], rank: number) => list.filter((_, other) => other !== rank);
		type Level = number | (() => number);
		const fade = (targets: Element | Element[], from: Level, to: Level, at: number) => {
			scene.fromTo(targets, { opacity: from }, { opacity: to, duration: FOCUS_FADE, immediateRender: false }, at);
			if (typeof from === 'function' || typeof to === 'function') byLayout.push(lastTween());
		};
		const last = parts.length - 1;
		const labelList = [...labels];
		fade(others(parts, 0).flat(), 1, DIMMED, FOCUS_START);
		fade(others(labelList, 0), labelLevel, labelDimmed, FOCUS_START);
		fade(labelList[0], labelLevel, 1, FOCUS_START);
		fade(accents[0], 0, 1, FOCUS_START);
		for (let rank = 1; rank <= last; rank++) {
			const at = FOCUS_START + rank * FOCUS_STEP;
			fade(parts[rank - 1], 1, DIMMED, at);
			fade(labelList[rank - 1], 1, labelDimmed, at);
			fade(accents[rank - 1], 1, 0, at);
			fade(parts[rank], DIMMED, 1, at);
			fade(labelList[rank], labelDimmed, 1, at);
			fade(accents[rank], 0, 1, at);
		}
		// The whole tower comes back. Under it, the last label stays: the row never ends empty.
		fade(others(parts, last).flat(), DIMMED, 1, focusEnd - FOCUS_FADE);
		fade(others(labelList, last), labelDimmed, labelLevel, focusEnd - FOCUS_FADE);
		fade(accents[last], 1, 0, focusEnd - FOCUS_FADE);

		// A hold on the finished tower before the page moves on: nothing moves past this point.
		scene.set({}, {}, sceneLength);

		const span = {
			trigger: section,
			start: () => `top+=${pinOffset} top`,
			// The building phase is as long as the Frise's pin, so it doesn't rush past before its phases can
			// be read; the bagues lit in turn come on top, at the same pace.
			end: `+=${Math.round(BUILD_SCREENS * 100 * sceneLength)}%`,
		};
		// The pin and the scene over the same span, but apart: at every refresh, ScrollTrigger plays the
		// animation of a pin to its end and back, to see whether it moves the pin, which started all 200
		// tweens of the scene at once. Apart, a tween starts when the scroll first reaches it.
		ScrollTrigger.create({
			...span,
			pin: true,
			// Under a finger the page scrolls natively, off the main thread: the pin is set a frame early.
			anticipatePin: 1,
			// Empty: with a timeline, ScrollTrigger waits for the page's refresh to measure the pin, instead
			// of measuring it, and every other pin with it, as it is created.
			animation: gsap.timeline(),
		});
		// The tower stands once the scroll is past the scene's end and the scene has caught up with it:
		// only then does it answer whoever aims at a bague. Two numbers compared, nothing read from the page,
		// and the mark only written when it changes.
		let stands = false;
		const report = ({ progress }: ScrollTrigger) => {
			if (stands === (progress === 1 && scene.progress() === 1)) return;
			stands = !stands;
			atome.dataset.atomeScene = stands ? '' : 'playing';
		};
		const played = ScrollTrigger.create({
			...span,
			animation: scene,
			scrub: SCENE_SCRUB,
			// Not `onToggle`: ScrollTrigger runs it inside the scene's context, and when the preference flips
			// mid-scene, Firefox then leaves the bagues where they stood instead of reverting them.
			onUpdate: (self) => {
				if (self.isActive) promote(true);
				report(self);
			},
			onScrubComplete: (self) => {
				if (!self.isActive) promote(false);
				report(self);
			},
			// A page opened or resized past the scene is brought to its end without a scrub.
			onRefresh: report,
		});

		// The keyboard reaching a label before the tower stands would focus a label not drawn yet: the page
		// goes to the scene's end. Not for a click or a tap, which focus the label too. A frame later, once
		// the base has brought the focused element into view, and only if the focus has not moved on.
		let reaching = 0;
		const reach = ({ target }: FocusEvent) => {
			if (played.progress === 1) return;
			if (!(target instanceof Element) || !target.matches('.atome-label:focus-visible')) return;
			cancelAnimationFrame(reaching);
			reaching = requestAnimationFrame(() => {
				if (document.activeElement !== target) return;
				const smoother = ScrollSmoother.get();
				if (smoother) smoother.scrollTo(played.end, false);
				else scrollTo(0, played.end);
			});
		};
		atome.addEventListener('focusin', reach);

		return () => {
			ScrollTrigger.removeEventListener('refreshInit', refit);
			ScrollTrigger.removeEventListener('refresh', applyFrame);
			atome.removeEventListener('focusin', reach);
			cancelAnimationFrame(reaching);
			promote(false);
			atome.style.removeProperty('--tower-scale');
			delete atome.dataset.atomeScene;
		};
	});
</script>

<style>
	.atome {
		--tower-scale: 1;
		/* The drawing's shades, from the theme: the lit band and the thickness under it. */
		--band: color-mix(in oklab, var(--color-paper) 30%, var(--color-light));
		--side: color-mix(in oklab, var(--color-rule) 75%, var(--color-ink-faint));
		position: relative;
		height: calc(var(--tower-height) * var(--tower-scale));
		margin-top: clamp(32px, 4vw, 56px);
		/*
		 * The enlarged opening drawing never widens the page: while a refresh measures, the tower can hold
		 * its opening transform at another scale, and on a phone a page wider than the screen zooms the
		 * layout viewport out, so every pin would be measured against a taller screen.
		 */
		overflow-x: clip;
	}

	/* The tower's box follows its scale, so the page around it is laid out for the scaled drawing. */
	.atome-tower {
		position: absolute;
		top: 0;
		left: 0;
		width: calc(var(--tower-width) * var(--tower-scale));
		height: calc(var(--tower-height) * var(--tower-scale));
		/* The scene enlarges and centres it from this corner before the tower rises. */
		transform-origin: 0 0;
		/* Chromium counts the unscaled boxes of the 3D layers as scrollable overflow; the scaled drawing fits the box. */
		overflow: clip;
	}

	/* The tower axis: every bague, pastille and leader line is placed from this point. */
	.atome-drawing,
	.bague-seat,
	.bague,
	.bague-plane,
	.bague-track,
	.pastille-slot,
	.pastille {
		position: absolute;
		top: 0;
		left: 0;
		width: 0;
		height: 0;
		transform-style: preserve-3d;
	}

	.atome-drawing {
		top: calc(var(--axis-y) * var(--tower-scale));
		left: calc(var(--axis-x) * var(--tower-scale));
		transform: scale(var(--tower-scale));
	}

	.atome-nucleus {
		position: absolute;
		top: -15px;
		left: -15px;
		box-sizing: border-box;
		width: 30px;
		height: 30px;
		border: 0.6px solid var(--color-accent-deep);
		border-radius: 50%;
		background: radial-gradient(
			circle at 34% 30%,
			color-mix(in srgb, var(--color-accent) 24%, var(--color-light)) 0,
			color-mix(in srgb, var(--color-accent) 77%, var(--color-light)) 30%,
			var(--color-accent) 58%,
			var(--color-accent-deep) 100%
		);
		opacity: 0;
	}

	.atome-nucleus::after {
		content: '';
		position: absolute;
		inset: -10px;
		border: 0.6px solid color-mix(in srgb, var(--color-accent) 52%, var(--color-light));
		border-radius: 50%;
	}

	/* A layer's box covers the whole inside of its ring, over the bagues below: a pointer only aims at what is drawn. */
	.bague-layer {
		position: absolute;
		overflow: visible;
		pointer-events: none;
	}

	.bague-layer circle {
		fill: none;
		pointer-events: stroke;
	}

	/*
	 * An aimed bague (`src/atome/aim.ts`) lifts a notch on its seat and takes the accent: circles of
	 * their own over the base bands, under the ticks and the edges, so the answer never touches what
	 * the scene fades.
	 */
	.bague-seat[data-aimed] {
		transform: translateY(-8px);
	}

	.bague-aim {
		stroke-width: 14;
		opacity: 0;
	}

	.bague-top .bague-aim {
		stroke: var(--color-accent);
	}

	.bague-side .bague-aim {
		stroke: var(--color-accent-deep);
	}

	.bague-seat[data-aimed] .bague-aim {
		opacity: 1;
	}

	/* Reduced motion: the bague answers in one step. */
	@media (prefers-reduced-motion: no-preference) {
		.bague-seat {
			transition: transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1);
		}

		.bague-aim {
			transition: opacity 0.24s ease-out;
		}
	}

	/* A band is a dozen pixels wide on a phone, too thin for a finger, which gets this ring around it. */
	.bague-reach,
	.pastille-reach {
		display: none;
	}

	@media (pointer: coarse) {
		.bague-reach {
			display: block;
			position: absolute;
			fill: none;
			pointer-events: none;
		}

		.bague-reach circle {
			pointer-events: stroke;
		}

		/* A logo is a few pixels wide there: a disc as wide as the band's reach, in the band's plane. */
		.pastille-reach {
			display: block;
			position: absolute;
			top: -18px;
			left: -18px;
			width: 36px;
			height: 36px;
			border-radius: 50%;
		}
	}

	.bague-band {
		stroke: var(--band);
		stroke-width: 14;
	}

	.bague-side-band {
		stroke: var(--side);
		stroke-width: 14;
	}

	.bague-ticks {
		stroke: var(--color-ink);
		stroke-width: 2.5;
		stroke-dasharray: 0.12 4.88;
		opacity: 0.4;
	}

	.bague-edge {
		stroke: var(--color-ink);
		stroke-width: 0.6;
	}

	/* Only lit by the scene, one bague at a time: the finished tower carries no accent. */
	.bague-top-accent,
	.bague-side-accent {
		opacity: 0;
	}

	.bague-top-accent .bague-band {
		stroke: var(--color-accent);
	}

	.bague-side-accent .bague-side-band {
		stroke: var(--color-accent-deep);
	}

	/* Sized like its logo: Chromium clips a flat element in a 3D context to its own box. */
	.pastille {
		top: -5px;
		left: -5px;
		width: 10px;
		height: 10px;
		transform-style: flat;
	}

	/* The logo alone, printed on the band: no disc behind it. */
	.pastille-logo {
		position: absolute;
		top: 0;
		left: 0;
		width: 10px;
		height: 10px;
		fill: var(--color-ink);
		/* Without it, Chromium repaints every pastille at every frame of the scene, as its bague turns. */
		contain: paint;
	}

	/*
	 * Labels: one per bague, beside its height in the tower, its leader line running back to the band.
	 * The list itself has no box: laid over the Atome, it would stand between the pointer and the bagues.
	 */
	.atome-labels {
		margin: 0;
	}

	/* Placed in the Atome's box and linked to the scaled tower; the text itself never scales. */
	.atome-label {
		--leader-scaled: calc(var(--leader) * var(--tower-scale));
		position: absolute;
		top: calc((var(--axis-y) + var(--label-y)) * var(--tower-scale));
		left: calc(var(--label-x) * var(--tower-scale));
		right: 0;
		/* A zero-height row centres its text on the bague's height, whatever the number of lines. */
		display: flex;
		flex-direction: column;
		justify-content: center;
		height: 0;
	}

	.atome-label::before {
		content: '';
		position: absolute;
		top: 0;
		left: calc(-12px - var(--leader-scaled));
		width: var(--leader-scaled);
		height: 0.6px;
		background: var(--color-ink);
	}

	.atome-label::after {
		content: '';
		position: absolute;
		top: -1.2px;
		left: calc(-13.5px - var(--leader-scaled));
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-ink);
	}

	.atome-category {
		font-size: 12px;
		line-height: 16px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-muted);
	}

	/* The accent never carries text on the paper: the specialty stands out in full ink. */
	.atome-label--accent .atome-category {
		color: var(--color-ink);
	}

	/* The label of an aimed bague answers in full ink too, its leader line in the accent. */
	.atome-label[data-aimed] .atome-category {
		color: var(--color-ink);
	}

	.atome-label[data-aimed]::before,
	.atome-label[data-aimed]::after {
		background: var(--color-accent);
	}

	/* Beside the tower a label is a row of no height, whose outline would be a line: its category carries the ring. */
	.atome-label:focus-visible {
		outline: none;
	}

	.atome-label:focus-visible .atome-category {
		outline: 2px solid var(--color-ink);
		outline-offset: 3px;
	}

	.atome-tools-cell {
		margin: 0;
	}

	.atome-tools {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 16px;
		line-height: 22px;
		letter-spacing: -0.005em;
	}

	.atome-tools li {
		display: inline;
	}

	/* The separator is drawn, not read: the empty alternative text keeps it out of the accessible name. */
	.atome-tools li:not(:last-child)::after {
		content: ' / ';
		content: ' / ' / '';
		color: var(--color-ink-faint);
	}

	/* A wide screen: the tower grows, as far as the scene's screen fit lets it in the height. */
	@media (min-width: 1200px) {
		.atome {
			--tower-scale: 1.3;
		}
	}

	/* A low window: the labels sit closer together beside the scaled tower, so their lines tighten. */
	@media (max-height: 560px) {
		.atome-category {
			line-height: 14px;
		}

		.atome-tools {
			font-size: 14px;
			line-height: 18px;
		}
	}

	/*
	 * Portrait, too narrow for the labels beside the tower, or too low (a phone on its side: fitted to the
	 * frame, the tower would bring the labels closer than their own height): the tower is centred on top
