		.atome[data-atome-scene] .atome-label[data-aimed] {
			opacity: 1 !important;
		}

		.atome-category,
		.atome-tools-cell,
		.atome-tools {
			display: inline;
		}

		.atome-category {
			margin-right: 10px;
			line-height: 20px;
		}

		.atome-tools {
			font-size: 14px;
			line-height: 20px;
		}
	}

	/* A phone in portrait: the tower is about 300px wide, and narrower still when the column is. */
	@media (max-width: 599px) {
		.atome {
