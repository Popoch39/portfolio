---
import LanguageSwitch from './LanguageSwitch.astro';
import { identity, sectionKeys, sections, type SectionKey } from '../data/profile';
import { home, localeOf, pathOf, type Page } from '../lib/i18n';

interface Props {
	/** La page affichée : l'accueil, ou une fiche dont le sélecteur de langue mène à l'autre version. */
	page: Page;
	/** Section de l'accueil dont relève la page (une fiche relève de « projects »). */
	current?: SectionKey;
}

const { page, current } = Astro.props;
const locale = localeOf(Astro.currentLocale);
// Les sections sont des ancres de l'accueil : depuis une autre page, les liens y retournent.
const homePath = pathOf(home, locale);
const onHome = page.kind === 'home';
const homeHref = onHome ? '' : homePath;
---

<header class="site-header">
	<a class="name" href={onHome ? '#top' : homePath}>{identity.name}</a>
	<span class="mono meta role">{identity.role[locale]}</span>
	<span class="mono meta city">{identity.city}, {identity.country}</span>
	<nav class="nav" aria-label="Sections">
		{
			sectionKeys.map((key) => (
				<a href={`${homeHref}#${sections[key].id[locale]}`} aria-current={key === current ? 'true' : undefined}>
					{sections[key].label[locale]}
				</a>
			))
		}
		<LanguageSwitch page={page} />
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		/* Les zones tactiles de 44 px apportent déjà l'air : 11 px + la moitié de la
		   zone ≈ les 22 px de la maquette autour du texte. */
		padding: 11px 0;
		border-bottom: 1px solid var(--ink);
		font-size: 13px;
	}

	.name {
		font-size: 15px;
		font-weight: 700;
		text-decoration: none;
	}

	.meta {
		display: none;
		color: var(--muted);
	}

	.nav {
		display: flex;
		flex-wrap: wrap;
		column-gap: 20px;
		font-size: 14px;
		font-weight: 500;
	}

	.nav a {
		text-decoration: none;
	}

	/* Section dont relève la page (une fiche relève de « Projets ») : soulignée en bleu, comme la maquette. */
	.nav a[aria-current] {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	/* Zones tactiles ≥ 44 px tant que la navigation n'a pas sa place de la maquette. */
	.nav a,
	.name {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
	}

	@media (min-width: 600px) {
		.site-header {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
			column-gap: var(--gutter);
		}

		/* Vers 600 px, sections et sélecteur de langue ne tiennent plus à côté du nom : le sélecteur
		   passe à la ligne plutôt que de faire défiler la page. */
		.nav {
			flex-wrap: wrap;
			justify-content: flex-end;
		}
	}

	@media (min-width: 1024px) {
		.site-header {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			align-items: baseline;
			row-gap: 8px;
			padding: 22px 0;
		}

		.name {
			grid-column: span 3;
		}

		.role {
			grid-column: span 3;
		}

		.city {
			grid-column: span 2;
		}

		.meta {
			display: block;
		}

		.nav {
			grid-column: span 4;
			flex-wrap: wrap;
			gap: 6px 20px;
		}

		.nav a,
		.name {
			display: inline;
			min-height: 0;
		}
	}
</style>
