---
/**
 * The hero's lede: a one-line Vim buffer that rewrites itself from one version to the next
 * (`src/lede/typist.ts`). The first version is the final state, rendered here; screen readers get
 * a stable sentence instead of the show.
 */
import { contentOf } from '../data/profile';
import { dictionary, languages, type Lang } from '../i18n';
import { restingOn, runs } from '../lede/buffer';
import { ledeLayout } from '../lede/layout';
import { tallestRules, type Tier } from '../lede/lines';
import { inlineStyleHash } from './inline-script';

interface Props {
	lang: Lang;
	/** The copy on the hero's night (ADR 0008): the typist writes to it too; nothing of it is read out. */
	night?: boolean;
}

const { lang, night = false } = Astro.props;
const { lede } = contentOf(lang);
const line = dictionary(lang).ledeLine;
const first = lede.versions[0];
// The tallest wrap in either language: both pages keep the same rows, and nothing moves at the Bascule.
const rows = (tier: Tier) => Math.max(...languages.map((code) => ledeLayout(code)[tier].rows));
// The audience's rows likewise, every version and both languages, by the width of its line (`.version`).
const audienceRows = tallestRules(
	'[data-rows="audience"]',
	languages.flatMap((code) =>
		contentOf(code).lede.versions.map((version) => dictionary(code).ledeLine.audience(version.audience)),
	),
	24,
	100,
);
Astro.csp?.insertStyleHash(inlineStyleHash(audienceRows));
---

<style is:inline set:html={audienceRows}></style>

<div
	class="hero-lede"
	data-intro={night ? undefined : 'lede'}
	data-lede={night ? undefined : JSON.stringify(lede)}
	data-lede-night={night ? '' : undefined}
>
	{!night && <p class="visually-hidden">{lede.summary}</p>}
	<div class="sentence-box">
		<p
			class="sentence"
			aria-hidden="true"
			data-nosnippet
			data-ag-host="lede"
			style={`--rows-desk: ${rows('desk')}; --rows-phone: ${rows('phone')}`}
		>
			<span data-buffer
				>{
					runs(lede, restingOn(lede, 0)).map(({ text, kind, tiers }) =>
						kind === 'text' ? (
							text
						) : kind === 'break' ? (
							<br data-tiers={tiers?.join(' ')} />
						) : (
							<span data-kind={kind}>{text}</span>
						),
					)
				}</span
			>
		</p>
	</div>
	<p class="mono version" aria-hidden="true" data-version>
		<span class="version-number">{line.version} <span data-version-number>1/{lede.versions.length}</span></span>
		<span data-audience data-ag-host="audience" data-rows="audience">{line.audience(first.audience)}</span>
	</p>
	<div class="mono keys" aria-hidden="true" data-keys data-on="false"></div>
</div>

<script>
	import '../lede/typist';
</script>

<style>
	.hero-lede {
		display: flex;
		flex-direction: column;
	}

	/* What the type is sized on: the sentence alone, so that the keys keep the hero as their containing block. */
	.sentence-box {
		container-type: inline-size;
	}

	/*
	 * Fragment Mono, a letter per column (0.618em, `ADVANCE`), on the tier's columns (`src/lede/lines.ts`):
	 * 26 on a desk, the type as large as they fit up to 30px, each column allowed half a pixel of
	 * rounding; the lines are broken at build, the browser never wraps them. The lede keeps the height
	 * of its tallest wrap, keystrokes included, while it is retyped.
	 */
	.sentence {
		position: relative;
		margin: 0;
		height: calc(var(--rows-desk) * 1.22em);
		font-family: var(--font-mono);
		font-size: min((100cqi - 26 * 0.5px) / (26 * 0.618), 30px);
		font-variant-ligatures: none;
		line-height: 1.22;
		white-space: pre;
	}

	/* Each break says on which tier a line starts there: the other tier's breaks are not drawn. */
	@media (min-width: 601px) {
		.sentence :global(br:not([data-tiers~='desk'])) {
			display: none;
		}
	}

	/* A phone: 18 columns, up to 26px. */
	@media (max-width: 600px) {
		.sentence {
			height: calc(var(--rows-phone) * 1.22em);
			font-size: min((100cqi - 18 * 0.5px) / (18 * 0.618), 26px);
		}

		.sentence :global(br:not([data-tiers~='phone'])) {
			display: none;
		}
	}

	/*
	 * Its size taken from the sentence's rows and never from its text: each keystroke lays out the
	 * buffer alone, not the hero. Chromium only confines a box that is neither a grid nor a flex item, hence the
	 * absolute position in a plain block. No paint containment: the slots' underline runs below the last line.
	 */
	[data-buffer] {
		position: absolute;
		inset: 0;
		contain: size layout;
	}

	/*
	 * Built by the typist too: its spans carry no scoping attribute.
	 * The accent never carries text on the paper: it underlines the slot instead.
	 */
	.sentence :global([data-kind='slot']) {
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-decoration-thickness: 0.15em;
		text-underline-offset: 0.19em;
	}

	.sentence :global([data-kind='selected']) {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.sentence :global([data-kind='block']) {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.sentence :global([data-kind='bar']) {
		display: inline-block;
		width: 3px;
		height: 1.02em;
		margin: 0 -1.5px;
		vertical-align: -0.16em;
		background: var(--color-accent);
	}

	/*
	 * Always two lines: side by side, the audiences' lengths and the mono font's swap would wrap the
	 * line differently and move what follows.
	 */
	/*
	 * The browser wraps a long audience on a narrow phone: the Anagramme's letters pick their lines by the
	 * line's width in columns, a container query in its `ch` (`src/bascule/build.ts`).
	 */
	.version {
		container-type: inline-size;
		display: flex;
		flex-direction: column;
		margin: 14px 0 0;
		padding-top: 8px;
		border-top: 1px solid var(--color-rule);
		font-size: 12px;
		line-height: 1.5;
		color: var(--color-ink-muted);
	}

	.version-number {
		color: var(--color-ink);
	}

	[data-audience][data-run='a'] {
		animation: audience-a 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	[data-audience][data-run='b'] {
		animation: audience-b 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	@keyframes audience-a {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	@keyframes audience-b {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	/*
	 * Screencast keys: a group pops in key by key, then fades as a whole. Out of the flow, in a corner the
	 * page picks: nothing moves.
	 */
	.keys {
		position: absolute;
		display: flex;
		align-items: flex-end;
		gap: 6px;
		transition: opacity 0.5s ease;
	}

	.keys[data-on='false'] {
		opacity: 0;
	}

	.keys :global(kbd) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		min-width: 32px;
		height: 34px;
		padding: 0 9px;
		border: 1px solid var(--color-ink);
		border-bottom-width: 3px;
		border-radius: 6px;
		background: var(--color-light);
		color: var(--color-ink);
		font: inherit;
		font-size: 15px;
		line-height: 1;
		animation: key-in 0.22s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}

	.keys :global(kbd[data-wide]) {
		font-size: 12px;
		letter-spacing: 0.02em;
	}

	.keys :global(kbd:last-child) {
		background: var(--color-ink);
		color: var(--color-paper);
	}

	@keyframes key-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.9);
		}
	}

	/* The typist never starts under reduced motion, but stopping it on a preference flip fades. */
	@media (prefers-reduced-motion: reduce) {
		[data-audience],
		.keys,
		.keys :global(kbd) {
			animation: none !important;
			transition: none;
		}
	}

	/* A phone shows the last keys only: ten would run into the scale bar. */
	@media (max-width: 600px) {
		.keys :global(kbd:nth-last-child(n + 6)) {
			display: none;
		}
	}
</style>
