---
/**
 * The 404, in one language: what `/404` and `/en/404` both render (ADR 0011).
 */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Cursor from './Cursor.astro';
import { dictionary, type Lang } from '../i18n';
import Layout from '../layouts/Layout.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const { meta, notFound: t } = dictionary(lang);
---

<Layout lang={lang} title={meta.notFound.title} description={meta.notFound.description} noindex>
	<main class="wrap not-found">
		<p class="mono status">{t.status}</p>
		<h1>404<Cursor /></h1>
		<p class="lede">{t.lede}</p>
		<a class="button" href={getRelativeLocaleUrl(lang)}>{t.back}</a>
	</main>
</Layout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
		padding-top: clamp(48px, 8vw, 120px);
		padding-bottom: clamp(56px, 8vw, 120px);
	}

	.status {
		margin: 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	h1 {
		margin: 0;
		font-size: clamp(120px, 30vw, 360px);
		line-height: 0.8;
		font-weight: 900;
		font-stretch: 62%;
		letter-spacing: -0.015em;
	}

	.lede {
		margin: 0;
		font-size: clamp(22px, 2.35vw, 34px);
		line-height: 1.2;
		letter-spacing: -0.012em;
	}
</style>
