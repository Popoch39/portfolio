---
/**
 * The Traîne's ring: a thin ring that trails the pointer's point (the cursor's own image, in
 * `global.css`) and opens over what answers a click. In the page's HTML, hidden: without JavaScript
 * the point stands alone. Its script (`src/animation/trail.ts`, loaded by the layout with the
 * animation base) shows it and is the only thing that moves it, by `transform`.
 */
---

<span class="trail" aria-hidden="true" hidden data-trail><span class="circle"></span></span>

<style>
	.trail {
		/* Never drawn but on a screen under a mouse, whatever the script does: the same condition as the point. */
		display: none;
		position: fixed;
		left: 0;
		top: 0;
		/* Over everything, the grain included: a cursor is never under the page. */
		z-index: 5;
		width: 44px;
		height: 44px;
		margin: -22px 0 0 -22px;
		pointer-events: none;
		/* White under `difference` is the exact inverse: ink on the paper, paper on the ink, on any ground. */
		mix-blend-mode: difference;
	}

	@media screen and (hover: hover) and (pointer: fine) and (forced-colors: none) {
		.trail:not([hidden]) {
			display: block;
		}
	}

	/* Drawn at its open size and brought down at rest: a ring scaled up would blur. */
	.circle {
		display: block;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		border: 2px solid #fff;
		border-radius: 50%;
		transform: scale(0.6);
	}

	.trail[data-open] .circle {
		transform: none;
	}

	/* Reduced motion: the ring opens at once. */
	@media (prefers-reduced-motion: no-preference) {
		.circle {
			transition: transform 0.18s ease-out;
		}
	}
</style>
