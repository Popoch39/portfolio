---
/**
 * The Établi (E2 · Établi, ADR 0012): a mechanical keyboard in isometric view, the hero's right half.
 * Rendered whole, at rest: that is the page without JS, under reduced motion, and on every visit that
 * does not play the assembly. When it plays (`html.intro`, set before the first paint by
 * `IntroTrigger.astro`, or `data-assemble` for « Rejouer »), each part comes in by an edge of the hero,
 * screwed, clipped, in the mockup's keyframes.
 *
 * Every moving part is its own HTML box holding its own small SVG: a CSS transform on an element inside
 * an SVG is not composited, the whole drawing would be repainted on every frame. Here the compositor
 * moves the parts and nothing is painted while they fly. The parts are laid out on the mockup's 820 × 614
 * drawing (`.stage`), scaled to the column as a whole: the keyframes keep the mockup's figures.
 */
import { caps, ORIGIN, STAGE, switches, type Box } from '../hero/bench';
import { dictionary, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = dictionary(lang).etabli;
const full = `${-ORIGIN.x} ${-ORIGIN.y} ${STAGE.width} ${STAGE.height}`;
const place = (box: Box) => `left: ${box.x + ORIGIN.x}px; top: ${box.y + ORIGIN.y}px; width: ${box.w}px; height: ${box.h}px`;
const view = (box: Box) => `${box.x} ${box.y} ${box.w} ${box.h}`;
/** Wider than a key and a half (a key's box is 48 wide): its stroke is heard deeper (ADR 0013). */
const WIDE_KEY = 60;
/** The five screws: where they sit, when each drops in and when its slot turns. */
const screws = [
	{ x: -71.5, y: 71.3, drop: 1.15, turn: 1.22 },
	{ x: 26, y: 127.5, drop: 1.2, turn: 1.29 },
	{ x: 156, y: 202.5, drop: 1.25, turn: 1.36 },
	{ x: 253.5, y: 258.8, drop: 1.3, turn: 1.43 },
	{ x: 327.6, y: 241.5, drop: 1.35, turn: 1.5 },
].map((screw) => ({ ...screw, box: { x: Math.floor(screw.x - 6), y: Math.floor(screw.y - 6), w: 12, h: 12 } }));
