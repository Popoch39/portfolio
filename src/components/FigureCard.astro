---
// Carte de figure : Fig. n et titre en haut, la scène au milieu, la consigne et le relevé en
// bas ; la légende dessous. Dans l'aperçu de l'accueil, la scène a une taille fixe et la figure
// s'y inscrit : changer de projet ne décale rien. La fiche remplace scène, consigne et relevé par
// sa propre scène (fente `stage` : les notes, `Notes.astro`), qui porte aussi le bas de la carte.
import '../vendor/anatomy/iso.css';
import '../anatomies/palette.css';

interface Frame {
	fig: number | string;
	title: string;
	caption?: string;
}

interface Scene {
	consignes: { pointer: string; touch: string };
	releve: string;
	/** Le dossier du module de mouvement, que le chargeur monte sur la scène. */
	motion: string;
	/**
	 * Scène de taille fixe, où la figure s'inscrit (aperçu de l'accueil). Les textes de la carte y
	 * sont un doublon visuel de la ligne du projet : les technologies d'assistance les ignorent.
	 */
	fixed?: boolean;
}

type Props = Frame &
	(
		| (Scene &
				(
					| {
							/** La figure au repos, en SVG intégré à la page. */
							svg: string;
							image?: never;
					  }
					| {
							/**
							 * L'image d'attente : le SVG au repos autonome, que le script de la page remplace par la
							 * figure insérée. Elle n'est demandée que si `media` vaut : sans JavaScript, le
							 * navigateur ignore `loading="lazy"` et la chargerait même masquée.
							 */
							image: { src: string; media: string; width: number; height: number; alt: string };
							svg?: never;
					  }
				))
		| {
				/** Scène fournie par la fente `stage`. */
				svg?: never;
				image?: never;
				motion?: never;
		  }
	);

const props = Astro.props;
const { fig, title, caption } = props;
const scene = 'motion' in props && props.motion ? props : undefined;
const fixed = scene?.fixed ?? false;
const echo = fixed ? 'true' : undefined;
---

<figure class:list={['figure', { fixed }]}>
	<div class="card">
		<div class="mono row" aria-hidden={echo}>
			<span class="fig">Fig. {fig}</span>{' '}
			<span>{title}</span>
		</div>
		{
			scene ? (
				<>
					<div class="stage">
						{scene.image ? (
							<div class="scene iso anatomy" data-theme="light" data-motion={scene.motion}>
								<picture>
									<source media={scene.image.media} srcset={scene.image.src} type="image/svg+xml" width={scene.image.width} height={scene.image.height} />
									<img width={scene.image.width} height={scene.image.height} alt={scene.image.alt} loading="lazy" decoding="async" />
								</picture>
							</div>
						) : (
							<div class="scene iso anatomy" data-theme="light" data-motion={scene.motion} set:html={scene.svg} />
						)}
					</div>
					<div class="mono row foot" aria-hidden={echo}>
						<span class="consigne pointer">{scene.consignes.pointer}</span>
						<span class="consigne touch">{scene.consignes.touch}</span>{' '}
						<span class="releve">
							<span class="dot" aria-hidden="true" />
							<span data-releve>{scene.releve}</span>
						</span>
					</div>
				</>
			) : (
				<slot name="stage" />
			)
		}
	</div>
	{caption && <figcaption class="caption"><span class="mono caption-fig">Fig. {fig} —</span> {caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 32px 0 0;
	}

	.card {
		--card-pad: clamp(16px, 2vw, 28px);
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: var(--card-pad);
		background: var(--paper);
		border: 1px solid var(--rule);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		font-size: 12px;
		color: var(--muted);
	}

	.fig {
		color: var(--ink);
	}

	.scene {
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
		/* Le doigt agit sur la figure et fait toujours défiler la page. */
		touch-action: pan-y;
	}

	/* Une seule consigne visible : celle du pointeur s'il sait survoler, sinon celle du toucher. */
	.pointer {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.pointer {
			display: inline;
		}

		.touch {
			display: none;
		}
	}

	.releve {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.dot {
		flex: none;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.caption {
		max-width: 760px;
		margin-top: 14px;
		font-size: 15px;
		line-height: 1.45;
		color: var(--muted);
		text-wrap: pretty;
	}

	.caption-fig {
		font-size: 12px;
		color: var(--ink);
	}

	/* Scène fixe : la figure s'y inscrit, image d'attente comme SVG inséré (qui ne porte pas
	   l'attribut de portée du composant). La consigne, au-dessus du relevé, a deux lignes réservées ;
	   les autres textes tiennent sur une ligne : la carte garde sa hauteur d'un projet à l'autre. */
	.fixed {
		margin: 0;
	}

	/* Sans `min-height: 0`, le contenu (une figure en hauteur) passerait outre le rapport 4:3. */
	.fixed .scene {
		max-width: none;
		min-height: 0;
		aspect-ratio: 4 / 3;
	}

	.fixed .scene > picture,
	.fixed .scene img,
	.fixed .scene > :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
		max-height: none;
		object-fit: contain;
	}

	.fixed .row {
		flex-wrap: nowrap;
		white-space: nowrap;
	}

	.fixed .foot {
		flex-direction: column;
		gap: 6px;
	}

	.fixed .consigne {
		min-height: 2lh;
		white-space: normal;
	}

	.fixed .row > *,
	.fixed [data-releve] {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
