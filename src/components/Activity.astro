---
import SectionHeader from './SectionHeader.astro';
import { identity, sections } from '../data/profile';
import { githubSnapshot } from '../data/github-snapshot';
import { formatNumber, tri } from '../lib/activity';
import { localeOf, ui } from '../lib/i18n';

const locale = localeOf(Astro.currentLocale);
const { id, label } = sections.activity;
const { weeks, count, conclusion, figureLabel } = tri(githubSnapshot, locale);
---

{/* Le Tri (spec #107) : ici son état final, ce que montrent le mouvement réduit et les navigateurs sans
    scène, et l'image sur laquelle la scène finit. */}
<section id={id[locale]} class="activity">
	<div class="tri-scene">
		<SectionHeader
			number={3}
			title={label[locale]}
			note={`${identity.github.profile} ↗`}
			noteHref={identity.links.github}
		/>
		<div class="tri-body">
			<p class="tri-count">{count}</p>
			<p class="mono tri-command">{ui.triCommand[locale].map((part) => <span>{part}</span>)}</p>
			<figure class="tri-figure">
				{/* Une image pour les lecteurs d'écran, qui lisent sa description et le tableau ; les étiquettes de
				    pause doublent le tableau dans les extraits de recherche. */}
				<div class="tri-main" role="img" aria-label={figureLabel} data-nosnippet>
					{
						weeks.map((week, i) => (
							<span class="tri-week" data-days={week.activeDays} data-link={week.link} title={week.title}>
								<span class="tri-node" />
								{/* Dans la seconde moitié de l'année, l'étiquette part vers la gauche pour rester dans la page ;
								    une pause sur deux descend d'une ligne, pour que deux étiquettes proches ne se chevauchent pas. */}
								{week.pause && (
									<span class:list={['mono', 'tri-pause', { end: i >= weeks.length / 2, low: weeks.slice(0, i).filter((w) => w.pause).length % 2 === 1 }]}>
										{week.pause}
									</span>
								)}
							</span>
						))
					}
				</div>
				<figcaption class="tri-conclusion">{conclusion}</figcaption>
			</figure>
			<table class="sr-only">
				<caption>{ui.triTable[locale]}</caption>
				<thead>
					<tr>
						<th scope="col">{ui.weekOf[locale]}</th>
						<th scope="col">{ui.activeDaysHeader[locale]}</th>
						<th scope="col">{ui.contributions[locale]}</th>
					</tr>
				</thead>
				<tbody>
					{
						weeks.map((week) => (
							<tr>
								<th scope="row">{week.date}</th>
								<td>{formatNumber(week.activeDays, locale)}</td>
								<td>{formatNumber(week.contributions, locale)}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	.activity {
		padding-top: clamp(64px, 8vw, 120px);
	}

	.tri-body {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding-top: 40px;
	}

	.tri-count {
		margin: 0;
		font-size: clamp(32px, 4.4vw, 60px);
		line-height: 1;
		font-weight: 800;
		font-stretch: 62%;
		letter-spacing: -0.01em;
	}

	.tri-command {
		margin: 0;
		font-size: max(11px, min(13px, 3vw));
		color: var(--muted);
		overflow-wrap: anywhere;
	}

	.tri-figure {
		margin: 24px 0 0;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	/* Une colonne par semaine, sans gouttière : le trait d'une semaine mesure exactement une colonne. Le
	   plus gros nœud tient dans sa colonne, jusqu'à 18 px. */
	.tri-main {
		--node: min(18px, 100%);
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		/* La place des étiquettes de pause, posées sous la ligne. */
		padding-bottom: 32px;
	}

	.tri-week {
		position: relative;
		display: grid;
		place-items: center;
		height: 18px;
	}

	/* La taille d'un nœud suit ses Jours actifs : un tiers du plus gros pour un jour, entier pour sept. */
	.tri-week[data-days='1'] { --days: 1; }
	.tri-week[data-days='2'] { --days: 2; }
	.tri-week[data-days='3'] { --days: 3; }
	.tri-week[data-days='4'] { --days: 4; }
	.tri-week[data-days='5'] { --days: 5; }
	.tri-week[data-days='6'] { --days: 6; }
	.tri-week[data-days='7'] { --days: 7; }

	.tri-node {
		position: relative;
		z-index: 1;
		width: calc(var(--node) * (2 + var(--days, 0)) / 9);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--accent);
	}

	/* Une pause : un nœud creux, du fond de la page pour couper le pointillé qui le traverse. */
	.tri-week[data-days='0'] .tri-node {
		width: calc(var(--node) * 0.6);
		border: 1.5px solid var(--accent);
		background: var(--bg);
	}

	/* Le trait vers la semaine précédente, d'un centre de nœud à l'autre. */
	.tri-week[data-link]::before {
		content: '';
		position: absolute;
		top: calc(50% - 1px);
		right: 50%;
		width: 100%;
		height: 2px;
		background: var(--accent);
	}

	.tri-week[data-link='dotted']::before {
		background: repeating-linear-gradient(to right, var(--accent) 0 3px, transparent 3px 6px);
	}

	.tri-pause {
		position: absolute;
		top: calc(100% + 8px);
		left: 50%;
		font-size: 11px;
		line-height: 1;
		white-space: nowrap;
		color: var(--muted);
	}

	.tri-pause.end {
		left: auto;
		right: 50%;
	}

	/* Sur téléphone, les colonnes sont trop étroites pour que deux étiquettes tiennent sur une ligne. */
	@media (max-width: 599px) {
		.tri-main {
			padding-bottom: 48px;
		}

		.tri-pause.low {
			top: calc(100% + 24px);
		}
	}

	.tri-conclusion {
		max-width: 34ch;
		font-size: clamp(20px, 2.4vw, 32px);
		line-height: 1.2;
		font-weight: 600;
		text-wrap: balance;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
