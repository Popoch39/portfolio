---
import { localeOf, ui } from '../lib/i18n';

interface Props {
	/** Fichier « ouvert » : celui de la page. */
	path?: string;
	/** Segment de droite, masqué sur mobile (« 2 688 contributions · 12 mois »). */
	secondary: string;
	/** Position dans le fichier, façon Neovim ; `null` masque le segment (la maquette de fiche ne l'a pas). */
	position?: string | null;
}

const locale = localeOf(Astro.currentLocale);
const { path = '~/louis/portfolio.md', secondary, position = ui.statusBottom[locale] } = Astro.props;
---

{/* La Lunette (ADR 0007) pose `data-mode="command"` sur la barre pendant qu'elle est ouverte, et écrit la
    commande en cours dans le showcmd ; l'écouteur y écrit les touches en attente. Les boutons
    `data-lunette` l'ouvrent. */}
<footer class="mono status">
	<div class="side">
		<span class="seg mode state"><span class="normal">NORMAL</span><span class="command">COMMAND</span></span>
		<span class="seg dark branch">
			<svg
				aria-hidden="true"
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				><circle cx="6" cy="5" r="2.2"></circle><circle cx="6" cy="19" r="2.2"></circle><circle
					cx="18"
					cy="8"
					r="2.2"></circle><path d="M6 7.2v9.6M18 10.2c0 4-6 3.5-11 6.8"></path></svg
			>
			<span>main</span>
		</span>
		<span class="seg path">{path}</span>
	</div>
	<div class="side right">
		<span class="seg showcmd" aria-hidden="true" data-showcmd></span>
		<span class="seg secondary">{secondary}</span>
		<button type="button" class="seg dark commands" aria-haspopup="dialog" data-lunette>{ui.statusCommands[locale]}</button>
		{position && <span class="seg dark">{position}</span>}
		<button type="button" class="seg mode wq" aria-haspopup="dialog" aria-label={ui.openCommands[locale]} data-lunette>:wq</button>
	</div>
</footer>

<style>
	.status {
		position: sticky;
		bottom: 0;
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		height: var(--status-height);
		background: var(--ink);
		color: var(--bg);
		font-size: 12px;
		line-height: var(--status-height);
	}

	/* Lettre à lettre (ADR 0004) : la barre ne bouge pas, seuls ses segments changent. */
	:global(:root:active-view-transition) .status {
		view-transition-name: status;
	}

	.side {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}

	.right {
		flex-shrink: 0;
	}

	/* Les boutons sont des segments comme les autres : rien du style du navigateur. */
	.seg {
		margin: 0;
		padding: 0 14px;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		white-space: nowrap;
	}

	button.seg {
		cursor: pointer;
	}

	/* Le contour bleu du site se perdrait sur le bleu de `:wq` : un contour clair, à l'intérieur. */
	button.seg:focus-visible {
		outline-color: var(--bg);
		outline-offset: -4px;
	}

	.mode {
		background: var(--accent);
		color: #ffffff;
		font-weight: 700;
	}

	/* La Lunette ouverte : COMMAND, en encre sur papier. */
	.state .command,
	.status[data-mode='command'] .state .normal {
		display: none;
	}

	.status[data-mode='command'] .state {
		background: var(--paper);
		color: var(--ink);
	}

	.status[data-mode='command'] .state .command {
		display: inline;
	}

	.dark {
		background: var(--status-segment);
	}

	/* La barre fait 30 px : la cible de `:wq` déborde vers le haut jusqu'à 44 px (WCAG 2.5.5), sans
	   déplacer son texte. Sur téléphone, c'est le seul accès à la Lunette. */
	.wq {
		position: relative;
		min-width: 44px;
	}

	.wq::before {
		content: '';
		position: absolute;
		inset: -14px 0 0;
	}

	/* `: commandes` n'est utile qu'à l'ordinateur, où `:wq` ne dit pas assez ce qu'il ouvre. */
	.commands {
		display: none;
		color: var(--on-ink-muted);
	}

	@media (min-width: 900px) {
		.commands {
			display: block;
		}
	}

	.branch {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.path {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.secondary,
	.showcmd {
		display: none;
		color: var(--on-ink-muted);
	}

	/* Le showcmd prend la place du segment de droite tant qu'il a quelque chose à montrer. */
	@media (min-width: 600px) {
		.secondary,
		.showcmd:not(:empty) {
			display: block;
		}

		.showcmd:not(:empty) + .secondary {
			display: none;
		}
	}
</style>
