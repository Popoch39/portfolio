---
import Atome from '../components/Atome.astro';
import Cafe from '../components/Cafe.astro';
import Frise from '../components/Frise.astro';
import HeroSheet from '../components/HeroSheet.astro';
import Intro from '../components/Intro.astro';
import IntroTrigger from '../components/IntroTrigger.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SectionNumber from '../components/SectionNumber.astro';
import Layout from '../layouts/Layout.astro';
import { currentPosition, education, marqueeWords, person, profile, stack } from '../data/profile';
import { graticule, kilometre, meridianShares } from '../hero/map';

const title = 'Louis Pocheron — Développeur web & SIG à Besançon';
const description =
	'Sites vitrines, boutiques en ligne et prise de rendez-vous pour les commerces locaux ; cartographie SIG pour l’énergie et les collectivités. À Besançon.';

const mailto = `mailto:${person.email}`;

const mapStyle = [
	`--pitch-x: ${graticule.pitchX}px`,
	`--pitch-y: ${graticule.pitchY}px`,
	`--phase-x: ${graticule.phaseX}px`,
	`--phase-y: ${graticule.phaseY}px`,
	`--kilometre: ${kilometre}px`,
	`--meridian-share-wide: ${meridianShares[0]}`,
	`--meridian-share-narrow: ${meridianShares[1]}`,
].join('; ');
const [mailUser, mailDomain] = person.email.split('@');

const canonical = new URL('/', Astro.site).href;
// `<` escaped: the JSON sits inside a <script> and must not be able to close it.
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: canonical,
	name: title,
	description,
	inLanguage: 'fr-FR',
	// Google reads the site name shown above the result from a WebSite node on the home page.
	isPartOf: { '@type': 'WebSite', '@id': `${canonical}#website`, name: person.name, url: canonical },
	mainEntity: {
		'@type': 'Person',
		'@id': `${canonical}#person`,
		name: person.name,
		givenName: person.givenName,
		familyName: person.familyName,
		url: canonical,
		email: mailto,
		jobTitle: person.jobTitle,
		description: profile.specialty,
		address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: person.country },
		worksFor: currentPosition && {
			'@type': 'Organization',
			name: currentPosition.company,
			address: { '@type': 'PostalAddress', addressLocality: currentPosition.city, addressCountry: 'FR' },
		},
		alumniOf: [...new Set(education.map((e) => e.school))].map((name) => ({
			'@type': 'EducationalOrganization',
			name,
		})),
		knowsAbout: stack.flatMap((group) => group.items),
		sameAs: [person.github.url],
	},
}).replace(/</g, '\\u003c');
---

<Layout title={title} description={description} pause>
	<script slot="head" type="application/ld+json" set:html={jsonLd} />
	<IntroTrigger slot="head" />
	<Intro slot="overlay" />

	<main>
		<div class="wrap">
			<section class="hero" aria-labelledby="hero-title">
				{/* The name stands on a parallel that runs to Besançon, on a map whose scale holds (`src/hero/map.ts`). */}
				<div class="hero-map theme-light" style={mapStyle}>
					<HeroSheet />
					{
						/*
						 * The night (06 · Terminateur, ADR 0008): the map again in the night's ink, cut along the
						 * line where the sun sets at Besançon. The line, its accent edge, the twilights and their
						 * labels slide together on one `translate`; the copy slides back as much, and stays put.
						 */
					}
					<div class="sky theme-dark" aria-hidden="true" inert data-nosnippet>
						<span class="sky-layer sky-sliver"></span>
						<div class="sky-layer sky-night">
							<div class="sky-sheet">
								<HeroSheet night />
							</div>
							{[1, 2, 3].map((band) => <span class="sky-band" data-band={band} />)}
						</div>
						<span class="mono sky-chip"></span>
						{[1, 2, 3, 4].map((label) => <span class="mono sky-label" data-label={label} />)}
					</div>
				</div>
			</section>
		</div>

		{/* Everything after the first screen, in one block: the page's grid gives the hero its own row. */}
		<div>
			<div class="marquee" aria-hidden="true" data-marquee>
				{/* Two copies: the track slides by half its width, then loops seamlessly. */}
				<div class="marquee-track">
					{
						[...marqueeWords, ...marqueeWords].map((word) => (
							<span class="marquee-item">
								{word}
								<span class="marquee-slash">/</span>
							</span>
						))
					}
				</div>
			</div>

			<Frise number={1} titleId="career-title" />

			<div class="wrap">
				<section id="stack" class="section" aria-labelledby="stack-title">
					<SectionHeading number={2} title="Stack" titleId="stack-title" aside=":set stack?" />
					<Atome />
					{/* The last element the Atome's pinned frame keeps in view: its screen fit measures down to it. */}
					<p class="mono stack-note" data-atome-frame-end>
						éditeur : neovim · multiplexeur : tmux · runtime : bun — <a href={person.nvimConfig}
							>la config est sur GitHub</a
						>
					</p>
				</section>
			</div>

			{/* Out of the column: the moka's zoomed stack runs past it, clipped by the figure. */}
			<Cafe number={3} titleId="cafe-title" />

			<div class="wrap">
				<section id="contact" class="contact-section" aria-labelledby="contact-title">
					<div class="contact grid-12">
						<SectionNumber number={4} />
						<div class="contact-body">
							<h2 id="contact-title" class="visually-hidden">Contact</h2>
							<p class="contact-wq" aria-hidden="true">:wq</p>
							<p class="contact-lede">Un projet carto, une API, une interface React&nbsp;? Écrivez-moi.</p>
							{/* A click yanks the address once the statusline's reactions listen (`src/statusline/yank.ts`). */}
							<a class="contact-mail" href={mailto} data-yank>{mailUser}@<wbr />{mailDomain}</a>
							<div class="contact-links">
								<a href={person.github.url} rel="me"
									>GitHub — {person.github.user} <span aria-hidden="true">↗</span></a
								>
								<a href={person.nvimConfig}>Config Neovim <span aria-hidden="true">↗</span></a>
								<span class="dim">{person.city}, France</span>
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { registerScene } from '../animation/base';
	import { markOffScreen } from '../animation/offscreen';
	import '../hero/register';
	import '../statusline/details';

	// The marquee slides in CSS; registered for the context alone, so that its observer goes with a change of preference.
	registerScene(() => {
		const marquee = document.querySelector<HTMLElement>('[data-marquee]');
		return marquee ? markOffScreen(marquee) : undefined;
	});
</script>

<style>
	.dim {
		color: var(--color-ink-muted);
	}

	/* Hero */

	/*
	 * The first screen: the header and the hero fill the window above the statusline, the title taking
	 * whatever height is left. A spacer spanning the header's row and the hero's sets that height;
	 * the extra goes to the hero's flexible row only. `svh`: the window with the browser's bars shown,
	 * so that nothing is hidden at first and nothing resizes when the bars slide away while scrolling.
	 */
	:global(.page) {
		display: grid;
		/* `minmax(0, …)`: the marquee's track, wider than the window, must not widen the column. */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
	}

	:global(.page)::before {
		content: '';
		grid-area: 1 / 1 / 3;
		min-height: calc(100svh - var(--statusline-height));
	}

	/* A grid item with auto margins shrinks to its content: the centred column keeps its full width. */
	:global(.page > .wrap) {
		grid-area: 1 / 1;
		width: 100%;
	}

	main {
		display: grid;
		grid-area: 2 / 1 / 4;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: subgrid;
	}

	main > .wrap {
		display: flex;
		width: 100%;
	}

	.hero {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 24px 0;
	}

	/*
	 * The map fills what the first screen leaves. The parallel the name stands on splits it at 54 %
	 * of its height; a row whose content needs more takes it, and on a window too short for both the
	 * map runs past the first screen. The marker stands at 64 % of the width (76 % on narrow screens).
	 * Size containment: sized on its content, the rows' fractions would inflate the map past the
	 * window; the floor keeps room for the content.
	 */
	.hero-map {
		--meridian-share: var(--meridian-share-wide);
		--meridian: calc(var(--meridian-share) * 100%);
		--inset: clamp(24px, 3.4vw, 48px);
		--map-rows: minmax(auto, 54fr) minmax(auto, 46fr);
		position: relative;
		display: grid;
		grid-template-rows: var(--map-rows);
		flex: 1;
		min-height: 480px;
		container: map / size;
		border: 1px solid var(--color-ink);
		overflow: hidden;
		/* Daylight's paper whatever the page's theme: the night comes over it along the line. */
		background: var(--color-paper);
	}

	/*
	 * The night (ADR 0008). `.sky` is the map's box set on the line: it slides by the hour's shift
	 * (`src/sky/sky.ts`), and the copy inside slides back as much, so that only the line moves. Both
	 * on `translate` with the same curve: the compositor moves them, nothing is repainted; the outlines
	 * are fixed for the day. Without the sky's script, there is no night at all.
	 */
	.sky {
		--shift: var(--sky-shift);
		/* Where the line stands across the map, in map widths: what the labels place themselves by. */
		--line: calc(var(--meridian-share) + var(--shift));
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		translate: calc(var(--line) * 100%) 0;
	}

	.sky,
	.sky-sheet {
		transition: translate 1.4s cubic-bezier(0.65, 0, 0.25, 1);
	}

	/* At noon and at midnight the night changes sides: it jumps there, never sweeps across the day. */
	.hero-map.sky-cut :is(.sky, .sky-sheet, .sky-night, .sky-sliver) {
		transition: none;
	}

	:global(:root:not([data-sky])) .sky {
		display: none;
	}

	/* The Intro plays in daylight: the night falls once it has ended. */
	:global(html.intro) .sky {
		--shift: var(--sky-held);
	}

	/* Boxes reaching four map widths either side of the line: past any shift (`REACH`, `src/sky/sky.ts`). */
	.sky-layer {
		position: absolute;
		top: 0;
		bottom: 0;
		left: -400%;
		right: -400%;
	}

	/* The accent's edge, 2 px of it along the night. */
	.sky-sliver {
		clip-path: var(--sky-sliver);
		background: var(--color-accent);
	}

	.sky-night {
		clip-path: var(--sky-night);
	}

	/* Off the map all day: not painted, and the lede's copy types into nothing drawn. */
	.sky-night,
	.sky-sliver {
		transition: visibility 1.4s;
	}

	:global(:root[data-sky='day']) :is(.sky-night, .sky-sliver) {
		visibility: hidden;
	}

	/* The map again, back on the map's own box: `cqw` reads the map's width. */
	.sky-sheet {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 400cqw;
		width: 100cqw;
		display: grid;
		grid-template-rows: var(--map-rows);
		background: var(--color-paper);
		translate: calc(var(--line) * -100%) 0;
	}

	/* The twilights, hatched in the night's ink more sparsely towards full night. On the night's own box. */
	.sky-band {
		position: absolute;
		inset: 0;
		background-image: repeating-linear-gradient(
			-45deg,
			color-mix(in srgb, var(--color-ink) 85%, transparent) 0 1px,
			transparent 1px var(--gap)
		);
	}

	.sky-band[data-band='1'] {
		--gap: 5px;
		clip-path: var(--sky-band-1);
	}

	.sky-band[data-band='2'] {
		--gap: 8px;
		clip-path: var(--sky-band-2);
	}

	.sky-band[data-band='3'] {
		--gap: 13px;
		clip-path: var(--sky-band-3);
	}

	/*
	 * The labels ride the line; their text and their place from it (`--at`, map widths) come with the
	 * day's sky. Near the map's edges they fade rather than be cut: `--line + --at` is where they stand.
	 */
	.sky-chip,
	.sky-label {
		--x: calc(var(--line) + var(--at));
		position: absolute;
		/* Placed by `translate` (`cqw`: the map's width), never `left`: a label that moves lays nothing out. */
		left: 0;
		font-size: 10.5px;
		line-height: 1.2;
		white-space: nowrap;
		opacity: clamp(0, min(var(--x) - var(--from), var(--to) - var(--x)) * 100, 1);
		transition: opacity 0.3s ease;
	}

	.sky-chip {
		--at: var(--sky-chip-at);
		--from: 0.01;
		--to: 0.86;
		top: 16%;
		translate: calc(var(--at) * 100cqw + 10px) 0;
	}

	/* In the morning the night lies west of the line: the label hangs on that side. */
	:global(:root[data-sky-half='morning']) .sky-chip {
		--from: 0.14;
		--to: 0.99;
		translate: calc(var(--at) * 100cqw - 100% - 10px) 0;
	}

	.sky-chip::before {
		content: var(--sky-chip);
		display: block;
		padding: 4px 8px;
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-size: 11px;
		font-weight: 700;
	}

	.sky-label {
		--from: 0.06;
		--to: 0.92;
		bottom: 9%;
		translate: calc(var(--at) * 100cqw - 50%) 0;
	}

	.sky-label::before {
		display: block;
		padding: 3px 7px;
		border: 1px solid var(--color-ink-faint);
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.sky-label[data-label='1'] {
		--at: var(--sky-label-1-at);
	}

	.sky-label[data-label='1']::before {
		content: var(--sky-label-1);
	}

	.sky-label[data-label='2'] {
		--at: var(--sky-label-2-at);
	}

	.sky-label[data-label='2']::before {
		content: var(--sky-label-2);
	}

	.sky-label[data-label='3'] {
		--at: var(--sky-label-3-at);
	}

	.sky-label[data-label='3']::before {
		content: var(--sky-label-3);
	}

	/*
	 * Full night: its label keeps to the middle of what the map shows of it, the whole map under
	 * the night's paper, and leaves when too little of it shows. Full night starts `--sky-night-edge` from the line.
	 */
	.sky-label[data-label='4'] {
		--edge: calc(var(--line) + var(--sky-night-edge));
		--at: calc((max(0, var(--edge)) + 1) / 2 - var(--line));
		opacity: clamp(0, (0.9 - var(--edge)) * 100, 1);
	}

	:global(:root[data-sky-half='morning']) .sky-label[data-label='4'] {
		--at: calc(min(1, var(--edge)) / 2 - var(--line));
		opacity: clamp(0, (var(--edge) - 0.1) * 100, 1);
	}

	.sky-label[data-label='4']::before {
		content: var(--sky-label-4);
	}

	@media (prefers-reduced-motion: reduce) {
		.sky,
		.sky-sheet,
		.sky-night,
		.sky-sliver {
			transition: none;
		}
	}

	/*
	 * Narrow screens: the name on two lines over a parallel set higher, Besançon further right with
	 * its label above the rule, the lede across the map.
	 */
	@media (max-width: 860px) {
		.hero {
			padding: 16px 0;
		}

		.hero-map {
			--meridian-share: var(--meridian-share-narrow);
			--inset: 14px;
			--map-rows: minmax(auto, 44fr) minmax(auto, 56fr);
			/* Both rows at their smallest, measured on the build: 459px. */
			min-height: 462px;
		}

		/* A narrow map has no room for the twilights' names: the hatching says it alone. */
		.sky-label:not([data-label='4']) {
			display: none;
		}
	}

	/*
	 * A phone: the lede's keys stand where the night's label would hang, above the scale bar's row
	 * (`HeroSheet.astro`). The label takes that row's free corner, the map's bottom left, whatever
	 * the line's shift, and shows once full night has reached it.
	 */
	@media (max-width: 600px) {
		/*
		 * The rows need more on a phone, where the keys stand a row higher: up to 489px on the narrowest,
		 * the lede on three lines, then 448px at 364px of window and 0.27px more per pixel, as the name grows.
		 */
		.hero-map {
			min-height: max(494px, 27vw + 352px);
		}

		.sky-label[data-label='4'] {
			bottom: 14px;
			translate: calc(var(--line) * -100cqw + var(--inset)) 0;
			opacity: clamp(0, (0.04 - var(--edge)) * 100, 1);
		}

		:global(:root[data-sky-half='morning']) .sky-label[data-label='4'] {
			translate: calc(var(--line) * -100cqw + var(--inset)) 0;
			opacity: clamp(0, (var(--edge) - 0.3) * 100, 1);
		}
	}

	/* Marquee */

	.marquee {
		overflow: hidden;
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 42s linear infinite;
	}

	/* Nothing slides that nobody sees: out of view, and under the Voile. Nor once the visitor has paused it. */
	.marquee[data-offscreen] .marquee-track,
	:global(html.intro) .marquee-track,
	:global(:root:has(#pause:checked)) .marquee-track {
		animation-play-state: paused;
	}

	.marquee-item {
		display: flex;
		align-items: center;
		gap: 26px;
		padding: 18px 0 18px 26px;
		font-size: clamp(22px, 2.6vw, 38px);
		font-weight: 800;
		font-stretch: 72%;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.marquee-slash {
		color: var(--color-on-ink-faint);
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* Sections */

	.section {
		padding-top: clamp(64px, 8vw, 120px);
	}

	/* Stack */

	.stack-note {
		margin: 22px 0 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	/* Contact */

	.contact-section {
		padding: clamp(72px, 9vw, 136px) 0 clamp(56px, 6vw, 96px);
	}

	.contact {
		row-gap: 18px;
	}

	.contact-body {
		grid-column: 2 / span 11;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
	}

	.contact-wq {
		margin: 0;
		font-size: clamp(88px, 14vw, 216px);
		line-height: 0.78;
		font-weight: 900;
		font-stretch: 62%;
		/* Its descender runs into the lede: in ink, the two would merge; ink keeps 5:1 over this shade. */
		color: var(--color-accent-display);
	}

	.contact-lede {
		margin: 0;
		font-size: clamp(20px, 2vw, 28px);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.contact-mail {
		max-width: 100%;
		/* Down to 22px rather than 30px: the address stays on one line on a 320px phone. */
		font-size: clamp(22px, 6.2vw, 92px);
		line-height: 1.05;
		font-weight: 900;
		font-stretch: 70%;
		letter-spacing: -0.02em;
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0 0.06em;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.35s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-mail:hover {
			background-size: 100% 0.06em;
			color: var(--color-ink);
		}
	}

	/* Pressed: the underline is drawn, the address keeps its ink (the muted press of links would grey it). */
	.contact-mail:active {
		background-size: 100% 0.06em;
		color: var(--color-ink);
	}

	/* The address is copied, not followed: the pointer says so while a click does yank it. */
	.contact-mail:not([data-yank='']) {
		position: relative;
		cursor: copy;
	}

	/* The blink of a `yank` over the address just copied: a layer of accent, only its opacity moves. */
	.contact-mail[data-yank='done']::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--color-accent);
		opacity: 0;
		pointer-events: none;
		animation: yank 0.45s ease-out;
	}

	@keyframes yank {
		from {
			opacity: 0.45;
		}
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		margin-top: 10px;
		font-size: 16px;
		font-weight: 500;
	}

	.contact-links a {
		text-underline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}

		.contact-mail {
			transition: none;
		}

		/* The highlight stands for the same moment, then goes at once: nothing fades. */
		.contact-mail[data-yank='done']::after {
			animation-timing-function: step-end;
		}
	}
</style>
