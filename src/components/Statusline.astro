---
/**
 * Vim-like statusline, fixed to the bottom of the window. Decorative, hidden from assistive
 * technologies, but for the Pause and the day's sun. Outside the smoothed content, otherwise its
 * transform would carry it along. Always ink, day or night: it stays in daylight's theme, but on the
 * colour schemes' papers, where it takes the scheme's own darkest row.
 */
import Pause from './Pause.astro';

interface Props {
	/** The page has loops to stop (the marquee, the lede): the statusline carries the Pause (WCAG 2.2.2). */
	pause?: boolean;
}

const { pause = false } = Astro.props;
---

<div id="statusline" class="statusline mono theme-light" data-intro="statusline">
	<div class="side">
		{/* The home page's lede types in Vim: its mode is echoed here (`src/lede/typist.ts`). */}
		{
			/*
			 * The write lane (`src/statusline/lane.ts`): a mode held over the lede's and a message in place
			 * of the branch and the file name. Empty, they are not there; filled, they hide what they cover.
			 */
		}
		<span class="mode" aria-hidden="true" data-lane-mode></span>
		<span class="mode" aria-hidden="true" data-vim-mode>NORMAL</span>
		{pause && <Pause />}
		<span class="message" aria-hidden="true" data-lane-message></span>
		<span class="segment branch" aria-hidden="true">
			<svg
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				><circle cx="6" cy="5" r="2.2"></circle><circle cx="6" cy="19" r="2.2"></circle><circle
					cx="18"
					cy="8"
					r="2.2"></circle><path d="M6 7.2v9.6M18 10.2c0 4-6 3.5-11 6.8"></path></svg
			>
			<span>main</span>
		</span>
		<span class="file" aria-hidden="true">~/louis/portfolio.md<span data-vim-modified hidden> [+]</span></span>
	</div>
	<div class="side">
		{/* Today's sunrise and sunset at Besançon, written by the sky's inline script (`src/sky/sky.ts`). */}
		<p class="sun">
			<svg
				width="13"
				height="13"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				><path d="M3 19h18M7 19a5 5 0 0 1 10 0M12 3v7M9 6l3-3 3 3"></path></svg
			>
			<span><span class="sun-word">lever </span><span class="time" data-sun="rise"></span></span>
			<svg
				width="13"
				height="13"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
				><path d="M3 19h18M7 19a5 5 0 0 1 10 0M12 10V3M9 7l3 3 3-3"></path></svg
			>
			<span><span class="sun-word">coucher </span><span class="time" data-sun="set"></span></span>
			<span class="visually-hidden"> à Besançon aujourd’hui</span>
		</p>
		{/* The paper in force, picked in the Nuancier: read from the root, right from the first paint. */}
		<span class="paper" aria-hidden="true"></span>
		<span class="encoding" aria-hidden="true">utf-8 · markdown</span>
		<span class="segment" aria-hidden="true">Bas</span>
		<span class="mode" aria-hidden="true">:wq</span>
	</div>
</div>

<style>
	.statusline {
		position: fixed;
		inset: auto 0 0;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		/* The row, then the ink carried on under the home indicator and beside a notch, like a native tab bar. */
		height: var(--statusline-row);
		padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
		background: var(--color-ink);
		color: var(--color-paper);
		font-size: 12px;
		line-height: var(--statusline-row);
		/* Decorative: a long press must not select it. */
		-webkit-user-select: none;
		user-select: none;
	}

	.side {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}

	/*
	 * The left side takes what the right one leaves, on one row: a segment that does not fit whole wraps
	 * onto a second row, clipped away. The file name goes first, then the branch; the queries below keep
	 * the right side short enough for the mode and the Pause to stay at every width.
	 */
	.side:first-child {
		flex: 1 1 0;
		flex-wrap: wrap;
		align-content: flex-start;
		height: var(--statusline-row);
		overflow: hidden;
	}

	.side:last-child {
		flex-shrink: 0;
	}

	.side > * {
		padding: 0 14px;
	}

	.mode {
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-weight: 700;
	}

	.mode[data-mode='INSERT'] {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.segment {
		background: var(--color-bar);
	}

	.branch {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.file {
		white-space: nowrap;
	}

	/* The mark keeps its room while hidden: the name would otherwise leave the row at each INSERT. */
	.file [hidden] {
		display: inline;
		visibility: hidden;
	}

	/* The message takes what the row leaves and is cut short there, where the other segments wrap away. */
	.message {
		flex: 1 1 0;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	:is(.message, [data-lane-mode]):empty,
	.side:has(.message:not(:empty)) :is(.branch, .file),
	[data-lane-mode]:not(:empty) + [data-vim-mode] {
		display: none;
	}

	.encoding {
		color: var(--color-on-ink-muted);
	}

	.sun {
		display: flex;
		align-items: center;
		gap: 7px;
		margin: 0;
		color: var(--color-on-ink-muted);
		white-space: nowrap;
	}

	.sun svg + span {
		margin-right: 6px;
	}

	.time {
		color: var(--color-paper);
	}

	.time::after {
		content: var(--sky-rise);
	}

	.time[data-sun='set']::after {
		content: var(--sky-set);
	}

	/* Without the sky's script, no times to give, and no paper but the day's. */
	:global(:root:not([data-sky])) :is(.sun, .paper) {
		display: none;
	}

	/* The Nuancier's codes and names (ADR 0009); `auto` says which of the day or the night it gives. */
	:global(:root) {
		--paper-code: 'EN-04';
		--paper-name: 'auto · jour';
	}

	:global(:root[data-theme='dark']) {
		--paper-name: 'auto · nuit';
	}

	:global(:root[data-bg='light']) {
		--paper-code: 'EN-01';
		--paper-name: 'jour';
	}

	:global(:root[data-bg='dark']) {
		--paper-code: 'EN-02';
		--paper-name: 'nuit';
	}

	:global(:root[data-bg='solarized-light']) {
		--paper-code: 'EN-03';
		--paper-name: 'solarized light';
	}

	.paper {
		white-space: nowrap;
	}

	.paper::before {
		content: 'papier ' var(--paper-code) ' · ';
		color: var(--color-on-ink-muted);
	}

	.paper::after {
		content: var(--paper-name);
	}

	:global(:root[data-bg='nord']) {
		--paper-code: 'EN-05';
		--paper-name: 'nord';
	}

	:global(:root[data-bg='gruvbox-light']) {
		--paper-code: 'EN-06';
		--paper-name: 'gruvbox light';
	}

	:global(:root[data-bg='catppuccin-mocha']) {
		--paper-code: 'EN-07';
		--paper-name: 'catppuccin mocha';
	}

	:global(:root[data-bg='tokyo-night']) {
		--paper-code: 'EN-08';
		--paper-name: 'tokyo night';
	}

	/*
	 * On the colour schemes' papers the row is the scheme's own, like its editor's statusline: its darkest
	 * ground, its text and its orange mode, the INSERT mode in its text colour.
	 */
	:global(:root[data-theme='solarized-light']) .statusline {
		--color-paper: #fdf6e3;
		--color-ink: #073642;
		--color-bar: #002b36;
		--color-on-ink-muted: #93a1a1;
		--color-accent: #cb4b16;
		--color-on-accent: #fff;
	}

	:global(:root[data-theme='nord']) .statusline {
		--color-paper: #eceff4;
		--color-ink: #3b4252;
		--color-bar: #434c5e;
		--color-on-ink-muted: #d8dee9;
		--color-accent: #d08770;
		--color-on-accent: #242933;
	}

	:global(:root[data-theme='gruvbox-light']) .statusline {
		--color-paper: #fbf1c7;
		--color-ink: #282828;
		--color-bar: #3c3836;
		--color-on-ink-muted: #bdae93;
		--color-accent: #af3a03;
		--color-on-accent: #fbf1c7;
	}

	:global(:root[data-theme='catppuccin-mocha']) .statusline {
		--color-paper: #cdd6f4;
		--color-ink: #181825;
		--color-bar: #313244;
		--color-on-ink-muted: #a6adc8;
		--color-accent: #fab387;
		--color-on-accent: #11111b;
	}

	:global(:root[data-theme='tokyo-night']) .statusline {
		--color-paper: #c0caf5;
		--color-ink: #16161e;
		--color-bar: #292e42;
		--color-on-ink-muted: #a9b1d6;
		--color-accent: #ff9e64;
		--color-on-accent: #1a1b26;
	}

	/* The right side gives way step by step, measured on the build: the left one keeps 164px, the mode and the Pause. */
	@media (max-width: 1180px) {
		.encoding {
			display: none;
		}
	}

	@media (max-width: 1040px) {
		.sun-word {
			display: none;
		}
	}

	/* The paper's name alone, as the Nuancier's strips carry their codes. */
	@media (max-width: 860px) {
		.paper::before {
			content: none;
		}
	}

	/* A phone keeps the Pause and the switch: the rest gives way. */
	@media (max-width: 600px) {
		.branch,
		.sun,
		.segment {
			display: none;
		}
	}

	/* Too little room left of the right side for a message: it borrows that side, and gives it back. */
	@media (max-width: 1040px) {
		.side:has(.message:not(:empty)) + .side {
			display: none;
		}
	}

	/*
	 * The narrowest phones: the segments tighten rather than lose one more. Down to 298px of row in all:
	 * a 320px desktop window gives its scrollbar some 15px of it.
	 */
	@media (max-width: 380px) {
		.side > * {
			padding: 0 6px;
		}
	}
</style>
