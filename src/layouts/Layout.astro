---
import { Font } from 'astro:assets';
import { identity, pageMeta, themeColor, type ShareImage } from '../data/profile';
import { person } from '../lib/structured-data';
import { alternatesOf, formats, home, localeOf, locales, pathOf, type Page } from '../lib/i18n';
import { letterDelays, projectsEndId } from '../lib/transition';

interface Props {
	/** Sans les paramètres suivants, la page reprend les valeurs de l'accueil. */
	page?: Page;
	title?: string;
	description?: string;
	shareImage?: ShareImage;
	/** Type Open Graph : l'accueil présente un profil, une fiche un site (`website`). */
	ogType?: 'profile' | 'website';
	/** Données structurées schema.org de la page (JSON-LD). */
	structuredData?: Record<string, unknown>;
}

const locale = localeOf(Astro.currentLocale);

const {
	page = home,
	title = pageMeta[locale].title,
	description = pageMeta[locale].description,
	shareImage = pageMeta[locale].shareImage,
	ogType = 'profile',
	structuredData = { '@context': 'https://schema.org', ...person(Astro.site, locale) },
} = Astro.props;
const canonical = new URL(pathOf(page, locale), Astro.site).href;
// Chaque version déclare toutes les versions, elle-même comprise, et `x-default` (ADR 0002).
const alternates = alternatesOf(page).map(({ hreflang, path }) => ({ hreflang, href: new URL(path, Astro.site).href }));
const otherLocales = locales.filter((version) => version !== locale);
const shareImageUrl = new URL(shareImage.path, Astro.site).href;
// `<` échappé : aucune valeur ne peut fermer la balise <script> avant l'heure.
const jsonLd = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={formats[locale].lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
		<meta name="theme-color" content={themeColor} />
		{/* `sizes` sur le .ico : sans lui, Chrome le préfère au SVG. */}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content={formats[locale].ogLocale} />
		{otherLocales.map((version) => <meta property="og:locale:alternate" content={formats[version].ogLocale} />)}
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(shareImage.width)} />
		<meta property="og:image:height" content={String(shareImage.height)} />
		<meta property="og:image:alt" content={shareImage.alt} />
		{
			ogType === 'profile' && (
				<>
					<meta property="profile:first_name" content={identity.givenName} />
					<meta property="profile:last_name" content={identity.familyName} />
				</>
			)
		}
		{/* X reprend titre, description et image d'Open Graph : seul le format de carte lui est propre. */}
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={jsonLd} />
		{/* Seule la romaine d'Archivo est préchargée : c'est elle qui dessine le héros. */}
		<Font cssVariable="--font-archivo" preload={[{ style: 'normal', subset: 'latin' }]} />
		<Font cssVariable="--font-mono" />
		{page.kind === 'home' && <link rel="expect" href={`#${projectsEndId}`} blocking="render" />}
		<style is:inline set:html={letterDelays} />
		{/* Lettre à lettre (ADR 0004). Classique et dans le <head> : `pagereveal` part avant le premier
		    rendu, avant tout module. Le nom à faire passer est celui dont `data-word` est l'adresse de
		    l'autre page ; sans lui (autre langue, autre fiche), pas de transition. Ses lettres ne sont des
		    éléments que le temps de la transition : au repos, le nom reste un seul texte. */}
		<script is:inline>
			(() => {
				const share = (transition, url) => {
					if (!transition) return;
					const word = url && document.querySelector(`[data-word="${new URL(url).pathname}"]`);
					if (!word) return transition.skipTransition();
					const { top, bottom } = word.getBoundingClientRect();
					// Hors de l'écran, ce nom ne vole pas : celui de l'autre page apparaît ou s'efface sur place.
					if (bottom < 0 || top > innerHeight) return;
					const name = word.textContent;
					const letters = Array.from(name, (c) => Object.assign(document.createElement('span'), { textContent: c }));
					word.replaceChildren(...letters);
					const named = [...letters, word.parentElement.querySelector('[data-word-cursor]')];
					named.forEach((el, i) => el && Object.assign(el.style, { viewTransitionName: `letter-${i}`, viewTransitionClass: 'letter' }));
					const frame = word.closest('[data-word-frame]');
					if (frame) frame.style.viewTransitionName = 'word-frame';
					transition.finished.finally(() => {
						word.textContent = name;
						for (const el of [...named, frame]) el?.style.removeProperty('view-transition-name');
						named.at(-1)?.style.removeProperty('view-transition-class');
					});
				};
				addEventListener('pageswap', (e) => share(e.viewTransition, e.activation?.entry.url));
				addEventListener('pagereveal', (e) => share(e.viewTransition, self.navigation?.activation?.from?.url));
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Valeurs reprises à l'identique de la maquette D1 · Activité. */
	:root {
		--bg: #f3f3ef;
		--ink: #111110;
		--muted: #5f5f5a;
		--rule: #d6d6d0;
		/* Papier des cartes de figure, plus clair que le fond. */
		--paper: #fbfbfa;
		--accent: #2433ff;
		--accent-light: #8e9bff;
		/* Bleu appuyé (survol d'une commande, encre des chaînes de code) et son lavis. */
		--accent-deep: #1b26c9;
		--accent-wash: #e2e5ff;
		--on-ink-muted: #bdbdb6;
		--stack-sep: #a3a39c;
		--status-segment: #2a2a28;
		--heat-0: #e3e3dd;
		--heat-1: #8e9bff;
		--heat-2: #5b6bff;
		--heat-3: #2b3bf5;
		--heat-4: #161f9e;

		--container: 1440px;
		--page-margin: clamp(16px, 4vw, 56px);
		--gutter: 24px;
		--status-height: 30px;

		--font-sans: var(--font-archivo);
	}

	*,
	::before,
	::after {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
		/* La barre d'état collée en bas masquerait l'élément qui reçoit le focus au clavier :
		   le défilement le garde au-dessus d'elle, contour compris (WCAG 2.4.11). */
		scroll-padding-bottom: calc(var(--status-height) + 8px);
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.5;
	}

	a {
		color: var(--ink);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.mono {
		font-family: var(--font-mono);
	}

	/* Conteneur de contenu : plafonné à 1440 px, centré. Les bandes pleine largeur
	   (bandeau, barre d'état) restent en dehors. */
	.container {
		max-width: var(--container);
		margin: 0 auto;
		padding: 0 var(--page-margin);
	}

	/* Grille de 12 colonnes. Mobile-first : chaque enfant occupe toute la largeur,
	   les composants placent leurs colonnes à partir de 600 / 1024 px. */
	.grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
	}

	.grid > * {
		grid-column: 1 / -1;
	}

	/* Lettre à lettre (ADR 0004) : la view transition entre l'accueil et une fiche. La page d'arrivée
	   dessine les pseudo-éléments : la fiche règle l'aller, l'accueil le retour, ce gabarit le commun. */
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}

		/* Les groupes s'empilent dans l'ordre de la page de départ, ceux de l'arrivée par-dessus : un bloc
		   qui arrive couvrirait la barre d'état, et l'en-tête de l'accueil les lettres. */
		::view-transition-group(status) {
			z-index: 1;
		}

		/* Une lettre qui part décrit un arc, au-dessus de la droite que suit son groupe. */
		::view-transition-group(*.letter) {
			z-index: 2;
			animation-timing-function: cubic-bezier(0.65, 0, 0.15, 1);
			animation-fill-mode: both;
		}

		::view-transition-old(*.letter),
		::view-transition-new(*.letter) {
			--arc: clamp(16px, 3vw, 40px);
			animation-timing-function: linear, ease;
			animation-fill-mode: both;
		}

		/* Sans lettre en face (le curseur, un nom hors de l'écran) : elle se pose à son tour, ou s'efface
		   aussitôt, sur place. */
		::view-transition-new(*.letter):only-child {
			animation: vt-land 960ms cubic-bezier(0.16, 1, 0.3, 1) both;
			animation-delay: inherit;
		}

		::view-transition-old(*.letter):only-child {
			animation: vt-leave 240ms ease both;
		}

		@keyframes vt-arc {
			from {
				translate: 0 0;
				animation-timing-function: cubic-bezier(0.25, 0.6, 0.4, 1);
			}
			46% {
				translate: 0 calc(-1 * var(--arc));
				animation-timing-function: cubic-bezier(0.55, 0, 0.35, 1);
			}
			to {
				translate: 0 0;
			}
		}

		@keyframes vt-land {
			from,
			60% {
				opacity: 0;
				scale: 0.4;
			}
		}

		/* Les blocs qui ne sont pas des lettres glissent de `--vt-shift` en s'effaçant ou en apparaissant. */
		@keyframes vt-leave {
			to {
				opacity: 0;
				translate: var(--vt-shift, 0 0);
			}
		}

		@keyframes vt-arrive {
			from {
				opacity: 0;
				translate: var(--vt-shift, 0 0);
			}
		}
	}
</style>
