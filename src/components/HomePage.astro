---
/**
 * The home page, in one language: what `/` and `/en/` both render (ADR 0011).
 */
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import Anagramme from './Anagramme.astro';
import Atome from './Atome.astro';
import Cafe from './Cafe.astro';
import Frise from './Frise.astro';
import HeroSheet from './HeroSheet.astro';
import IntroTrigger from './IntroTrigger.astro';
import SectionHeading from './SectionHeading.astro';
import SectionNumber from './SectionNumber.astro';
import Layout from '../layouts/Layout.astro';
import { contentOf, currentPosition, marqueeWords, person, stack } from '../data/profile';
import { dictionary, type Lang } from '../i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = dictionary(lang);
const profile = contentOf(lang);
const current = currentPosition(lang);
const { title, description } = t.meta.home;

const mailto = `mailto:${person.email}`;
const [mailUser, mailDomain] = person.email.split('@');

const canonical = getAbsoluteLocaleUrl(lang);
// `<` escaped: the JSON sits inside a <script> and must not be able to close it.
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: canonical,
	name: title,
	description,
	inLanguage: t.meta.locale,
	// Google reads the site name shown above the result from a WebSite node on the home page.
	isPartOf: { '@type': 'WebSite', '@id': `${canonical}#website`, name: person.name, url: canonical },
	mainEntity: {
		'@type': 'Person',
		'@id': `${canonical}#person`,
		name: person.name,
		givenName: person.givenName,
		familyName: person.familyName,
		url: canonical,
		email: mailto,
		jobTitle: profile.jobTitle,
		description: profile.specialty,
		address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: person.country },
		worksFor: current && {
			'@type': 'Organization',
			name: current.company,
			address: { '@type': 'PostalAddress', addressLocality: current.city, addressCountry: 'FR' },
		},
		alumniOf: [...new Set(profile.education.map((e) => e.school))].map((name) => ({
			'@type': 'EducationalOrganization',
			name,
		})),
		knowsAbout: stack.flatMap((group) => group.items),
		sameAs: [person.github.url],
	},
}).replace(/</g, '\\u003c');
---

<Layout lang={lang} title={title} description={description} pause>
	<script slot="head" type="application/ld+json" set:html={jsonLd} />
	<IntroTrigger slot="head" />
	{/* Arrived by a Bascule, the hero opens on the other language's version: nothing is painted before (`Anagramme.astro`). */}
	<link slot="head" rel="expect" href="#bascule-arrival" blocking="render" />

	<main>
		{/* The hero's band runs the window's width, its grid with it; its content keeps the page's column. */}
		<div class="hero-band">
			<div class="wrap">
				<section class="hero" aria-labelledby="hero-title">
					<HeroSheet lang={lang} />
				</section>
				<Anagramme lang={lang} />
			</div>
		</div>

		{/* Everything after the first screen, in one block: the page's grid gives the hero its own row. */}
		<div>
			<div class="marquee" aria-hidden="true" data-marquee>
				{/* Two copies: the track slides by half its width, then loops seamlessly. */}
				<div class="marquee-track">
					{
						[...marqueeWords, ...marqueeWords].map((word) => (
							<span class="marquee-item">
								{word}
								<span class="marquee-slash">/</span>
							</span>
						))
					}
				</div>
			</div>

			<Frise lang={lang} number={1} titleId="career-title" />

			<div class="wrap">
				<section id="stack" class="section" aria-labelledby="stack-title">
					<SectionHeading number={2} title={t.stackSection.title} titleId="stack-title" aside={t.stackSection.aside} />
					<Atome lang={lang} />
					{/* The last element the Atome's pinned frame keeps in view: its screen fit measures down to it. */}
					<p class="mono stack-note" data-atome-frame-end>
						{t.stackSection.note}<a href={person.nvimConfig}>{t.stackSection.noteLink}</a>
					</p>
				</section>
			</div>

			{/* Out of the column: the moka's zoomed stack runs past it, clipped by the figure. */}
			<Cafe lang={lang} number={3} titleId="cafe-title" />

			<div class="wrap">
				<section id="contact" class="contact-section" aria-labelledby="contact-title">
					<div class="contact grid-12">
						<SectionNumber number={4} />
						<div class="contact-body">
							<h2 id="contact-title" class="visually-hidden">{t.contact.title}</h2>
							<p class="contact-wq" aria-hidden="true">:wq</p>
							<p class="contact-lede">{t.contact.lede}</p>
							{/* A click yanks the address once the statusline's reactions listen (`src/statusline/yank.ts`). */}
							<a class="contact-mail" href={mailto} data-yank>{mailUser}@<wbr />{mailDomain}</a>
							<div class="contact-links">
								{/* The Café's anchor; with JavaScript it opens the Formulaire du Café there (`src/cafe/form.ts`). */}
								<a href="#cafe" data-cafe-propose>{t.contact.propose}</a>
								<a href={person.github.url} rel="me"
									>GitHub — {person.github.user} <span aria-hidden="true">↗</span></a
								>
								<a href={person.nvimConfig}>{t.contact.nvimConfig} <span aria-hidden="true">↗</span></a>
								<span class="dim">{person.city}, {profile.country}</span>
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>
</Layout>

<script>
	import { registerScene } from '../animation/base';
	import { markOffScreen } from '../animation/offscreen';
	import '../atome/aim';
	import '../hero/register';
	import '../statusline/modes';
	import '../statusline/yank';

	// The marquee slides in CSS; registered for the context alone, so that its observer goes with a change of preference.
	registerScene(() => {
		const marquee = document.querySelector<HTMLElement>('[data-marquee]');
		return marquee ? markOffScreen(marquee) : undefined;
	});
</script>

<style>
	.dim {
		color: var(--color-ink-muted);
	}

	/* Hero */

	/*
	 * The first screen: the header and the hero fill the window above the statusline, the title taking
	 * whatever height is left. A spacer spanning the header's row and the hero's sets that height;
	 * the extra goes to the hero's flexible row only. `svh`: the window with the browser's bars shown,
	 * so that nothing is hidden at first and nothing resizes when the bars slide away while scrolling.
	 */
	:global(.page) {
		display: grid;
		/* `minmax(0, …)`: the marquee's track, wider than the window, must not widen the column. */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
	}

	:global(.page)::before {
		content: '';
		grid-area: 1 / 1 / 3;
		min-height: calc(100svh - var(--statusline-height));
	}

	/* A grid item with auto margins shrinks to its content: the centred column keeps its full width. */
	:global(.page > .wrap) {
		grid-area: 1 / 1;
		width: 100%;
	}

	main {
		display: grid;
		grid-area: 2 / 1 / 4;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: subgrid;
	}

	/*
	 * The hero's band fills what the first screen leaves, the mockup's 72px grid over it from the page's
	 * gutter. It clips what flies past its edges: the Établi's parts start outside the window.
	 */
	.hero-band {
		display: flex;
		overflow: clip;
		background-image:
			linear-gradient(to right, var(--color-rule) 1px, transparent 1px),
			linear-gradient(to bottom, var(--color-rule) 1px, transparent 1px);
		background-size: 72px 72px;
		background-position: var(--page-gutter) 0;
	}

	.hero-band > .wrap {
		display: flex;
		width: 100%;
	}

	.hero {
		display: flex;
		flex: 1;
		align-items: center;
	}

	/* Marquee */

	.marquee {
		overflow: hidden;
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 42s linear infinite;
	}

	/* Nothing slides that nobody sees: out of view. Nor once the visitor has paused it. */
	.marquee[data-offscreen] .marquee-track,
	:global(:root:has(#pause:checked)) .marquee-track {
		animation-play-state: paused;
	}

	.marquee-item {
		display: flex;
		align-items: center;
		gap: 26px;
		padding: 18px 0 18px 26px;
		font-size: clamp(22px, 2.6vw, 38px);
		font-weight: 800;
		font-stretch: 72%;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.marquee-slash {
		color: var(--color-on-ink-faint);
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* Sections */

	.section {
		padding-top: clamp(64px, 8vw, 120px);
	}

	/* Stack */

	.stack-note {
		margin: 22px 0 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	/* Contact */

	.contact-section {
		padding: clamp(72px, 9vw, 136px) 0 clamp(56px, 6vw, 96px);
	}

	.contact {
		row-gap: 18px;
	}

	.contact-body {
		grid-column: 2 / span 11;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
	}

	.contact-wq {
		margin: 0;
		font-size: clamp(88px, 14vw, 216px);
		line-height: 0.78;
		font-weight: 900;
		font-stretch: 62%;
		/* Its descender runs into the lede: in ink, the two would merge; ink keeps 5:1 over this shade. */
		color: var(--color-accent-display);
	}

	.contact-lede {
		margin: 0;
		font-size: clamp(20px, 2vw, 28px);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.contact-mail {
		max-width: 100%;
		/* Down to 22px rather than 30px: the address stays on one line on a 320px phone. */
		font-size: clamp(22px, 6.2vw, 92px);
		line-height: 1.05;
		font-weight: 900;
		font-stretch: 70%;
		letter-spacing: -0.02em;
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0 0.06em;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.35s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.contact-mail:hover {
			background-size: 100% 0.06em;
			color: var(--color-ink);
		}
	}

	/* Pressed: the underline is drawn, the address keeps its ink (the muted press of links would grey it). */
	.contact-mail:active {
		background-size: 100% 0.06em;
		color: var(--color-ink);
	}

	/* The address is copied, not followed: the pointer says so while a click does yank it. */
	.contact-mail:not([data-yank='']) {
		position: relative;
		cursor: copy;
	}

	/* Under a mouse the address keeps the Traîne's point like any text, whose ring opens over it: `copy` stands behind. */
	@media (hover: hover) and (pointer: fine) and (forced-colors: none) {
		.contact-mail:not([data-yank='']) {
			cursor: var(--trail-point), copy;
		}
	}

	/* The blink of a `yank` over the address just copied: a layer of accent, only its opacity moves. */
	.contact-mail[data-yank='done']::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--color-accent);
		opacity: 0;
		pointer-events: none;
		animation: yank 0.45s ease-out;
	}

	@keyframes yank {
		from {
			opacity: 0.45;
		}
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		margin-top: 10px;
		font-size: 16px;
		font-weight: 500;
	}

	.contact-links a {
		text-underline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}

		.contact-mail {
			transition: none;
		}

		/* The highlight stands for the same moment, then goes at once: nothing fades. */
		.contact-mail[data-yank='done']::after {
			animation-timing-function: step-end;
		}
	}
</style>
