---
/**
 * Sets the sky before the first paint (ADR 0008): the page's theme, and the night on the hero, from
 * the hour at Besançon and the visit's paper. Inline in the `<head>` of every page, so that
 * the night is never a flash of daylight first. The function is the bundled module's own
 * (`src/sky/sky.ts`), printed here as source: one ephemeris, not two.
 *
 * A visit draws its paper by lot as it begins (ADR 0009): on arriving from elsewhere, and on a reload,
 * which replays the Intro in the new paper. Never the same paper twice in a row. Within the visit, from
 * page to page and back, the page keeps the drawn paper, or the one picked in the Nuancier since.
 */
import { BG_KEY, paintSky, skyModes, skyPlace } from '../sky/sky';
import { inlineScriptHash } from './inline-script';

// Storage throws when the browser blocks site data: each page then draws, or follows the sun within the visit.
const paint = `(() => {
	const root = document.documentElement;
	const key = ${JSON.stringify(BG_KEY)};
	const navigation = performance.getEntriesByType('navigation')[0];
	const type = navigation && navigation.type;
	// The slash keeps out a host that merely starts the same.
	const fromThisSite = document.referrer.startsWith(\`\${location.origin}/\`);
	const begins = type === 'reload' || (type !== 'back_forward' && !fromThisSite);
	const kept = (() => {
		try {
			return sessionStorage.getItem(key);
		} catch {
			return null;
		}
	})();
	const keep = (paper) => {
		try {
			sessionStorage.setItem(key, paper);
			return true;
		} catch {
			return false;
		}
	};
	const papers = ${JSON.stringify(skyModes)};
	let bg = kept;
	// A paper the site no longer has (kept by a visit begun before a deploy) draws again.
	if (begins || (kept !== null && !papers.includes(kept))) {
		const drawn = papers.filter((paper) => paper !== kept);
		bg = drawn[Math.floor(Math.random() * drawn.length)];
		keep(bg);
	}
	if (bg && bg !== 'auto') root.dataset.bg = bg;
	(${paintSky.toString()})(root, new Date(), ${JSON.stringify(skyPlace)});
})();`;
Astro.csp?.insertScriptHash(inlineScriptHash(paint));
---

<script is:inline set:html={paint} />
