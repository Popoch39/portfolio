---
import SectionNumber from './SectionNumber.astro';

interface Props {
	number: number;
	title: string;
	/** Referenced by the section's `aria-labelledby`. */
	titleId: string;
	aside: string;
}

const { number, title, titleId, aside } = Astro.props;
---

<div class="section-heading grid-12">
	<SectionNumber number={number} />
	<h2 id={titleId}>{title}</h2>
	<p class="mono aside">{aside}</p>
</div>

<style>
	.section-heading {
		row-gap: 10px;
		align-items: end;
		padding-bottom: 18px;
		border-bottom: 1px solid var(--color-ink);
	}

	h2 {
		grid-column: span 8;
		margin: 0;
		font-size: clamp(52px, 8vw, 120px);
		line-height: 0.84;
		font-weight: 800;
		font-stretch: 62%;
		text-transform: uppercase;
	}

	.aside {
		grid-column: span 3;
		margin: 0;
		text-align: right;
		font-size: 13px;
		color: var(--color-ink-muted);
	}
</style>
