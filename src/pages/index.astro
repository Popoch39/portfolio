---
import Atome from '../components/Atome.astro';
import Cursor from '../components/Cursor.astro';
import Frise from '../components/Frise.astro';
import Intro from '../components/Intro.astro';
import IntroTrigger from '../components/IntroTrigger.astro';
import Lede from '../components/Lede.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SectionNumber from '../components/SectionNumber.astro';
import Layout from '../layouts/Layout.astro';
import {
	currentPosition,
	education,
	marqueeWords,
	person,
	profile,
	projects,
	publicRepoCount,
	stack,
	twoDigits,
} from '../data/profile';

const title = 'Louis Pocheron — Développeur fullstack & SIG à Besançon';
const description =
	'Concepteur et développeur d’applications fullstack, spécialisé SIG et cartographie : serveurs de tuiles, nuages de points et interfaces React. Basé à Besançon.';

const repoCount = await publicRepoCount();
const projectsAside = [`${projects.length} sélectionnés`, repoCount && `${repoCount} dépôts publics`]
	.filter(Boolean)
	.join(' · ');

const mailto = `mailto:${person.email}`;
const [mailUser, mailDomain] = person.email.split('@');

const canonical = new URL('/', Astro.site).href;
// `<` escaped: the JSON sits inside a <script> and must not be able to close it.
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: canonical,
	name: title,
	description,
	inLanguage: 'fr-FR',
	// Google reads the site name shown above the result from a WebSite node on the home page.
	isPartOf: { '@type': 'WebSite', '@id': `${canonical}#website`, name: person.name, url: canonical },
	mainEntity: {
		'@type': 'Person',
		'@id': `${canonical}#person`,
		name: person.name,
		givenName: person.givenName,
		familyName: person.familyName,
		url: canonical,
		email: mailto,
		jobTitle: person.jobTitle,
		description: profile.specialty,
		address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: person.country },
		worksFor: currentPosition && {
			'@type': 'Organization',
			name: currentPosition.company,
			address: { '@type': 'PostalAddress', addressLocality: currentPosition.city, addressCountry: 'FR' },
		},
		alumniOf: [...new Set(education.map((e) => e.school))].map((name) => ({
			'@type': 'EducationalOrganization',
			name,
		})),
		knowsAbout: stack.flatMap((group) => group.items),
		sameAs: [person.github.url],
	},
}).replace(/</g, '\\u003c');
---

<Layout title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={jsonLd} />
	<IntroTrigger slot="head" />
	<Intro slot="overlay" />

	<main>
		<div class="wrap">
			<section class="hero" aria-labelledby="hero-title">
				<p class="mono hero-status" data-intro="status">
					<span class="hero-mode">-- NORMAL --</span>
					<span>portfolio · {new Date().getFullYear()}</span>
				</p>
				<div class="hero-fit">
					<h1 id="hero-title" class="hero-title">
						<span class="hero-line"><span data-intro="line">{person.givenName}</span></span>
						<span class="hero-line"><span class="hero-last" data-intro="line">{person.familyName}<Cursor data-intro="late" /></span></span>
					</h1>
				</div>
				<div class="hero-grid grid-12">
					<Lede />
					<dl class="hero-facts" data-intro="facts">
						<div>
							<dt class="mono">Rôle</dt>
							<dd>{profile.role}</dd>
						</div>
						<div>
							<dt class="mono">Spécialité</dt>
							<dd>{profile.specialty}</dd>
						</div>
						<div>
							<dt class="mono">Aujourd’hui</dt>
							<dd>{profile.today}</dd>
						</div>
					</dl>
					<div class="hero-actions" data-intro="actions">
						<a class="button" href={mailto}
							>Écrire<span class="visually-hidden"> un e-mail</span>
							<span class="mono" aria-hidden="true">:wq</span></a
						>
						<a class="hero-github" href={person.github.url} rel="me">GitHub <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		</div>

		{/* Everything after the first screen, in one block: the page's grid gives the hero its own row. */}
		<div>
			<div class="marquee" aria-hidden="true">
				{/* Two copies: the track slides by half its width, then loops seamlessly. */}
				<div class="marquee-track">
					{
						[...marqueeWords, ...marqueeWords].map((word) => (
							<span class="marquee-item">
								{word}
								<span class="marquee-slash">/</span>
							</span>
						))
					}
				</div>
			</div>

			<div class="wrap">
				<section id="projets" class="projects-section" aria-labelledby="projects-title">
					<SectionHeading number={1} title="Projets" titleId="projects-title" aside={projectsAside} />
					<ol class="projects">
						{
							projects.map((project, i) => (
								<li>
									<a class="project grid-12" href={`${person.github.url}/${project.repo}`}>
										<span class="mono project-number" aria-hidden="true">
											{twoDigits(i + 1)}
										</span>
										<h3 class="project-name">{project.repo}</h3>
										<p class="project-description dim">{project.description}</p>
										<p class="mono project-stack dim">{project.stack}</p>
										<span class="mono project-year">
											<time datetime={String(project.year)}>{project.year}</time> <span aria-hidden="true">↗</span>
										</span>
									</a>
								</li>
							))
						}
					</ol>
				</section>
			</div>

			<Frise number={2} titleId="career-title" />

			<div class="wrap">
				<section id="stack" class="section" aria-labelledby="stack-title">
					<SectionHeading number={3} title="Stack" titleId="stack-title" aside=":set stack?" />
					<Atome />
					{/* The last element the Atome's pinned frame keeps in view: its screen fit measures down to it. */}
					<p class="mono stack-note" data-atome-frame-end>
						éditeur : neovim · multiplexeur : tmux · runtime : bun — <a href={person.nvimConfig}
							>la config est sur GitHub</a
						>
					</p>
				</section>

				<section id="contact" class="contact-section" aria-labelledby="contact-title">
					<div class="contact grid-12">
						<SectionNumber number={4} />
						<div class="contact-body">
							<h2 id="contact-title" class="visually-hidden">Contact</h2>
							<p class="contact-wq" aria-hidden="true">:wq</p>
							<p class="contact-lede">Un projet carto, une API, une interface React&nbsp;? Écrivez-moi.</p>
							<a class="contact-mail" href={mailto}>{mailUser}@<wbr />{mailDomain}</a>
							<div class="contact-links">
								<a href={person.github.url} rel="me"
									>GitHub — {person.github.user} <span aria-hidden="true">↗</span></a
								>
								<a href={person.nvimConfig}>Config Neovim <span aria-hidden="true">↗</span></a>
								<span class="dim">{person.city}, France</span>
							</div>
						</div>
					</div>
				</section>
			</div>
		</div>
	</main>
</Layout>

<style>
	.dim {
		color: var(--color-ink-muted);
	}

	/* Hero */

	/*
	 * The first screen: the header and the hero fill the window above the statusline, the title taking
	 * whatever height is left. A spacer spanning the header's row and the hero's sets that height;
	 * the extra goes to the hero's flexible row only. `svh`: the window with the browser's bars shown,
	 * so that nothing is hidden at first and nothing resizes when the bars slide away while scrolling.
	 */
	:global(.page) {
		display: grid;
		/* `minmax(0, …)`: the marquee's track, wider than the window, must not widen the column. */
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
	}

	:global(.page)::before {
		content: '';
		grid-area: 1 / 1 / 3;
		min-height: calc(100svh - var(--statusline-height));
	}

	/* A grid item with auto margins shrinks to its content: the centred column keeps its full width. */
	:global(.page > .wrap) {
		grid-area: 1 / 1;
		width: 100%;
	}

	main {
		display: grid;
		grid-area: 2 / 1 / 4;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: subgrid;
	}

	main > .wrap {
		display: flex;
		width: 100%;
	}

	.hero {
		display: flex;
		flex-direction: column;
		flex: 1;
		/* The title's floor is sized against the column, measured as a container. */
		container-type: inline-size;
		padding: clamp(20px, 3vw, 40px) 0 clamp(16px, 2.5vw, 32px);
	}

	/*
	 * The title's box takes the height left over and is measured as a container: the title fits both
	 * its width and its height. Below a floor (a phone on its side) it stops shrinking and the hero
	 * runs past the window.
	 */
	.hero-fit {
		display: flex;
		flex-direction: column;
		/* Bound by the width (a tall screen), the title shares the height left over above and below. */
		justify-content: center;
		flex: 1 1 0;
		container-type: size;
		min-height: calc(100cqi / 4.35 * 1.6 * 0.4);
	}

	.hero-status {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin: 0 0 clamp(14px, 2vw, 26px);
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	.hero-mode {
		color: var(--color-ink);
	}

	.hero-title {
		margin: 0;
		/*
		 * "POCHERON" and its cursor take 4.2em, with room to spare: the size follows the width of the
		 * column so the cursor never bleeds out of it (the mockup's 22vw did, down to 320px screens).
		 * The two lines take 1.6em: the size also follows the height left to the title.
		 */
		font-size: min(100cqi / 4.35, 100cqh / 1.6);
		/* Moves the text, not the line boxes: the stems of L and P touch the edge of column 1. */
		text-indent: -0.045em;
		line-height: 0.8;
		font-weight: 900;
		font-stretch: 62%;
		letter-spacing: -0.015em;
		text-transform: uppercase;
	}

	/*
	 * Each line clips its own rise. The padding gives the caps room above the 0.8 line height,
	 * the negative margin keeps the lines where they were.
	 */
	.hero-line {
		display: block;
		overflow: hidden;
		padding-top: 0.06em;
		margin-top: -0.06em;
	}

	.hero-line > span {
		display: block;
	}

	.hero-last {
		white-space: nowrap;
	}

	/*
	 * A phone held upright: fitted to the height left over, the name shrank to a line of text under
	 * the stacked lede and facts. It takes the column's width instead, each line fitted on its own,
	 * "LOUIS" twice the size of "POCHERON", and the rest of the hero runs past the first screen.
	 */
	@media (max-width: 600px) and (orientation: portrait) {
		.hero-fit {
			flex: none;
			/* The title's height comes from its content again; `cqi` now reads the hero's column. */
			container-type: normal;
			min-height: 0;
		}

		.hero-title {
			font-size: calc(100cqi / 4.35);
		}

		/* `text-indent` inherits as a length: each line works it out against its own size. */
		.hero-line {
			text-indent: -0.045em;
		}

		.hero-line:first-child {
			/* "LOUIS" takes 2.13em, less the indent: its S lines up with the cursor's edge. */
			font-size: calc(100cqi / 2.12);
		}
	}

	.hero-grid {
		row-gap: 32px;
		align-items: start;
		margin-top: clamp(32px, 4.5vw, 68px);
	}

	/* The lede is a component: its root carries the component's scope, not the page's. */
	.hero-grid > :global(.hero-lede) {
		grid-column: 1 / span 6;
	}

	.hero-facts {
		grid-column: 8 / span 3;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		font-size: 15px;
		line-height: 1.4;
	}

	.hero-facts div {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.hero-facts dt {
		font-size: 12px;
		color: var(--color-ink-muted);
	}

	.hero-facts dd {
		margin: 0;
	}

	.hero-actions {
		grid-column: 11 / span 2;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
	}

	.button .mono {
		font-size: 13px;
		color: var(--color-on-ink-muted);
	}

	.button:hover .mono {
		color: inherit;
	}

	.hero-github {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 600;
		text-underline-offset: 4px;
	}

	/* Tablet: the three hero columns are too narrow for the button. */
	@media (min-width: 861px) and (max-width: 1100px) {
		.hero-grid > :global(.hero-lede) {
			grid-column: 1 / -1;
		}

		.hero-facts {
			grid-column: 1 / span 7;
		}

		.hero-actions {
			grid-column: 9 / span 4;
		}
	}

	/* Marquee */

	.marquee {
		overflow: hidden;
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 42s linear infinite;
	}

	.marquee-item {
		display: flex;
		align-items: center;
		gap: 26px;
		padding: 18px 0 18px 26px;
		font-size: clamp(22px, 2.6vw, 38px);
		font-weight: 800;
		font-stretch: 72%;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.marquee-slash {
		color: var(--color-on-ink-faint);
	}

	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* Sections */

	.projects-section {
		padding-top: clamp(56px, 7vw, 108px);
	}

	.section {
		padding-top: clamp(64px, 8vw, 120px);
	}

	/* Projects */

	.projects {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.projects li {
		border-bottom: 1px solid var(--color-rule);
	}

	.project {
		row-gap: 8px;
		align-items: baseline;
		margin: 0 -14px;
		padding: 26px 14px;
		color: inherit;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	/* Hover only where a pointer hovers: a tap must not leave the row inverted. */
	@media (hover: hover) {
		.project:hover {
			background: var(--color-ink);
			color: var(--color-paper);
		}

		.project:hover .dim {
			color: var(--color-on-ink-muted);
		}

		.project:hover .project-year > [aria-hidden] {
			color: var(--color-accent);
		}
	}

	.project-number {
		grid-column: span 1;
		font-size: 13px;
	}

	.project-name {
		grid-column: span 4;
		margin: 0;
		font-size: clamp(24px, 2.5vw, 36px);
		line-height: 1.05;
		font-weight: 700;
		font-stretch: 80%;
		letter-spacing: -0.015em;
		overflow-wrap: anywhere;
	}

	.project-description {
		grid-column: span 4;
		margin: 0;
		font-size: 16px;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.project-stack {
		grid-column: span 2;
		margin: 0;
		font-size: 12px;
		line-height: 1.6;
	}

	.project-year {
		grid-column: span 1;
		text-align: right;
		font-size: 13px;
		white-space: nowrap;
	}

	@media (min-width: 861px) and (max-width: 1100px) {
		.project-name {
			grid-column: 2 / span 5;
		}

		.project-description {
			grid-column: 7 / span 6;
		}

		.project-stack {
			grid-column: 2 / span 9;
		}

		.project-year {
			grid-column: 11 / span 2;
		}
	}

	/* Stack */

	.stack-note {
		margin: 22px 0 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	/* Contact */

	.contact-section {
		padding: clamp(72px, 9vw, 136px) 0 clamp(56px, 6vw, 96px);
	}

	.contact {
		row-gap: 18px;
	}

	.contact-body {
		grid-column: 2 / span 11;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
	}

	.contact-wq {
		margin: 0;
		font-size: clamp(88px, 14vw, 216px);
		line-height: 0.78;
		font-weight: 900;
		font-stretch: 62%;
		/* Its descender runs into the lede: in ink, the two would merge; ink keeps 5:1 over this shade. */
		color: var(--color-accent-display);
	}

	.contact-lede {
		margin: 0;
		font-size: clamp(20px, 2vw, 28px);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.contact-mail {
		max-width: 100%;
		/* Down to 22px rather than 30px: the address stays on one line on a 320px phone. */
		font-size: clamp(22px, 6.2vw, 92px);
		line-height: 1.05;
		font-weight: 900;
		font-stretch: 70%;
		letter-spacing: -0.02em;
		text-decoration: none;
		background-image: linear-gradient(currentColor, currentColor);
		background-size: 0 0.06em;
		background-position: 0 100%;
		background-repeat: no-repeat;
		transition: background-size 0.35s ease;
	}

	.contact-mail:hover {
		background-size: 100% 0.06em;
		color: var(--color-ink);
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 28px;
		margin-top: 10px;
		font-size: 16px;
		font-weight: 500;
	}

	.contact-links a {
		text-underline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}

		.contact-mail {
			transition: none;
		}
	}
</style>
