---
import { Font } from 'astro:assets';
import { identity, pageMeta, type ShareImage } from '../data/profile';
import { person } from '../lib/structured-data';

interface Props {
	/** Sans les paramètres suivants, la page reprend les valeurs de l'accueil. */
	title?: string;
	description?: string;
	shareImage?: ShareImage;
	/** Type Open Graph : l'accueil présente un profil, une fiche un site (`website`). */
	ogType?: 'profile' | 'website';
	/** Données structurées schema.org de la page (JSON-LD). */
	structuredData?: Record<string, unknown>;
}

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const {
	title = pageMeta.title,
	description = pageMeta.description,
	shareImage = pageMeta.shareImage,
	ogType = 'profile',
	structuredData = { '@context': 'https://schema.org', ...person(Astro.site) },
} = Astro.props;
const shareImageUrl = new URL(shareImage.path, Astro.site).href;
// `<` échappé : aucune valeur ne peut fermer la balise <script> avant l'heure.
const jsonLd = JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content={pageMeta.themeColor} />
		{/* `sizes` sur le .ico : sans lui, Chrome le préfère au SVG. */}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(shareImage.width)} />
		<meta property="og:image:height" content={String(shareImage.height)} />
		<meta property="og:image:alt" content={shareImage.alt} />
		{
			ogType === 'profile' && (
				<>
					<meta property="profile:first_name" content={identity.givenName} />
					<meta property="profile:last_name" content={identity.familyName} />
				</>
			)
		}
		{/* X reprend titre, description et image d'Open Graph : seul le format de carte lui est propre. */}
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={jsonLd} />
		{/* Seule la romaine d'Archivo est préchargée : c'est elle qui dessine le héros. */}
		<Font cssVariable="--font-archivo" preload={[{ style: 'normal', subset: 'latin' }]} />
		<Font cssVariable="--font-mono" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Valeurs reprises à l'identique de la maquette D1 · Activité. */
	:root {
		--bg: #f3f3ef;
		--ink: #111110;
		--muted: #5f5f5a;
		--rule: #d6d6d0;
		/* Papier des cartes de figure, plus clair que le fond. */
		--paper: #fbfbfa;
		--accent: #2433ff;
		--accent-light: #8e9bff;
		/* Bleu appuyé (survol d'une commande, encre des chaînes de code) et son lavis. */
		--accent-deep: #1b26c9;
		--accent-wash: #e2e5ff;
		--on-ink-muted: #bdbdb6;
		--stack-sep: #a3a39c;
		--status-segment: #2a2a28;
		--heat-0: #e3e3dd;
		--heat-1: #8e9bff;
		--heat-2: #5b6bff;
		--heat-3: #2b3bf5;
		--heat-4: #161f9e;

		--container: 1440px;
		--page-margin: clamp(16px, 4vw, 56px);
		--gutter: 24px;
		--status-height: 30px;

		--font-sans: var(--font-archivo);
	}

	*,
	::before,
	::after {
		box-sizing: border-box;
	}

	html {
		background: var(--bg);
		/* La barre d'état collée en bas masquerait l'élément qui reçoit le focus au clavier :
		   le défilement le garde au-dessus d'elle, contour compris (WCAG 2.4.11). */
		scroll-padding-bottom: calc(var(--status-height) + 8px);
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.5;
	}

	a {
		color: var(--ink);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.mono {
		font-family: var(--font-mono);
	}

	/* Conteneur de contenu : plafonné à 1440 px, centré. Les bandes pleine largeur
	   (bandeau, barre d'état) restent en dehors. */
	.container {
		max-width: var(--container);
		margin: 0 auto;
		padding: 0 var(--page-margin);
	}

	/* Grille de 12 colonnes. Mobile-first : chaque enfant occupe toute la largeur,
	   les composants placent leurs colonnes à partir de 600 / 1024 px. */
	.grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
	}

	.grid > * {
		grid-column: 1 / -1;
	}
</style>
