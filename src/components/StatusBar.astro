---
interface Props {
	/** Contributions GitHub sur 12 mois. */
	contributions: number;
}

const { contributions } = Astro.props;
const total = new Intl.NumberFormat('fr-FR').format(contributions);
---

<footer class="mono status">
	<div class="side">
		<span class="seg mode">NORMAL</span>
		<span class="seg dark branch">
			<svg
				aria-hidden="true"
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				><circle cx="6" cy="5" r="2.2"></circle><circle cx="6" cy="19" r="2.2"></circle><circle
					cx="18"
					cy="8"
					r="2.2"></circle><path d="M6 7.2v9.6M18 10.2c0 4-6 3.5-11 6.8"></path></svg
			>
			<span>main</span>
		</span>
		<span class="seg path">~/louis/portfolio.md</span>
	</div>
	<div class="side right">
		<span class="seg secondary">{total} contributions · 12 mois</span>
		<span class="seg dark">Bas</span>
		<span class="seg mode">:wq</span>
	</div>
</footer>

<style>
	.status {
		position: sticky;
		bottom: 0;
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		height: var(--status-height);
		background: var(--ink);
		color: var(--bg);
		font-size: 12px;
		line-height: var(--status-height);
	}

	.side {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}

	.right {
		flex-shrink: 0;
	}

	.seg {
		padding: 0 14px;
		white-space: nowrap;
	}

	.mode {
		background: var(--accent);
		color: #ffffff;
		font-weight: 700;
	}

	.dark {
		background: var(--status-segment);
	}

	.branch {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.path {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.secondary {
		display: none;
		color: var(--on-ink-muted);
	}

	@media (min-width: 600px) {
		.secondary {
			display: block;
		}
	}
</style>
