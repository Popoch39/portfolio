---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
	/** Rang de la section dans la page (1 → « 01 »), ou repère texte affiché tel quel (« A »). */
	number: number | string;
}

// `class` et le reste des attributs (dont le `data-astro-cid-*` du parent) sont
// transmis pour que le parent place le numéro dans sa grille avec ses styles scopés.
const { number, class: className, ...rest } = Astro.props;
const label = typeof number === 'number' ? String(number).padStart(2, '0') : number;
---

<span class:list={['mono', 'section-number', className]} {...rest}
	><span class="dot" aria-hidden="true"></span>{label}</span
>

<style>
	.section-number {
		display: flex;
		align-items: center;
		gap: 8px;
		height: fit-content;
		font-size: 13px;
		line-height: var(--section-number-line);
	}

	.dot {
		flex-shrink: 0;
		width: var(--section-dot);
		height: var(--section-dot);
		background: var(--accent);
	}
</style>
