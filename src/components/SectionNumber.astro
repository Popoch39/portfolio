---
import { twoDigits } from '../data/profile';

interface Props {
	number: number;
}

const { number } = Astro.props;
---

{/* Numbering is decorative: the heading that follows names the section. */}
<span class="section-number mono" aria-hidden="true"><span class="square"></span>{twoDigits(number)}</span>

<style>
	.section-number {
		grid-column: span 1;
		display: flex;
		align-items: center;
		gap: 8px;
		height: fit-content;
		font-size: 13px;
	}

	.square {
		width: 9px;
		height: 9px;
		background: var(--color-accent);
	}
</style>
