---
/** Vim block cursor after a display title, sized in `em` against it. */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'>;
---

<span class="cursor" aria-hidden="true" {...Astro.props}></span>

<style>
	.cursor {
		display: inline-block;
		width: 0.3em;
		height: 0.7em;
		margin-left: 0.05em;
		background: var(--color-accent);
	}
</style>
