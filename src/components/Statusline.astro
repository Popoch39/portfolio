---
/**
 * Vim-like statusline, fixed to the bottom of the window. Decorative, hidden from assistive
 * technologies, but for the Pause. Outside the smoothed content, otherwise its transform would carry it along.
 */
interface Props {
	/** The page has loops to stop (the marquee, the lede): the statusline carries the Pause (WCAG 2.2.2). */
	pause?: boolean;
}

const { pause = false } = Astro.props;
---

<div id="statusline" class="statusline mono" data-intro="statusline">
	<div class="side">
		{/* The home page's lede types in Vim: its mode is echoed here (`src/lede/typist.ts`). */}
		<span class="mode" aria-hidden="true" data-vim-mode>NORMAL</span>
		{
			pause && (
				<label class="pause">
					{/* Native: it stops the marquee without JS (`:has()`), the lede follows it (`src/lede/typist.ts`). */}
					<input id="pause" type="checkbox" autocomplete="off" />
					<span class="pause-box" aria-hidden="true" />
					pause<span class="visually-hidden"> des animations</span>
				</label>
			)
		}
		<span class="segment branch" aria-hidden="true">
			<svg
				width="12"
				height="12"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				><circle cx="6" cy="5" r="2.2"></circle><circle cx="6" cy="19" r="2.2"></circle><circle
					cx="18"
					cy="8"
					r="2.2"></circle><path d="M6 7.2v9.6M18 10.2c0 4-6 3.5-11 6.8"></path></svg
			>
			<span>main</span>
		</span>
		<span class="file" aria-hidden="true">~/louis/portfolio.md<span data-vim-modified hidden> [+]</span></span>
	</div>
	<div class="side" aria-hidden="true">
		<span class="encoding">utf-8 · markdown</span>
		<span class="segment">Bas</span>
		<span class="mode">:wq</span>
	</div>
</div>

<style>
	.statusline {
		position: fixed;
		inset: auto 0 0;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		align-items: stretch;
		/* The row, then the ink carried on under the home indicator and beside a notch, like a native tab bar. */
		height: var(--statusline-row);
		padding: 0 env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
		background: var(--color-ink);
		color: var(--color-paper);
		font-size: 12px;
		line-height: var(--statusline-row);
		/* Decorative: a long press must not select it. */
		-webkit-user-select: none;
		user-select: none;
	}

	.side {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}

	.side:last-child {
		flex-shrink: 0;
	}

	.side > * {
		padding: 0 14px;
	}

	.mode {
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-weight: 700;
	}

	.mode[data-mode='INSERT'] {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.segment {
		background: var(--color-bar);
	}

	/* A Markdown task box, ticked while paused: the state reads without colour too. */
	.pause {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1ch;
		cursor: pointer;
	}

	/* The native box spans the whole segment, invisible: it keeps the keyboard, the click and the state. */
	.pause input {
		position: absolute;
		inset: 0;
		margin: 0;
		appearance: none;
		cursor: inherit;
	}

	.pause-box::before {
		content: '[ ]';
	}

	.pause input:checked ~ .pause-box::before {
		content: '[x]';
	}

	/* Paused: the segment turns to paper, like a mode that holds. */
	.pause:has(input:checked) {
		background: var(--color-paper);
		color: var(--color-ink);
	}

	/* Drawn in the text's colour: it keeps the label's contrast whatever the state. */
	.pause:has(input:focus-visible) {
		outline: 2px solid currentColor;
		outline-offset: -5px;
	}

	@media (hover: hover) and (pointer: fine) {
		.pause:hover:not(:has(input:checked)) {
			background: var(--color-bar);
		}
	}

	.pause:active:not(:has(input:checked)) {
		background: var(--color-bar);
	}

	.branch {
		display: flex;
		align-items: center;
		gap: 7px;
	}

	.file {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.encoding {
		color: var(--color-on-ink-muted);
	}

	@media (max-width: 860px) {
		.encoding {
			display: none;
		}
	}
</style>
