---
import { marqueeWords } from '../data/profile';
---

{/* Décoratif : les mêmes technologies sont lisibles dans les projets et la stack. Figé
    (spec #1) : chaque mot une seule fois, ce qui dépasse de l'écran est masqué. */}
<ul class="marquee" aria-hidden="true">
	{marqueeWords.map((word) => <li class="word">{word}</li>)}
</ul>

<style>
	.marquee {
		display: flex;
		/* Chaque mot n'apparaît qu'une fois : au-delà de ~2400 px ils ne remplissent pas
		   la bande, on les répartit. Quand ils débordent, l'espace libre est négatif et
		   `space-between` revient à un alignement au début. */
		justify-content: space-between;
		margin: 0;
		padding: 0;
		overflow: hidden;
		list-style: none;
		background: var(--ink);
		color: var(--bg);
	}

	.word {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 26px;
		padding: 18px 0 18px 26px;
		font-size: clamp(22px, 2.6vw, 38px);
		font-weight: 700;
		font-stretch: 72%;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.word::after {
		content: '/';
		color: var(--accent-light);
	}
</style>
