---
/**
 * The hero (E2 · Établi, ADR 0012): Besançon and its coordinates, the name, the lede and the actions on
 * the left; the Établi, a keyboard put together part by part, on the right (between the name and the
 * lede on a phone). When the assembly plays
 * (`html.intro`), the text follows the build: the name with the case, the lede with the plate, the
 * actions with the clips.
 */
import { person } from '../data/profile';
import { coordinates } from '../hero/coordinates';
import { dictionary, type Lang } from '../i18n';
import Etabli from './Etabli.astro';
import Lede from './Lede.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = dictionary(lang).hero;
const { latitude, longitude } = coordinates(lang);
const mailto = `mailto:${person.email}`;
---

{
	/*
	 * The Établi between the name and the lede, in the page's order as on a phone, where it shows on the
	 * first screen there; a wider window sets it in the right half (`.hero-grid`).
	 */
}
<div class="hero-grid" data-hero>
	<div class="hero-head">
		<p class="mono hero-mark tx" style="--td: 0">
			<svg class="hero-pin" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
				<circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1"></circle>
				<circle cx="7" cy="7" r="2.6" fill="currentColor"></circle>
			</svg>
			<span class="hero-city">{person.city}</span>
			<span>{latitude} · {longitude}</span>
		</p>
		<h1 id="hero-title" class="hero-title" data-given={person.givenName} data-family={person.familyName}>
			<span class="hero-line tx" style="--td: 0.1">{person.givenName}</span>{' '}
			<span class="hero-line tx" style="--td: 0.3">{person.familyName}</span>
		</h1>
	</div>
	<div class="hero-bench">
		<Etabli lang={lang} />
	</div>
	<div class="hero-body">
		<Lede lang={lang} />
		<div class="hero-actions">
			<a class="button tx" href={mailto} style="--td: 2.95"
				><span data-ag-host="label">{t.write}</span><span class="visually-hidden">{t.writeHidden}</span>
				<span class="mono" aria-hidden="true" data-ag-with>:wq</span></a
			>
			<a class="hero-github tx" href={person.github.url} rel="me" style="--td: 3.1"
				>GitHub <span aria-hidden="true">↗</span></a
			>
		</div>
	</div>
</div>

<style>
	/*
	 * The text's two blocks stacked in the left half, the Établi across both rows in the right one. The
	 * outer rows take what is left over, so that the text stands centred against the bench.
	 */
	.hero-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: 1fr auto auto 1fr;
		column-gap: var(--grid-gap);
		width: 100%;
		padding: 40px 0;
	}

	.hero-head,
	.hero-body {
		grid-column: 1 / span 6;
		min-width: 0;
	}

	.hero-head {
		grid-row: 2;
	}

	.hero-body {
		/* The lede's screencast keys hang under the column (`Lede.astro`). */
		position: relative;
		grid-row: 3;
	}

	/* Above the text: the parts start all over the hero, over the name too; only the page's edge clips them. */
	.hero-bench {
		position: relative;
		z-index: 1;
		grid-column: 7 / span 6;
		grid-row: 1 / -1;
		align-self: center;
		min-width: 0;
	}

	.hero-mark {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0;
		font-size: 12px;
		line-height: 1.6;
		color: var(--color-ink-muted);
	}

	.hero-pin {
		flex: none;
		color: var(--color-accent);
	}

	.hero-city {
		color: var(--color-ink);
	}

	.hero-title {
		margin: 22px 0 0;
		font-size: clamp(52px, 9vw, 128px);
		font-weight: 800;
		font-stretch: 75%;
		line-height: 0.88;
		letter-spacing: -0.03em;
	}

	.hero-line {
		display: block;
	}

	/*
	 * The name out of register: a second plate of each line, in the accent, lies under the ink and
	 * slips off it at a press on « Écrire » (`src/hero/register.ts` sets `data-slipped` on the hero).
	 * Generated from the title's attributes, with an empty alternative text: the name is neither read
	 * nor found twice. A browser without that syntax draws no plate.
	 */
	.hero-title {
		position: relative;
		/* Its own stacking context: the plates go under the name's ink, not under the page. */
		isolation: isolate;
	}

	.hero-title::before,
	.hero-title::after {
		position: absolute;
		left: 0;
		z-index: -1;
		line-height: 0.88;
		/*
		 * The accent carries no text on the paper, but for two display exceptions (ADR 0006): the giant
		 * `:wq`, and this plate, shown for a moment only and never read. Like the `:wq`, it takes the
		 * display shade, which holds the large-text floor on every paper.
		 */
		color: var(--color-accent-display);
		pointer-events: none;
		opacity: 0;
	}

	.hero-title::before {
		content: attr(data-given) / '';
		top: 0;
	}

	.hero-title::after {
		content: attr(data-family) / '';
		bottom: 0;
	}

	/*
	 * A misregistration, not a slide: the plate stands off for a few frames (one alone would not be
	 * seen), then is back in a blink, with no overshoot. The curve only shapes the way back.
	 */
	:global([data-hero][data-slipped]) .hero-title::before,
	:global([data-hero][data-slipped]) .hero-title::after {
		animation: register-slip 0.18s cubic-bezier(0.2, 0, 0, 1);
	}

	@keyframes register-slip {
		0%,
		55% {
			opacity: 1;
			transform: translate(0.055em, -0.04em);
		}

		100% {
			opacity: 1;
			transform: none;
		}
	}

	/* Reduced motion: the plate shows out of register for the same moment, then is gone. Nothing slides. */
	@media (prefers-reduced-motion: reduce) {
		:global([data-hero][data-slipped]) .hero-title::before,
		:global([data-hero][data-slipped]) .hero-title::after {
			animation-timing-function: step-end;
		}
	}

	.hero-body > :global(.hero-lede) {
		width: min(540px, 100%);
		margin-top: 32px;
	}

	/* Under the column, clear of the actions: a screencast's place. */
	.hero-body :global(.keys) {
		left: 0;
		top: calc(100% + 16px);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 28px;
		margin-top: 36px;
	}

	/*
	 * The label and its mark in Fragment Mono, one size, as the Anagramme's board draws them: the mark
	 * stands the label's columns and the button's gap from its start, a place the build knows (ADR 0011).
	 */
	.hero-actions .button {
		font-family: var(--font-mono);
		font-size: 15px;
		font-weight: 400;
	}

	.hero-actions .button .mono {
		font-size: inherit;
	}

	.hero-github {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 600;
		text-underline-offset: 4px;
	}

	/* The text follows the build (`Etabli.astro`), each line at its moment in the mockup. */
	.hero-body :global(.sentence-box) {
		--td: 1.5;
	}

	.hero-body :global(.version) {
		--td: 1.75;
	}

	/*
	 * Not from 0: the browser does not count text at zero opacity as painted, and the lede, the page's
	 * largest text, would be its LCP only once it rises, 1.5 s in. One percent reads as nothing.
	 */
	@keyframes hero-rise {
		from {
			opacity: 0.01;
			transform: translateY(18px);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html.intro) .tx,
		:global(html.intro) .hero-body :global(.sentence-box),
		:global(html.intro) .hero-body :global(.version) {
			animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--td) * 1s) backwards;
		}
	}

	/*
	 * Narrow screens: one column in the page's order, the bench between the name and the lede so that the
	 * assembly plays on the first screen. Drawn a gutter further left as on the mockup, and the paper
	 * round the board (a fifth of the drawing above and below it) tucked under its neighbours.
	 */
	@media (max-width: 860px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
			padding: 28px 0;
		}

		.hero-head,
		.hero-body,
		.hero-bench {
			grid-column: 1 / -1;
			grid-row: auto;
		}

		.hero-bench :global(.bench) {
			margin: -13% 0 -14% calc(-1 * var(--page-gutter));
		}
	}
</style>
