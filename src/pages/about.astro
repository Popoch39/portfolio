---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About · Astro Basics" description="About this portfolio, a second page reached from the home page.">
	<main>
		<h1>About</h1>
		<p>A second page: going back and forth with the home page is a full page load.</p>
		<p><a href="/">Home</a></p>
	</main>
</Layout>

<style>
	main {
		font-family: var(--police-texte);
		max-width: 40rem;
		margin: 0 auto;
		padding: 16px;
	}

	p {
		color: var(--couleur-texte-secondaire);
		font-size: 16px;
		line-height: 24px;
	}

	a {
		color: var(--couleur-lien);
	}
</style>
