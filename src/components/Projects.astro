---
import SectionHeader from './SectionHeader.astro';
import FigureCard from './FigureCard.astro';
import GrainPatterns from './GrainPatterns.astro';
import { projects, publicRepoCount, restFigurePath, sections, type Project } from '../data/profile';
import { anatomyOf } from '../anatomies/registry';
import { fiche, localeOf, pathOf, ui } from '../lib/i18n';
import { projectsPreviewId } from '../lib/transition';

const locale = localeOf(Astro.currentLocale);
const { id, label } = sections.projects;
const hrefOf = (p: Project) => pathOf(fiche(p.slug), locale);
const numberOf = (index: number) => String(index + 1).padStart(2, '0');

/** La bascule A3 : grand écran, pointeur qui survole, JavaScript actif. La CSS ci-dessous en garde une copie. */
const A3 = '(min-width: 1024px) and (hover: hover) and (scripting: enabled)';
---

<section id={id[locale]} class="projects">
	<SectionHeader number={1} title={label[locale]} note={ui.projectsNote[locale](projects.length, publicRepoCount)} />
	<div class="grid layout">
		<ol class="list">
			{
				projects.map((p, i) => (
					<li class="item" data-word-frame>
						{/* Les `{' '}` font lire le lien « 01 typomaniac … » et non « 01typomaniac… ». */}
						<a class="grid row" href={hrefOf(p)} data-selected={i === 0 ? '' : undefined}>
							<span class="mono num">{numberOf(i)}</span>{' '}
							<span class="name" data-word={hrefOf(p)}>{p.repo}</span>{' '}
							<span class="desc">{p.description[locale]}</span>{' '}
							<span class="mono stack">{p.stack.join(' · ')}</span>{' '}
							<span class="mono year">{p.year} →</span>
						</a>
					</li>
				))
			}
		</ol>
		{/* L'aperçu A3 : un panneau par projet, seul l'actif est visible. Sa description et sa stack
		    doublent celles de la ligne, que les technologies d'assistance lisent déjà. */}
		<div id={projectsPreviewId} class="preview">
			{
				projects.map((p, i) => {
					const anatomy = anatomyOf(p, locale);
					const { content } = anatomy;
					const { width, height } = anatomy.renderRest();
					return (
						<div class="panel" data-panel={p.slug} data-active={i === 0 ? '' : undefined}>
							<FigureCard
								fig={numberOf(i)}
								title={content.machine}
								consignes={content.consignes}
								releve={content.releve}
								motion={anatomy.motion}
								image={{ src: restFigurePath(p, locale), media: A3, width, height, alt: content.label }}
								fixed
							/>{' '}
							<p class="preview-desc" aria-hidden="true">{p.description[locale]}</p>{' '}
							<div class="mono preview-foot">
								<span aria-hidden="true">{p.stack.join(' · ')}</span>{' '}
								<a class="open" href={hrefOf(p)} aria-label={ui.openFicheLabel[locale](p.repo)}>{ui.openFiche[locale]}</a>
							</div>
						</div>
					);
				})
			}
		</div>
	</div>
	{/* Les panneaux insérés par l'aperçu laissent leurs trames : celles de la page servent à tous. */}
	<GrainPatterns />
</section>

<script>
	// L'amorce de l'aperçu A3, seul script que télécharge l'accueil hors de l'A3 : l'aperçu, et avec
	// lui le chargeur des fiches et la mise en avant des pièces, n'est importé qu'une fois la bascule
	// vérifiée. Elle est celle de l'image au repos des panneaux : une seule requête pour les deux.
	// L'écouteur de la Lunette passe aussi par ce module, le seul de l'accueil (ADR 0007).
	import '../lunette/keys.ts';

	// Par sa classe : l'ancre de la section change avec la langue.
	const section = document.querySelector<HTMLElement>('section.projects');
	const a3 = matchMedia(section?.querySelector<HTMLSourceElement>('[data-panel] source')?.media || 'not all');
	if (section) {
		// Tout de suite en A3, ou quand une fenêtre élargie après coup y passe.
		const wake = () => {
			if (!a3.matches) return;
			a3.onchange = null;
			void import('./preview.ts').then((module) => module.preview(section));
		};
		a3.onchange = wake;
		wake();
	}

	// Le Glissé de la molette (ADR 0013), et la Plongée là où sa CSS ne joue pas (Firefox) : son repli,
	// jamais en mouvement réduit (ADR 0009). L'un et l'autre ne sont demandés qu'une fois la première
	// image peinte, pour ne pas la retarder. La condition du repli est celle du `@supports` de la scène,
	// mot pour mot : aucun navigateur ne reste sans la scène ni son repli. Ils passent par ce module, le
	// seul de l'accueil (ADR 0007) : un script dans la Plongée en ferait un second.
	// La Traîne de la Visite (ADR 0012) passe par le même chemin ; elle ne décale sa piste que là où la
	// Visite joue.
	const fallback =
		!CSS.supports('(animation-timeline:view()) and (animation-range:entry) and (timeline-scope:--dive)') &&
		!matchMedia('(prefers-reduced-motion)').matches;
	requestAnimationFrame(() =>
		setTimeout(() => {
			void import('../lib/glide.ts');
			void import('./trail.ts');
			if (fallback) void import('./dive.ts');
		}),
	);
</script>

<style>
	.projects {
		padding-top: var(--projects-top);
	}

	/* Lettre à lettre (ADR 0004) : l'en-tête et l'aperçu s'écartent chacun de son côté. Nommés le temps
	   de la transition seulement : un nom fait de l'élément un contexte d'empilement. */
	:global(:root:active-view-transition) .projects > :global(.section-header) {
		view-transition-name: projects-head;
	}

	:global(:root:active-view-transition) .preview {
		view-transition-name: preview;
	}

	.list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		border-bottom: 1px solid var(--rule);
	}

	/* Les 14 px débordants de la maquette élargissent la zone du lien (et son focus)
	   sans décaler le texte. */
	.row {
		row-gap: 8px;
		align-items: baseline;
		margin: 0 -14px;
		padding: 26px 14px;
		color: inherit;
		text-decoration: none;
	}

	/* Sous ~475 px, la ligne touche presque le bord de l'écran : un contour extérieur y perd
	   ses côtés et ne se lit plus que comme deux filets. Rentré dans le padding, il reste entier. */
	.row:focus-visible {
		outline-offset: -2px;
	}

	.num,
	.year {
		font-size: 13px;
	}

	.name {
		font-size: clamp(24px, 2.5vw, 36px);
		line-height: 1.05;
		font-weight: 700;
		font-stretch: 80%;
		letter-spacing: -0.015em;
		overflow-wrap: anywhere;
	}

	.desc {
		font-size: 16px;
		line-height: 1.45;
		color: var(--muted);
		text-wrap: pretty;
	}

	.stack {
		font-size: 12px;
		line-height: 1.6;
		color: var(--muted);
	}

	.year {
		white-space: nowrap;
	}

	/* Hors de l'A3, l'aperçu n'existe pas, et la source de ses images ne vaut pas : rien n'est demandé. */
	.preview {
		display: none;
	}

	/* Les panneaux s'empilent dans la même case : l'aperçu prend la hauteur du plus grand, et
	   changer de projet ne change pas sa taille. */
	.preview {
		grid-template: 'panel' / minmax(0, 1fr);
	}

	.panel {
		grid-area: panel;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.panel:not([data-active]) {
		visibility: hidden;
	}

	/* Masquée par `visibility`, l'image au repos d'un panneau inactif serait chargée quand même, et
	   chaque SVG au repos est analysé sur le thread principal (90 ms pour les six à CPU ×1, 560 ms à
	   CPU ×6) au milieu de la Plongée. Hors du rendu, une image différée n'est pas demandée : seule
	   celle du panneau actif l'est, les autres arrivent insérées par le script de l'aperçu. La scène
	   garde ses dimensions par son rapport 4:3. Le sélecteur est plus précis que le `display: block`
	   de la carte, qui l'emporterait sinon. */
	.preview .panel:not([data-active]) :global(.scene img) {
		display: none;
	}

	.preview-desc {
		margin: 0;
		font-size: 17px;
		line-height: 1.45;
		text-wrap: pretty;
	}

	/* Collé au bas de la case commune : une description plus longue que les autres ne déplace pas
	   « Ouvrir la fiche » d'un projet à l'autre. */
	.preview-foot {
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 8px 20px;
		font-size: 12px;
		color: var(--muted);
	}

	.open {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 16px;
		background: var(--ink);
		color: var(--bg);
		font-size: 13px;
		text-decoration: none;
	}

	/* Tablette : numéro + nom, puis description, stack et année sous le nom. */
	@media (min-width: 600px) {
		.num {
			grid-column: 1 / span 1;
		}

		.name {
			grid-column: 2 / -1;
		}

		.desc {
			grid-column: 2 / span 6;
		}

		.stack {
			grid-column: 8 / span 3;
		}

		.year {
			grid-column: 11 / span 2;
			text-align: right;
		}
	}

	/* Laptop et au-delà : la grille 1/4/4/2/1 de la maquette. */
	@media (min-width: 1024px) {
		.name {
			grid-column: 2 / span 4;
		}

		.desc {
			grid-column: 6 / span 4;
		}

		.stack {
			grid-column: 10 / span 2;
		}

		.year {
			grid-column: 12 / span 1;
		}
	}

	/* A3 : grand écran, pointeur qui survole et JavaScript actif. Copie de la requête `A3` du
	   composant, que le script lit sur l'image au repos. Les lignes compactes à gauche,
	   l'aperçu collant à droite. La sélection (`data-selected`, `data-active`) est posée par le
	   script ; le projet 01 l'a dès le build. */
	@media (min-width: 1024px) and (hover: hover) and (scripting: enabled) {
		.layout {
			column-gap: clamp(24px, 4vw, 56px);
			align-items: start;
		}

		.list {
			grid-column: 1 / span 6;
		}

		.preview {
			display: grid;
			grid-column: 7 / span 6;
			position: sticky;
			top: 24px;
			padding-top: 24px;
		}

		.row {
			position: relative;
			display: flex;
			gap: 20px;
			padding-block: 22px;
		}

		.num {
			flex: 0 0 48px;
			display: flex;
			align-items: center;
			gap: 8px;
			color: var(--muted);
		}

		.name {
			flex: 1 1 0;
			min-width: 0;
			font-size: clamp(26px, 2.8vw, 40px);
			color: var(--muted);
		}

		/* La description et la stack restent dans la ligne pour les lecteurs d'écran et les
		   moteurs, masquées à l'œil : l'aperçu les montre. */
		.desc,
		.stack,
		.row[data-selected] .year {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		/* L'année et « Anatomie → » occupent la même largeur : sélectionner une ligne ne fait
		   pas passer son nom à la ligne. */
		.year,
		.row[data-selected]::after {
			flex: 0 0 10ch;
			font-size: 12px;
			text-align: right;
			white-space: nowrap;
		}

		.year {
			color: var(--muted);
		}

		.row[data-selected] .num,
		.row[data-selected]::after {
			color: var(--accent);
		}

		.row[data-selected] .name {
			color: var(--ink);
		}

		.row[data-selected] .num::after {
			content: '';
			width: 7px;
			height: 7px;
			background: var(--accent);
		}

		/* Repère visuel seul : le lien se lit toujours avec son année. */
		.row[data-selected]::after {
			content: 'Anatomie →';
			content: 'Anatomie →' / '';
			font-family: var(--font-mono);
		}

		/* La CSS ne lit pas le dictionnaire : la version anglaise a sa propre mention. */
		.row[data-selected]:lang(en)::after {
			content: 'Anatomy →';
			content: 'Anatomy →' / '';
		}
	}
</style>
