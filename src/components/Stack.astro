---
// Section 04 · Stack (planche 34 · Atome, visite guidée, spec #80) : l'Atome à gauche, sa légende à droite,
// les outils du quotidien dessous ; sous 900 px de large, l'Atome passe au-dessus de la légende. La
// légende est la liste de définitions lue par les lecteurs d'écran ; l'Atome, décoratif, en est le dessin.
import SectionHeader from './SectionHeader.astro';
import Atom from './Atom.astro';
import { identity, stack, dailyTools, sections } from '../data/profile';
import { localeOf, ui } from '../lib/i18n';

const locale = localeOf(Astro.currentLocale);
const { id, label } = sections.stack;
---

<section id={id[locale]} class="stack">
	<div class="stage">
		<SectionHeader number={4} title={label[locale]} note=":set stack?" />
		<div class="scene">
			<div class="atom-box">
				<Atom />
			</div>
			<dl class="legend">
				{
					stack.map((category, k) => (
						<div class:list={['line', { accent: category.ring.accent }]}>
							<dt class="mono family">
								<span class="number" aria-hidden="true">
									{String(k + 1).padStart(2, '0')}
								</span>
								{category.label[locale]}
							</dt>
							<dd class="items">
								{/* Espace insécable avant « / » : la barre ne commence jamais une ligne. Les
								   vrais espaces hors du séparateur masqué gardent les mots distincts à l'oral. */}
								{category.items.map((item, i) => (
									<Fragment>
										{i > 0 && (
											<Fragment>
												{' '}
												<span class="sep" aria-hidden="true">/</span>{' '}
											</Fragment>
										)}
										<span>{item.name}</span>
									</Fragment>
								))}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
		<p class="mono tools">
			{dailyTools.map((tool) => ui.dailyTool[locale](tool.role[locale], tool.name)).join(' · ')} —{' '}
			<a href={identity.links.nvimConfig}>{ui.configOnGitHub[locale]}</a>
		</p>
	</div>
</section>

<style>
	.stack {
		padding-top: clamp(64px, 8vw, 120px);
	}

	/* L'Atome posé tient dans 330 × 300 px autour de son centre. Plus étroite, la colonne le réduit à sa
	   largeur : `tan(atan2(a, b))` est le seul quotient de deux longueurs que la CSS sache écrire partout. */
	.scene {
		container-type: inline-size;
	}

	/* Les boîtes des Bagues, des carrés tournés en 3D, débordent le dessin : coupées en largeur, elles ne
	   font pas défiler la page de côté. */
	.atom-box {
		--atom-scale: min(1, tan(atan2(100cqw, 330px)));
		position: relative;
		overflow-x: clip;
		height: calc(300px * var(--atom-scale));
		margin: 28px 0 12px;
	}

	.atom-box > :global(.atom) {
		left: 50%;
		top: 50%;
		scale: var(--atom-scale);
	}

	.legend {
		margin: 0;
	}

	/* Le numéro sort de la colonne du texte, à gauche, comme sur la planche. */
	.line {
		position: relative;
		padding: 8px 0 9px 34px;
		border-top: 0.5px solid var(--stack-sep);
	}

	.number {
		position: absolute;
		left: 0;
		font-size: 11px;
		line-height: 16px;
		letter-spacing: 0;
	}

	.family {
		font-size: 10px;
		line-height: 16px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.accent .family {
		color: var(--accent);
	}

	.items {
		margin: 0;
		font-size: 15px;
		line-height: 21px;
		letter-spacing: -0.005em;
	}

	.sep {
		color: var(--stack-sep);
	}

	.tools {
		margin: 18px 0 0;
		font-size: 12px;
		line-height: 18px;
		color: var(--muted);
	}

	/* La mise en page de la planche, en 1280 × 800 : l'Atome centré à 340 px du bord (ou au milieu de sa
	   colonne si elle est plus étroite), à 290 px sous le filet ; la légende de 440 px à droite. */
	@media (min-width: 900px) {
		.scene {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 440px;
			min-height: 589px;
		}

		.atom-box {
			height: auto;
			margin: 0;
		}

		.atom-box > :global(.atom) {
			left: min(340px, 50%);
			top: 290px;
		}

		.legend {
			margin-top: 22px;
		}

		.line {
			padding: 10px 0 11px 34px;
		}

		.number {
			line-height: 18px;
		}

		.items {
			font-size: 16px;
			line-height: 22px;
		}

		.tools {
			margin: 0;
			text-align: right;
		}
	}
</style>
