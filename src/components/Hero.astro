---
import { identity } from '../data/profile';
import { localeOf, ui } from '../lib/i18n';

const locale = localeOf(Astro.currentLocale);
const { languages, sideLanguages, employer } = identity;
const lede = ui.heroLede[locale];
---

<section id="top" class="hero">
	<div class="mono topline">
		<span class="mode">-- NORMAL --</span>
		<span>portfolio · 2026</span>
	</div>
	<h1 class="title">
		{/* L'espace explicite garde « Louis Pocheron » lisible malgré les lignes en bloc. */}
		<span class="line">{identity.givenName}</span>{' '}<span class="line last">{identity.familyName}<span class="cursor" aria-hidden="true"></span></span>
	</h1>
	<div class="grid body">
		<p class="lede">{lede.before}<em>{lede.emphasis}</em>{lede.after}</p>
		<dl class="facts">
			<div>
				<dt class="mono">{ui.role[locale]}</dt>
				<dd>{identity.roleDetail[locale]}</dd>
			</div>
			<div>
				<dt class="mono">{ui.languages[locale]}</dt>
				<dd>{ui.languagesLine[locale](languages, sideLanguages)}</dd>
			</div>
			<div>
				<dt class="mono">{ui.today[locale]}</dt>
				<dd>{ui.employerLine[locale](employer.name, employer.city, employer.since)}</dd>
			</div>
		</dl>
		<div class="actions">
			<a class="write" href={`mailto:${identity.email}`}>{ui.write[locale]} <span class="mono">:wq</span></a>
			<a class="github" href={identity.links.github}>GitHub ↗</a>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Sert d'étalon au h1 : 100cqi = largeur du contenu. */
		container-type: inline-size;
		padding: clamp(28px, 4vw, 52px) 0 clamp(48px, 6vw, 88px);
	}

	.topline {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: clamp(14px, 2vw, 26px);
		font-size: 13px;
		color: var(--muted);
	}

	.mode {
		color: var(--ink);
	}

	.title {
		margin: 0;
		/* La maquette (clamp(72px, 22vw, 330px)) fait déborder « POCHERON » + curseur
		   (≈ 4,25 em) de la colonne de contenu à toutes les largeurs, et de la page sous
		   330 px. Le plafond en cqi garde la ligne dans le contenu, au plus près de la maquette. */
		font-size: min(22vw, 330px, 23.2cqi);
		line-height: 0.8;
		font-weight: 800;
		font-stretch: 62%;
		letter-spacing: -0.015em;
		text-transform: uppercase;
	}

	.line {
		display: block;
	}

	.last {
		white-space: nowrap;
	}

	/* Curseur figé : la maquette le fait clignoter, le spec le veut statique. */
	.cursor {
		display: inline-block;
		width: 0.3em;
		height: 0.7em;
		margin-left: 0.05em;
		background: var(--accent);
	}

	.body {
		row-gap: 32px;
		align-items: start;
		margin-top: clamp(32px, 4.5vw, 68px);
	}

	.lede {
		margin: 0;
		font-size: clamp(22px, 2.35vw, 34px);
		line-height: 1.2;
		letter-spacing: -0.012em;
		text-wrap: pretty;
	}

	.lede em {
		font-style: italic;
		color: var(--accent);
	}

	.facts {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		font-size: 15px;
		line-height: 1.4;
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.facts dt {
		font-size: 12px;
		color: var(--muted);
	}

	.facts dd {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
	}

	.write {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 0 20px;
		background: var(--ink);
		color: var(--bg);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	.write .mono {
		font-size: 13px;
		color: var(--on-ink-muted);
	}

	.github {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: 600;
		text-underline-offset: 4px;
	}

	@media (min-width: 600px) {
		.facts {
			grid-column: 1 / span 7;
		}

		.actions {
			grid-column: 9 / span 4;
		}
	}

	@media (min-width: 1024px) {
		.lede {
			grid-column: 1 / span 6;
		}

		.facts {
			grid-column: 8 / span 3;
		}

		.actions {
			grid-column: 11 / span 2;
		}
	}
</style>
