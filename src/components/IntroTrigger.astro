---
/**
 * Decides, before the first paint, whether the Établi's assembly plays (ADR 0012): the class it sets on
 * `<html>` starts the hero's animations from the very first frame, never after a flash of the page at
 * rest. Inline in the `<head>` of the home page only.
 * It is also the class's safety net: it owes nothing to the module that ends the opening, which may never run.
 */
import { END } from '../hero/etabli-timing';
import { inlineScriptHash } from './inline-script';

/**
 * The belt: past this many milliseconds, the class goes whatever the module does. The assembly, and a
 * margin for a slow phone's late first frame; the animations themselves end on their own.
 */
const BELT = END * 1_000 + 3_000;

const decide = `(() => {
	const navigation = performance.getEntriesByType('navigation')[0];
	const type = navigation && navigation.type;
	// Empty on a direct visit or a bookmark. The slash keeps out a host that merely starts the same.
	const fromThisSite = document.referrer.startsWith(\`\${location.origin}/\`);
	// A reload replays it, even when the page was first reached from another page of the site.
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	// A reload replays the assembly, which opens on the top of the page: the browser must not bring
	// back the scroll the visitor had left. It reads this mode as it was when the page was left,
	// so it is set for the next reload now, whether or not the assembly plays this time.
	// The price: a return through history that misses the back/forward cache lands at the top.
	history.scrollRestoration = reducedMotion ? 'auto' : 'manual';
	const skip =
		type === 'back_forward' ||
		location.hash !== '' ||
		(fromThisSite && type !== 'reload') ||
		reducedMotion;
	if (skip) return;
	const root = document.documentElement;
	root.classList.add('intro');
	setTimeout(() => root.classList.remove('intro'), ${BELT});
})();`;
Astro.csp?.insertScriptHash(inlineScriptHash(decide));
---

<script is:inline set:html={decide} />
