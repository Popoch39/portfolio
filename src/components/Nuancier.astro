---
/**
 * The Nuancier (03 · Nuancier, ADR 0009): a printer's swatch book riveted in the bottom corner of the
 * window, one strip per paper, each printed in its own paper so the fan reads the same on every theme.
 * The strips are native radios (`name="bg"`): the arrows move from one paper to the next, and the group
 * is named. Hidden without the script that paints the sky; shown, checked on the remembered choice and
 * with that strip at the front, by the inline script right after it, before the first paint.
 *
 * The book rests shut, the paper in force alone showing; it opens as the pointer comes over it, to the
 * keyboard, or on a tap, and shuts again on a pick. The choreography is `src/sky/nuancier.ts`.
 */
import { skyModes, type SkyMode } from '../sky/sky';
import { inlineScriptHash } from './inline-script';

const strips: Record<SkyMode, { code: string; name: string; hint: string; sub: string }> = {
	light: { code: 'EN-01', name: 'Jour', hint: 'toujours le jour', sub: '#efeee9' },
	dark: { code: 'EN-02', name: 'Nuit', hint: 'toujours la nuit', sub: '#141412' },
	'solarized-light': { code: 'EN-03', name: 'Solarized Light', hint: 'd’Ethan Schoonover', sub: '#fdf6e3' },
	auto: { code: 'EN-04', name: 'Auto', hint: 'suit le soleil à Besançon', sub: '' },
	nord: { code: 'EN-05', name: 'Nord', hint: 'd’Arctic Ice Studio', sub: '#2e3440' },
	'gruvbox-light': { code: 'EN-06', name: 'Gruvbox Light', hint: 'de morhetz', sub: '#fbf1c7' },
	'catppuccin-mocha': { code: 'EN-07', name: 'Catppuccin Mocha', hint: 'de Catppuccin', sub: '#1e1e2e' },
	'tokyo-night': { code: 'EN-08', name: 'Tokyo Night', hint: 'd’enkia', sub: '#1a1b26' },
};

// The chosen strip goes to the front, the others keep the fan's order behind it.
const show = `(() => {
	const fan = document.querySelector('[data-nuancier]');
	const bg = document.documentElement.dataset.bg;
	const inputs = [...fan.querySelectorAll('input')];
	const chosen = inputs.find((input) => input.value === bg) || inputs.find((input) => input.value === 'auto');
	chosen.checked = true;
	[...inputs.filter((input) => input !== chosen), chosen].forEach((input, slot) => {
		input.closest('[data-slot]').dataset.slot = slot;
	});
	fan.hidden = false;
})();`;
Astro.csp?.insertScriptHash(inlineScriptHash(show));
---

{/* The accent ring that rides the edge of the new paper as it spreads; drawn with the page, under the reveal. */}
<span class="ring" aria-hidden="true" data-nuancier-ring></span>
<fieldset class="fan" data-nuancier hidden>
	<legend class="visually-hidden">Papier du site</legend>
	{
		skyModes.map((value, index) => {
			const { code, name, hint, sub } = strips[value];
			// A two-word name runs too long for the spine: the family, then the variant beside it.
			const [family, variant] = name.split(' ');
			return (
				<div class="slot" data-slot={index}>
					<label class="lam" data-paper={value}>
						<input type="radio" name="bg" value={value} autocomplete="off" />
						<span class="visually-hidden">
							{name}, {hint}
						</span>
						<span class="head" aria-hidden="true">
							<span class="chip" />
							<span class="chip" />
							<span class="chip" />
						</span>
						<span class="code" aria-hidden="true">
							{code}
						</span>
						{variant ? (
							<span class="name" data-two aria-hidden="true">
								{family}
								<br />
								{variant}
							</span>
						) : (
							<>
								<span class="name" aria-hidden="true">
									{name}
								</span>
								<span class="sub" aria-hidden="true">
									{sub}
								</span>
							</>
						)}
						{value === 'auto' && <span class="sun" aria-hidden="true" />}
						<span class="hole" aria-hidden="true" />
						<span class="notch" aria-hidden="true" />
					</label>
				</div>
			);
		})
	}
	<span class="rivet" aria-hidden="true"></span>
</fieldset>
<script is:inline set:html={show} />

<script>
	import '../sky/nuancier';
</script>

<style>
	/*
	 * Sizes of the phone's board; a wider window takes the desktop's (below). Shut, the eight strips lie
	 * folded behind the front one and hidden: one target (WCAG 2.5.8), which is all Lighthouse measures.
	 * Open, they fan out into a full rosette, 45° apart, the front one upright: no strip covers another, so
	 * the browser's touch adjustment hands each tap to its own strip. A rosette does not fit in the corner:
	 * the book slides inward as it opens (`--open-x`, `--open-y`), to the middle of a phone's width.
	 */
	.fan {
		--width: 150px;
		--height: 160px;
		--strip-w: 40px;
		--strip-h: 124px;
		--pivot-y: 115px;
		--slot-left: 55px;
		--slot-bottom: 14px;
		--lift: -12px;
		--hover-lift: -10px;
		--launch: -56px;
		--from: -7deg;
		--step: 1deg;
		--scale: 1;
		--open-from: -315deg;
		--open-step: 45deg;
		--open-scale: 1;
		/*
		 * Open, each strip steps out from the rivet along its own axis, leaving the rosette's heart empty:
		 * pivoting at their feet, the strips would otherwise cover each other's names there. Their holes,
		 * no longer on the rivet, go.
		 */
		--out: 0px;
		--open-out: -40px;
		--holes: 1;
		/* From the rivet's place in the corner to the middle of the width, clear of the statusline. */
		--open-x: min(0px, calc(91px - 50vw));
		--open-y: -170px;
		--shift-x: 0px;
		--shift-y: 0px;

		position: fixed;
		right: calc(16px + env(safe-area-inset-right, 0px));
		bottom: calc(var(--statusline-height) + 16px);
		/* Above the page and the statusline, under the Intro's veil and the grain. */
		z-index: 1;
		width: var(--width);
		height: var(--height);
		min-inline-size: 0;
		margin: 0;
		padding: 0;
		border: 0;
		/* Only the strips take the pointer: the corner of the page around them stays clickable. */
		pointer-events: none;
		translate: var(--shift-x) var(--shift-y);
	}

	/*
	 * What holds a mouse over the open book: the rosette's disc, stretched back down to the corner it slid
	 * from, so that the pointer left behind on the shut strip keeps the book open while it moves. Stretched
	 * sideways as well as down: past 532px of window the book slides further than the disc is wide, and a
	 * pointer no longer held shuts it, which puts the strip back under the pointer, and so on at each frame.
	 */
	.fan::before {
		content: '';
		position: absolute;
		left: calc(var(--slot-left) + var(--strip-w) / 2 - 175px);
		top: calc(var(--height) - var(--slot-bottom) - var(--strip-h) + var(--pivot-y) - 175px);
		width: calc(350px - var(--open-x));
		height: calc(350px - var(--open-y));
		border-radius: 175px;
		visibility: hidden;
	}

	.fan[hidden] {
		display: none;
	}

	@media (min-width: 861px) {
		.fan {
			--width: 220px;
			--height: 220px;
			--strip-w: 44px;
			--strip-h: 120px;
			--pivot-y: 108px;
			--slot-left: 88px;
			--slot-bottom: 20px;
			--lift: -16px;
			--hover-lift: -12px;
			--launch: -64px;
			--open-x: -24px;
			--open-y: -130px;

			right: calc(48px + env(safe-area-inset-right, 0px));
			bottom: calc(var(--statusline-height) + 24px);
		}
	}

	/*
	 * A tap opens the book (`data-open`); the keyboard too, while a strip has its focus. Under a mouse it
	 * opens as the pointer comes over it, and once a strip has the pointer the whole book holds it: opening
	 * moves the strips from under the pointer, which would otherwise shut the book again, and so on.
	 */
	.fan[data-open],
	.fan:has(input:focus-visible) {
		--from: var(--open-from);
		--step: var(--open-step);
		--scale: var(--open-scale);
		--shift-x: var(--open-x);
		--shift-y: var(--open-y);
		--out: var(--open-out);
		--holes: 0;
		--hide-after: 0s;
	}

	@media (hover: hover) and (pointer: fine) {
		.fan:hover {
			--from: var(--open-from);
			--step: var(--open-step);
			--scale: var(--open-scale);
			--shift-x: var(--open-x);
			--shift-y: var(--open-y);
			--out: var(--open-out);
			--holes: 0;
			--hide-after: 0s;
			pointer-events: auto;
		}

		.fan:hover::before {
			visibility: visible;
		}
	}

	/*
	 * `--n` is the slot's rank from the back; the front one moves first as the book opens and shuts. The
	 * folded strips fade once they are behind the front one (`--hide-after`), and show at once to open.
	 * Faded, they take no pointer but stay in the group, for the arrows and for a screen reader.
	 */
	.slot {
		position: absolute;
		left: var(--slot-left);
		bottom: var(--slot-bottom);
		z-index: calc(var(--n) + 1);
		width: var(--strip-w);
		height: var(--strip-h);
		transform-origin: calc(var(--strip-w) / 2) var(--pivot-y);
		--angle: calc(var(--from) + var(--n) * var(--step));
		--delay: calc((7 - var(--n)) * 20ms);
		rotate: var(--angle);
		scale: var(--scale);
		opacity: 0;
		--events: none;
	}

	.slot[data-slot='0'] {
		--n: 0;
	}

	.slot[data-slot='1'] {
		--n: 1;
	}

	.slot[data-slot='2'] {
		--n: 2;
	}

	.slot[data-slot='3'] {
		--n: 3;
	}

	.slot[data-slot='4'] {
		--n: 4;
	}

	.slot[data-slot='5'] {
		--n: 5;
	}

	.slot[data-slot='6'] {
		--n: 6;
	}

	.slot[data-slot='7'] {
		--n: 7;
	}

	.slot[data-slot='7'],
	.fan[data-open] .slot,
	.fan:has(input:focus-visible) .slot {
		opacity: 1;
		--events: auto;
	}

	@media (hover: hover) and (pointer: fine) {
		.fan:hover .slot {
			opacity: 1;
			--events: auto;
		}
	}

	/* The strip just picked rises over the others while it is shown off. */
	.slot[data-launch] {
		z-index: 9;
	}

	/* The book shuts on its rivet to take the picked strip to the front, then fans out again. */
	.fan[data-phase='closed'] .slot {
		--angle: -3deg;
		--delay: 0ms;
	}

	.rivet {
		position: absolute;
		left: calc(var(--slot-left) + var(--strip-w) / 2 - var(--rivet) / 2);
		bottom: calc(var(--slot-bottom) + var(--strip-h) - var(--pivot-y) - var(--rivet) / 2);
		z-index: 10;
		--rivet: 10px;
		width: var(--rivet);
		height: var(--rivet);
		box-sizing: border-box;
		border: 1px solid #141412;
		border-radius: 50%;
		background: #d5d4cd;
	}

	.rivet::after {
		content: '';
		position: absolute;
		inset: 0;
		margin: auto;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #141412;
	}

	@media (min-width: 861px) {
		.rivet {
			--rivet: 12px;
		}
	}

	/* Each strip in its own paper and its own signal: the papers' exact colours, whatever the page's theme (`global.css`). */
	.lam[data-paper='light'] {
		--head: #efeee9;
		--body: #efeee9;
		--border: #a3a29b;
		--sep: #d5d4cd;
		--code: #5e5d58;
		--name: #141412;
		--hole: #5e5d58;
		--c1: #141412;
		--c2: #5e5d58;
		--color-accent: #ff5b14;
	}

	.lam[data-paper='dark'] {
		--head: #141412;
		--body: #141412;
		--border: #5e5d58;
		--sep: #2c2b28;
		--code: #b3b1a9;
		--name: #efeee9;
		--hole: #b3b1a9;
		--c1: #efeee9;
		--c2: #b3b1a9;
		--color-accent: #ff5b14;
	}

	.lam[data-paper='solarized-light'] {
		--head: #fdf6e3;
		--body: #fdf6e3;
		--border: #93a1a1;
		--sep: #eee8d5;
		--code: #586e75;
		--name: #073642;
		--hole: #586e75;
		--c1: #073642;
		--c2: #586e75;
		--color-accent: #cb4b16;
	}

	.lam[data-paper='nord'] {
		--head: #2e3440;
		--body: #2e3440;
		--border: #4c566a;
		--sep: #3b4252;
		--code: #d8dee9;
		--name: #eceff4;
		--hole: #d8dee9;
		--c1: #eceff4;
		--c2: #d8dee9;
		--color-accent: #d08770;
	}

	.lam[data-paper='gruvbox-light'] {
		--head: #fbf1c7;
		--body: #fbf1c7;
		--border: #928374;
		--sep: #ebdbb2;
		--code: #665c54;
		--name: #3c3836;
		--hole: #665c54;
		--c1: #3c3836;
		--c2: #665c54;
		--color-accent: #af3a03;
	}

	.lam[data-paper='catppuccin-mocha'] {
		--head: #1e1e2e;
		--body: #1e1e2e;
		--border: #6c7086;
		--sep: #313244;
		--code: #a6adc8;
		--name: #cdd6f4;
		--hole: #a6adc8;
		--c1: #cdd6f4;
		--c2: #a6adc8;
		--color-accent: #fab387;
	}

	.lam[data-paper='tokyo-night'] {
		--head: #1a1b26;
		--body: #1a1b26;
		--border: #565f89;
		--sep: #292e42;
		--code: #a9b1d6;
		--name: #c0caf5;
		--hole: #a9b1d6;
		--c1: #c0caf5;
		--c2: #a9b1d6;
		--color-accent: #ff9e64;
	}

	/* Auto: a day's head over a night's body, the sun on the horizon between them. */
	.lam[data-paper='auto'] {
		--head: #efeee9;
		--body: #141412;
		--border: #5e5d58;
		--sep: transparent;
		--code: #5e5d58;
		--name: #efeee9;
		--hole: #b3b1a9;
		--c1: #141412;
		--c2: #5e5d58;
		--color-accent: #ff5b14;
	}

	.lam {
		position: relative;
		display: block;
		width: var(--strip-w);
		height: var(--strip-h);
		translate: 0 var(--out);
		box-sizing: border-box;
		border: 1px solid var(--border);
		background: var(--body);
		font-family: var(--font-mono);
		cursor: pointer;
		pointer-events: var(--events);
		transform-origin: calc(var(--strip-w) / 2) var(--pivot-y);
		outline: 2px solid transparent;
		outline-offset: 3px;
		/* A control: no double-tap zoom to wait for, no selection on a long press. */
		touch-action: manipulation;
		-webkit-user-select: none;
		user-select: none;
	}

	/* The native radio spans the whole strip, invisible: it keeps the keyboard, the tap and the state. */
	input {
		position: absolute;
		inset: 0;
		margin: 0;
		appearance: none;
		cursor: inherit;
	}

	.lam:has(input:checked) {
		transform: translateY(var(--lift));
	}

	.lam:has(input:focus-visible) {
		outline-color: var(--color-ink);
		transform: translateY(var(--hover-lift)) rotate(-1.5deg);
	}

	.lam:has(input:checked:focus-visible) {
		transform: translateY(calc(var(--lift) + var(--hover-lift) / 2)) rotate(-1.5deg);
	}

	@media (hover: hover) and (pointer: fine) {
		.lam:hover {
			transform: translateY(var(--hover-lift)) rotate(-1.5deg);
		}

		.lam:has(input:checked):hover {
			transform: translateY(calc(var(--lift) + var(--hover-lift) / 2)) rotate(-1.5deg);
		}
	}

	.lam:active {
		transform: translateY(-5px) scale(0.97);
	}

	.lam:has(input:checked):active {
		transform: translateY(calc(var(--lift) * 0.75)) scale(0.97);
	}

	.slot[data-launch] .lam {
		transform: translateY(var(--launch)) rotate(-4deg);
	}

	.head {
		position: absolute;
		inset: 0 0 auto;
		height: 21px;
		display: flex;
		gap: 2px;
		padding: 4px;
		box-sizing: border-box;
		border-bottom: 1px solid var(--sep);
		background: var(--head);
	}

	.chip {
		width: 5px;
		height: 5px;
		background: var(--c1);
	}

	.chip + .chip {
		background: var(--c2);
	}

	.chip + .chip + .chip {
		background: var(--color-accent);
	}

	.code {
		position: absolute;
		left: 4px;
		top: 12px;
		color: var(--code);
		font-size: 8.5px;
		line-height: 1;
		white-space: nowrap;
	}

	/* Read bottom to top, along the spine. */
	.name,
	.sub {
		position: absolute;
		top: 26px;
		height: 80px;
		writing-mode: vertical-rl;
		rotate: 180deg;
		white-space: nowrap;
	}

	.name {
		left: 9px;
		color: var(--name);
		font-size: 10px;
		line-height: 13px;
	}

	/* The desktop's strips carry their paper's code too; the phone's are too narrow for it. */
	.sub {
		display: none;
	}

	.hole {
		position: absolute;
		left: calc(var(--strip-w) / 2 - 5px);
		top: calc(var(--pivot-y) - 5px);
		width: 8px;
		height: 8px;
		box-sizing: border-box;
		border: 1px solid var(--hole);
		border-radius: 50%;
		opacity: var(--holes);
	}

	.sun {
		position: absolute;
		right: 2px;
		top: 17px;
		width: 8px;
		height: 4px;
		border-radius: 4px 4px 0 0;
		background: var(--color-accent);
	}

	/* The paper in force: its corner is cut in the accent. */
	.notch {
		position: absolute;
		top: -1px;
		right: -1px;
		width: 10px;
		height: 10px;
		background: var(--color-accent);
		clip-path: polygon(0 0, 100% 0, 100% 100%);
		opacity: 0;
		scale: 0.4;
		transform-origin: 100% 0;
	}

	.lam:has(input:checked) .notch {
		opacity: 1;
		scale: 1;
	}

	@media (min-width: 861px) {
		.head {
			height: 29px;
			padding: 5px;
		}

		.chip {
			width: 6px;
			height: 6px;
		}

		.code {
			left: 5px;
			top: 15px;
			font-size: 9.5px;
		}

		.name,
		.sub {
			top: 32px;
			height: 66px;
		}

		.name {
			left: 6px;
			font-size: 12px;
			line-height: 14px;
		}

		/* Ten letters, "Catppuccin", in the 66px of the spine: the phone's size. */
		.name[data-two] {
			font-size: 10px;
			line-height: 13px;
		}

		.sub {
			display: block;
			left: 23px;
			color: var(--code);
			font-size: 9.5px;
			line-height: 12px;
		}

		.hole {
			left: calc(var(--strip-w) / 2 - 6px);
			top: calc(var(--pivot-y) - 6px);
			width: 10px;
			height: 10px;
		}

		.sun {
			right: 6px;
			top: 24px;
			width: 10px;
			height: 5px;
			border-radius: 5px 5px 0 0;
		}

		.notch {
			width: 13px;
			height: 13px;
		}
	}

	/* Auto's own line: the next turn of the sun at Besançon, written by the sky's script (`src/sky/sky.ts`). */
	:global(:root[data-sun='up']) .lam[data-paper='auto'] .sub::before {
		content: '→ ' var(--sky-set);
	}

	:global(:root[data-sun='down']) .lam[data-paper='auto'] .sub::before {
		content: '→ ' var(--sky-rise);
	}

	/* A box as large as the reveal, scaled from nothing at its centre with it (`src/sky/nuancier.ts`). */
	.ring {
		position: fixed;
		left: calc(var(--x, 0px) - var(--r, 0px));
		top: calc(var(--y, 0px) - var(--r, 0px));
		z-index: 1;
		width: calc(2 * var(--r, 0px));
		height: calc(2 * var(--r, 0px));
		box-sizing: border-box;
		border: 2px solid var(--color-accent);
		border-radius: 50%;
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.fan {
			transition: translate 460ms cubic-bezier(0.7, 0, 0.2, 1);
		}

		.slot {
			transition:
				rotate 460ms cubic-bezier(0.7, 0, 0.2, 1) var(--delay),
				scale 460ms cubic-bezier(0.7, 0, 0.2, 1) var(--delay),
				opacity 0s linear var(--hide-after, calc(460ms + var(--delay)));
		}

		.lam {
			transition:
				transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
				translate 460ms cubic-bezier(0.7, 0, 0.2, 1) var(--delay);
		}

		.slot[data-launch] .lam {
			transition-duration: 440ms;
			transition-timing-function: cubic-bezier(0.7, 0, 0.2, 1);
		}

		.notch {
			transition:
				opacity 200ms linear,
				scale 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
