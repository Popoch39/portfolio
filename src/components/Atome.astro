		.atome-label::before,
		.atome-label::after {
			content: none;
		}

		/* While the scene runs, the labels share one row, as tall as the longest: only the lit bague's shows. */
		.atome[data-atome-scene] .atome-labels {
			display: grid;
		}

		.atome[data-atome-scene] .atome-label {
			grid-area: 1 / 1;
