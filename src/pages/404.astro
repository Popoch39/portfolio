---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page introuvable — Louis Pocheron"
	description="Cette page n’existe pas ou a été déplacée. Retour au portfolio de Louis Pocheron, développeur fullstack et SIG."
	noindex
>
	<main class="wrap not-found">
		<p class="mono status">E486: Pattern not found</p>
		<h1>404<span class="cursor" aria-hidden="true"></span></h1>
		<p class="lede">Cette page n’existe pas, ou plus.</p>
		<a class="home" href="/">Retour à l’accueil</a>
	</main>
</Layout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
		padding-top: clamp(48px, 8vw, 120px);
		padding-bottom: clamp(56px, 8vw, 120px);
	}

	.status {
		margin: 0;
		font-size: 13px;
		color: var(--color-ink-muted);
	}

	h1 {
		margin: 0;
		font-size: clamp(120px, 30vw, 360px);
		line-height: 0.8;
		font-weight: 800;
		font-stretch: 62%;
		letter-spacing: -0.015em;
	}

	.cursor {
		display: inline-block;
		width: 0.3em;
		height: 0.7em;
		margin-left: 0.05em;
		background: var(--color-accent);
	}

	.lede {
		margin: 0;
		font-size: clamp(22px, 2.35vw, 34px);
		line-height: 1.2;
		letter-spacing: -0.012em;
	}

	.home {
		display: inline-flex;
		align-items: center;
		min-height: 48px;
		padding: 0 20px;
		background: var(--color-ink);
		color: var(--color-paper);
		font-weight: 600;
		text-decoration: none;
	}

	.home:hover {
		background: var(--color-accent);
		color: var(--color-on-accent);
	}
</style>
